{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Frontend workspaces are outside the backend Goal.
  "ignoreWorkspaces": ["apps/web", "packages/ui"],
  "workspaces": {
    ".": {
      // Root scripts start through `bun <path>`; tests and the Eden client
      // compile or run as their own entry points.
      "entry": [
        "scripts/**/*.ts",
        "tests/**/*.test.ts",
        "tests/qa/client/main-contract.ts",
        // Native oracle runners are started by path from their tests.
        "tests/qa/fixtures/*/run.ts",
        "tests/qa/**/*-child.ts",
        "model/tests/**/*.test.ts",
        "model/compiler/**/*.test.ts",
        // The model compiler discovers authored profiles by directory scan.
        "model/definitions/*.ts"
      ],
      "project": ["scripts/**/*.ts", "tests/**/*.ts", "model/**/*.ts"],
      "ignore": ["scripts/research/**", "tests/fixtures/**"],
      // Static tools run from node_modules/.bin in the check runner.
      "ignoreDependencies": ["dependency-cruiser", "oxfmt", "oxlint", "oxlint-tsgolint"]
    },
    // Top-level service files are process entry points and operator commands.
    "services/main": {
      // Phase-A typed schema declarations are entries until their phase-B template consumes them.
      "entry": [
        "src/*.ts",
        "src/modules/*/*-schema.ts",
        "src/modules/*/schema.ts",
        "src/modules/vote/admitted.ts",
        "src/modules/*/receipt-family.ts",
        "src/modules/*/outbox-event.ts",
        "src/modules/*/projection-recipe.ts",
        "src/modules/*/structure-profile.ts",
        // Editorial adapters, native merge handlers and their conformance fixtures
        // are imported by filesystem discovery rather than static import edges.
        "src/modules/editorial-review/*-adapter.ts",
        "src/modules/*/merge-handler.ts",
        "tests/g-865-*-fixture.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      // Consumed by the root OpenAPI generator, Eden type gate and remote MCP QA client.
      "ignoreDependencies": [
        "@elysia/eden",
        "@elysia/openapi",
        "@scalar/types",
        "@modelcontextprotocol/client"
      ]
    },
    "services/account": {
      "entry": ["src/*.ts", "src/oauth-scopes/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "services/content": { "entry": ["src/*.ts"], "project": ["src/**/*.ts", "tests/**/*.ts"] },
    // vinext loads App Router files and the Worker entry by convention.
    "apps/accounts": {
      "entry": [
        "app/**/{page,layout,loading,error,not-found}.tsx",
        "tests/**/*.{test,e2e}.ts",
        "features/**/*.{test,e2e}.ts"
      ],
      "project": ["**/*.{ts,tsx}"],
      // Imported from app/styles.css, which Knip does not follow.
      "ignoreDependencies": ["@fontsource-variable/manrope", "tailwindcss"]
    },
    // Astro finds pages, layouts and the Worker by convention; the config, dev plugin and
    // Playwright files are loaded by their tools. Stylesheets are not followed.
    "apps/about": {
      // tests/fixtures are imported from generated test source, which Knip cannot follow.
      "entry": [
        "src/pages/**/*.{astro,ts}",
        "astro-check.cjs",
        "tests/**/*.{test,e2e}.ts",
        "tests/fixtures/**/*.astro"
      ],
      "project": ["**/*.{ts,tsx,astro,cjs}"],
      // global.css imports the faces and Tailwind; og.ts and the axe helper resolve their
      // packages by path; astro-check.cjs needs the WASM runtime @astrojs/astro2tsx forgot to declare.
      "ignoreDependencies": [
        "@emnapi/runtime",
        "@fontsource-variable/geist-mono",
        "@fontsource-variable/manrope",
        "@fontsource-variable/source-serif-4",
        "@fontsource/manrope",
        "axe-core",
        "tailwindcss"
      ]
    },
    "packages/wiki-toolkit": {
      "entry": [
        "src/cli.ts",
        "src/index.ts",
        "protocol/index.ts",
        "tests/**/*.test.ts",
        "tests/txt-memory-probe.ts"
      ],
      "project": ["src/**/*.ts", "protocol/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["typescript"]
    },
    "packages/model": { "project": ["src/**/*.ts", "tests/**/*.ts"] },
    "packages/document": {
      "entry": ["src/index.ts", "scripts/schema.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "packages/observability": {
      "entry": [
        "src/*.ts",
        "tests/**/*.test.ts",
        "tests/runtime-child.ts",
        "tests/worker-sampling-child.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    // Aspire runs the AppHost with `npx tsx`; the CLI launcher and the generated
    // SDK in the ignored `.aspire/` directory use these dependencies.
    "apphost": {
      "entry": ["apphost.mts"],
      "ignoreDependencies": ["@microsoft/aspire-cli", "tsx", "vscode-jsonrpc"]
    }
  },
  "rules": {
    // Root scripts and tests use hoisted workspace dependencies; host PostgreSQL
    // binaries are system tools; spawned script paths are not imports.
    "unlisted": "off",
    "binaries": "off",
    "unresolved": "off"
  }
}
