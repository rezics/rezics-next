{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Frontend workspaces are outside the backend Goal.
  "ignoreWorkspaces": ["apps/web", "packages/ui"],
  "workspaces": {
    ".": {
      // Root scripts start through `bun <path>`; tests and the Eden client
      // compile or run as their own entry points.
      "entry": [
        "scripts/**/*.ts",
        "tests/**/*.test.ts",
        "tests/qa/client/main-contract.ts",
        // Native oracle runners are started by path from their tests.
        "tests/qa/fixtures/*/run.ts",
        "tests/qa/**/*-child.ts",
        "model/tests/**/*.test.ts",
        "model/compiler/**/*.test.ts",
        // The model compiler discovers authored profiles by directory scan.
        "model/definitions/*.ts"
      ],
      "project": ["scripts/**/*.ts", "tests/**/*.ts", "model/**/*.ts"],
      "ignore": ["scripts/research/**", "tests/fixtures/**"],
      // Static tools run from node_modules/.bin in the check runner.
      "ignoreDependencies": ["dependency-cruiser", "oxfmt", "oxlint", "oxlint-tsgolint"]
    },
    // Top-level service files are process entry points and operator commands.
    "services/main": {
      // Phase-A typed schema declarations are entries until their phase-B template consumes them.
      "entry": [
        "src/*.ts",
        "src/modules/*/*-schema.ts",
        "src/modules/*/schema.ts",
        "src/modules/vote/admitted.ts",
        "src/modules/*/receipt-family.ts",
        "src/modules/*/outbox-event.ts",
        "src/modules/*/projection-recipe.ts",
        "src/modules/*/structure-profile.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      // Consumed by the root OpenAPI generator and Eden type gate.
      "ignoreDependencies": ["@elysia/eden", "@elysia/openapi", "@scalar/types"]
    },
    "services/account": {
      "entry": ["src/*.ts", "src/oauth-scopes/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "services/content": { "entry": ["src/*.ts"], "project": ["src/**/*.ts", "tests/**/*.ts"] },
    // vinext loads App Router files and the Worker entry by convention.
    "apps/accounts": {
      "entry": [
        "app/**/{page,layout,loading,error,not-found}.tsx",
        "tests/**/*.{test,e2e}.ts",
        "features/**/*.{test,e2e}.ts"
      ],
      "project": ["**/*.{ts,tsx}"],
      // Imported from app/styles.css, which Knip does not follow.
      "ignoreDependencies": ["@fontsource-variable/manrope", "tailwindcss"]
    },
    "packages/model": { "project": ["src/**/*.ts", "tests/**/*.ts"] },
    // Aspire runs the AppHost with `npx tsx`; the CLI launcher and the generated
    // SDK in the ignored `.aspire/` directory use these dependencies.
    "apphost": {
      "entry": ["apphost.mts"],
      "ignoreDependencies": ["@microsoft/aspire-cli", "tsx", "vscode-jsonrpc"]
    }
  },
  "rules": {
    // Root scripts and tests use hoisted workspace dependencies; host PostgreSQL
    // binaries are system tools; spawned script paths are not imports.
    "unlisted": "off",
    "binaries": "off",
    "unresolved": "off"
  }
}
