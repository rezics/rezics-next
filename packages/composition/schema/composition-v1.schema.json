            },
            "threadKind": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "discussion"
                },
                {
                  "type": "string",
                  "const": "review"
                }
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
