    "LinkGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "props"],
      "properties": {
        "type": {
          "type": "string",
          "const": "LinkGrid"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "links"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
            },
            "links": {
              "type": "array",
