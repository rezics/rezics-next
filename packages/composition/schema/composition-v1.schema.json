              "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
            }
          }
        }
      }
    },
    "Statements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "props"],
      "properties": {
        "type": {
          "type": "string",
          "const": "Statements"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "properties"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
            },
            "properties": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9]*:[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
              },
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "MoreStatements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "props"],
      "properties": {
        "type": {
          "type": "string",
