{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rezics.com/definitions/release/1",
  "type": "object",
  "required": ["format", "catalogue", "generator", "prefixes", "types", "properties"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "https://rezics.com/definitions/release/1"
    },
    "catalogue": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/iri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prefixes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "(?:^[a-z][a-z0-9_]*$)(?![\\s\\S])": {
          "$ref": "#/$defs/iri"
        }
      }
    },
    "types": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "(?:^.*$)(?![\\s\\S])": {
          "$ref": "#/$defs/type"
        }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "(?:^.*$)(?![\\s\\S])": {
          "$ref": "#/$defs/property"
        }
      }
    },
    "contexts": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 256,
      "patternProperties": {
        "(?:^[a-z][a-z0-9-]{0,63}$)(?![\\s\\S])": {
          "$ref": "#/$defs/contextSettings"
        }
      }
    },
    "libraryProfiles": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]{0,63}$(?![\\s\\S])": {
          "$ref": "#/$defs/libraryProfile"
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 1024,
      "patternProperties": {
        "(?:^[a-z][a-z0-9-]{0,63}/[a-z][a-z0-9-]{0,63}$)(?![\\s\\S])": {
          "$ref": "#/$defs/savedFilter"
        }
      }
    }
  },
  "$defs": {
    "libraryId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$(?![\\s\\S])"
    },
    "libraryLabels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ja": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ko": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "zh-Hans": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "zh-Hant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": ["en"]
    },
    "libraryDecimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$(?![\\s\\S])"
    },
    "libraryState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/libraryId"
        },
        "labels": {
          "$ref": "#/$defs/libraryLabels"
        },
        "role": {
          "enum": ["planned", "active", "completed", "paused", "dropped"]
        }
      },
      "required": ["id", "labels"]
    },
    "libraryUnit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/libraryId"
        },
        "labels": {
          "$ref": "#/$defs/libraryLabels"
        },
        "dimension": {
          "$ref": "#/$defs/libraryId"
        },
        "minimum": {
          "$ref": "#/$defs/libraryDecimal"
        },
        "maximum": {
          "$ref": "#/$defs/libraryDecimal"
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "totalPolicy": {
          "enum": ["optional", "required", "forbidden"]
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["none", "session_local"]
            }
          },
          "required": ["kind"]
        },
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": ["kind"]
        }
      },
      "required": ["id", "labels", "identity", "structure"]
    },
    "libraryStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/libraryId"
        },
        "labels": {
          "$ref": "#/$defs/libraryLabels"
        }
      },
      "required": ["id", "labels"]
    },
    "libraryCopyKind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/libraryId"
        },
        "labels": {
          "$ref": "#/$defs/libraryLabels"
        },
        "statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/libraryStatus"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": ["id", "labels", "statuses"]
    },
    "libraryProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/libraryId"
        },
        "entryStateSet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/libraryId"
            },
            "states": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/libraryState"
              },
              "minItems": 1,
              "maxItems": 64
            }
          },
          "required": ["id", "states"]
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "enum": ["scalar_amount", "cursor_position", "completed_units"]
                  },
                  "units": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/libraryUnit"
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": ["mode", "units"],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "mode": {
                          "const": "scalar_amount"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "units": {
                          "items": {
                            "properties": {
                              "identity": {
                                "properties": {
                                  "kind": {
                                    "const": "none"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "mode": {
                          "const": "cursor_position"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "units": {
                          "items": {
                            "properties": {
                              "identity": {
                                "properties": {
                                  "kind": {
                                    "const": "none"
                                  }
                                }
                              },
                              "totalPolicy": {
                                "const": "forbidden"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "mode": {
                          "const": "completed_units"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "units": {
                          "items": {
                            "properties": {
                              "identity": {
                                "properties": {
                                  "kind": {
                                    "const": "session_local"
                                  }
                                }
                              },
                              "totalPolicy": {
                                "const": "forbidden"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "minItems": 0,
              "maxItems": 3
            }
          },
          "required": ["allowed"]
        },
        "copies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kinds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/libraryCopyKind"
              },
              "minItems": 0,
              "maxItems": 16
            }
          },
          "required": ["kinds"]
        },
        "importSources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/libraryId"
              },
              "mappingVersion": {
                "$ref": "#/$defs/libraryId"
              },
              "recordKinds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/libraryId"
                },
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true
              }
            },
            "required": ["id", "mappingVersion", "recordKinds"]
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": ["id"]
    },
    "iri": {
      "type": "string",
      "pattern": "(?:^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\u0000-\\u0020\\u007f-\\u009f<>\"{}|\\\\^`]*$)(?![\\s\\S])",
      "format": "iri"
    },
    "curie": {
      "type": "string",
      "pattern": "(?:^[a-z][a-z0-9_]*:[^\\s]+$)(?![\\s\\S])"
    },
    "contextSettings": {
      "type": "object",
      "required": ["labels", "defaults"],
      "additionalProperties": false,
      "properties": {
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 64,
          "patternProperties": {
            "(?:^.*$)(?![\\s\\S])": {
              "enum": ["inherit", "suppress"]
            }
          }
        }
      }
    },
    "savedFilter": {
      "type": "object",
      "required": ["labels", "filter"],
      "additionalProperties": false,
      "properties": {
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "filter": {
          "type": "object"
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "(?:^(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?$|^[xX](?:-[A-Za-z0-9]{1,8})+$|^(?:en-GB-oed|i-(?:ami|bnn|default|enochian|hak|klingon|lux|mingo|navajo|pwn|tao|tay|tsu)|sgn-(?:BE-FR|BE-NL|CH-DE)|art-lojban|cel-gaulish|no-bok|no-nyn|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang)$)(?![\\s\\S])": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["en"]
    },
    "curies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/curie"
      }
    },
    "type": {
      "type": "object",
      "required": ["iri", "labels", "mappings", "bases", "properties", "facets"],
      "additionalProperties": false,
      "properties": {
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "mappings": {
          "$ref": "#/$defs/curies"
        },
        "bases": {
          "$ref": "#/$defs/curies"
        },
        "properties": {
          "$ref": "#/$defs/curies"
        },
        "facets": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/curie"
          }
        },
        "coverRatio": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-5][0-9]|6[0-4]):(?:[1-9]|[1-5][0-9]|6[0-4])$(?![\\s\\S])"
        },
        "library": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profileId": {
              "$ref": "#/$defs/libraryId"
            }
          },
          "required": ["profileId"]
        },
        "schemaOrgType": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^https://schema\\.org/[A-Za-z0-9_-]+$(?![\\s\\S])"
        },
        "descriptions": {
          "$ref": "#/$defs/descriptions"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": ["group"],
      "additionalProperties": false,
      "properties": {
        "group": {
          "enum": [
            "order",
            "derivation",
            "world",
            "membership",
            "association",
            "credit",
            "appearance",
            "classification"
          ]
        },
        "inverse": {
          "anyOf": [{ "const": "none" }, { "$ref": "#/$defs/curie" }]
        },
        "inverseLabels": {
          "$ref": "#/$defs/labels"
        },
        "symmetric": {
          "const": true
        },
        "acyclic": {
          "const": true
        },
        "order": {
          "enum": ["position", "date", "name"]
        },
        "slotKey": {
          "$ref": "#/$defs/curie"
        },
        "filter": {
          "anyOf": [
            { "$ref": "#/$defs/curie" },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/curie" }
            }
          ]
        }
      }
    },
    "property": {
      "type": "object",
      "required": ["iri", "labels", "mappings", "datatype", "multivalued", "qualifiers", "value"],
      "additionalProperties": false,
      "properties": {
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "relation": {
          "$ref": "#/$defs/relation"
        },
        "disclosure": {
          "const": "sourceOrConsent"
        },
        "descriptions": {
          "$ref": "#/$defs/descriptions"
        },
        "mappings": {
          "$ref": "#/$defs/curies"
        },
        "datatype": {
          "enum": [
            "wikibase-item",
            "string",
            "external-id",
            "url",
            "monolingualtext",
            "quantity",
            "time",
            "document",
            "media"
          ]
        },
        "multivalued": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/curie"
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "const": "1"
              },
              {
                "const": "*"
              },
              {
                "$ref": "#/$defs/iri"
              }
            ]
          }
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "qualifiers": {
          "$ref": "#/$defs/curies"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "value": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["string", "object"]
        },
        "pattern": {
          "type": "string"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "(?:^.*$)(?![\\s\\S])": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "enum": {
          "type": "array",
          "items": {
            "type": ["string", "number"]
          }
        },
        "const": {
          "type": "string"
        }
      }
    },
    "descriptions": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "(?:^(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?$|^[xX](?:-[A-Za-z0-9]{1,8})+$|^(?:en-GB-oed|i-(?:ami|bnn|default|enochian|hak|klingon|lux|mingo|navajo|pwn|tao|tay|tsu)|sgn-(?:BE-FR|BE-NL|CH-DE)|art-lojban|cel-gaulish|no-bok|no-nyn|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang)$)(?![\\s\\S])": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        }
      }
    }
  }
}
