{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rezics.com/definitions/kind/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "labels", "auto", "condition", "presentation"],
  "properties": {
    "format": {
      "const": "https://rezics.com/definitions/kind/1"
    },
    "id": {
      "type": "string",
      "pattern": "(?:^[a-z][a-z0-9_]*:[^\\s]+$)(?![\\s\\S])"
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "(?:^(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?$|^[xX](?:-[A-Za-z0-9]{1,8})+$|^(?:en-GB-oed|i-(?:ami|bnn|default|enochian|hak|klingon|lux|mingo|navajo|pwn|tao|tay|tsu)|sgn-(?:BE-FR|BE-NL|CH-DE)|art-lojban|cel-gaulish|no-bok|no-nyn|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang)$)(?![\\s\\S])": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["en"]
    },
    "descriptions": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "(?:^(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[xX](?:-[A-Za-z0-9]{1,8})+)?$|^[xX](?:-[A-Za-z0-9]{1,8})+$|^(?:en-GB-oed|i-(?:ami|bnn|default|enochian|hak|klingon|lux|mingo|navajo|pwn|tao|tay|tsu)|sgn-(?:BE-FR|BE-NL|CH-DE)|art-lojban|cel-gaulish|no-bok|no-nyn|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang)$)(?![\\s\\S])": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        }
      }
    },
    "auto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "precedence"],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "precedence": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "type"],
          "properties": {
            "op": {
              "const": "exact-type"
            },
            "type": {
              "type": "object",
              "additionalProperties": false,
              "required": ["releaseDigest", "typeId"],
              "properties": {
                "releaseDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
                },
                "typeId": {
                  "type": "string",
                  "pattern": "(?:^[a-z][a-z0-9_]*:[^\\s]+$)(?![\\s\\S])"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "language", "document", "vocabulary"],
          "properties": {
            "op": {
              "const": "filter"
            },
            "language": {
              "const": "https://rezics.com/filter/1"
            },
            "document": {
              "$ref": "#/$defs/filterDocument"
            },
            "vocabulary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["types", "properties"],
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["releaseDigest", "typeId"],
                    "properties": {
                      "releaseDigest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
                      },
                      "typeId": {
                        "type": "string",
                        "pattern": "(?:^[a-z][a-z0-9_]*:[^\\s]+$)(?![\\s\\S])"
                      }
                    }
                  },
                  "maxItems": 256
                },
                "properties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["releaseDigest", "propertyId"],
                    "properties": {
                      "releaseDigest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
                      },
                      "propertyId": {
                        "type": "string",
                        "pattern": "(?:^[a-z][a-z0-9_]*:[^\\s]+$)(?![\\s\\S])"
                      }
                    }
                  },
                  "maxItems": 256
                }
              }
            }
          }
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseDigest", "typeId"],
          "properties": {
            "releaseDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
            },
            "typeId": {
              "type": "string",
              "pattern": "(?:^[a-z][a-z0-9_]*:[^\\s]+$)(?![\\s\\S])"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "filterDocument": {
      "$comment": "Public immutable expanded FilterDocument structure. The original @rezics/filter parser also enforces aggregate leaves/depth, UTF-8 and range semantics. This branch does not authorize catalogue construction.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "and": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/filterDocument"
              }
            }
          },
          "required": ["and"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "or": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/filterDocument"
              },
              "maxItems": 16
            }
          },
          "required": ["or"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/filterDocument"
            }
          },
          "required": ["not"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "in": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*:[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])",
                    "maxLength": 128
                  },
                  "maxItems": 64
                }
              },
              "required": ["in"]
            }
          },
          "required": ["type"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "statement": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "property": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*:[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])",
                      "maxLength": 128
                    },
                    "in": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "maxItems": 64
                    },
                    "qualifiers": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "property": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9]*:[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])",
                            "maxLength": 128
                          },
                          "in": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "maxItems": 64
                          }
                        },
                        "required": ["property", "in"]
                      },
                      "maxItems": 4
                    }
                  },
                  "required": ["property", "in"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "property": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*:[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])",
                      "maxLength": 128
                    },
                    "range": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "gte": {
                          "type": "number"
                        },
                        "lte": {
                          "type": "number"
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "required": [],
                      "anyOf": [
                        {
                          "required": ["gte"]
                        },
                        {
                          "required": ["lte"]
                        }
                      ]
                    },
                    "qualifiers": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "property": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9]*:[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])",
                            "maxLength": 128
                          },
                          "in": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "maxItems": 64
                          }
                        },
                        "required": ["property", "in"]
                      },
                      "maxItems": 4
                    }
                  },
                  "required": ["property", "range"]
                }
              ]
            }
          },
          "required": ["statement"]
        }
      ]
    }
  }
}
