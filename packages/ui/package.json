{
  "name": "@rezics/ui",
  "private": true,
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./utils": "./src/utils.ts",
    "./shadcn/*": "./src/shadcn/*.tsx",
    "./hooks/use-mobile": "./src/hooks/use-mobile.ts",
    "./hooks/use-highlighted-code": "./src/hooks/use-highlighted-code.ts",
    "./hooks/*": "./src/hooks/*.tsx",
    "./lib/*": "./src/lib/*.tsx",
    "./*": "./src/components/*.tsx",
    ".": "./src/index.ts"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "check": "oxfmt --check . && bun check --no-script -p tsconfig.json && bun run test #bun test",
    "test": "bun scripts/isolated.ts bun test",
    "test:stories:slow-frames": "bun scripts/isolated.ts bun x vitest run --config vitest.slow-frames.config.ts",
    "shadcn:sync": "bun scripts/shadcn-sync.ts",
    "shadcn:sync-check": "bun scripts/shadcn-sync-check.ts",
    "typecheck": "bun check --no-script -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@rezics/document": "workspace:*",
    "@shadcn/react": "0.3.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-unique-id": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/static-renderer": "3.32.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.61.0",
    "react-day-picker": "10.0.2",
    "react-resizable-panels": "4.15.0",
    "recharts": "3.8.0",
    "shiki": "4.5.0",
    "tailwind-variants": "3.3.1",
    "thumbhash": "0.1.1",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "11.0.0-alpha.8",
    "@storybook/addon-vitest": "11.0.0-alpha.8",
    "@storybook/react-vite": "11.0.0-alpha.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0-beta.1",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "storybook": "11.0.0-alpha.8",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.1.0-beta.1"
  }
}
