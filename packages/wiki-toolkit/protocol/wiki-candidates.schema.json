{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rezics.com/protocol/wiki-candidates-v1.schema.json",
  "type": "object",
  "required": [
    "target",
    "zone",
    "names"
  ],
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|\\\\^`]+$",
      "x-wiki-iri": true
    },
    "zone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|\\\\^`]+$",
      "x-wiki-iri": true
    },
    "names": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "language"
        ],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|\\\\^`]+$",
            "x-wiki-iri": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "additionalProperties": false
}
