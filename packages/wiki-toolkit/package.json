{
  "name": "@rezics/wiki-toolkit",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "src",
    "protocol",
    "skill",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    "./protocol/locator": "./protocol/locator.ts",
    "./protocol/wiki-extraction": "./protocol/wiki-extraction.ts",
    "./protocol/*.json": "./protocol/*.json",
    ".": "./src/index.ts",
    "./protocol": "./protocol/index.ts"
  },
  "SPDX-License-Identifier": "Apache-2.0",
  "description": "Offline text units and verifiable locators for TXT, EPUB and literal Ren’Py scripts",
  "bin": {
    "rezics-wiki": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "iconv-lite": "0.7.3",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "typescript-6": "npm:typescript@6.0.2"
  }
}
