{
  "name": "@rezics/document",
  "version": "0.1.0",
  "description": "Independent REZICS Text and Blocks document profiles over the ProseMirror JSON model",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "check": "oxfmt --check . && bun check --no-script -p tsconfig.json && bun test && bun scripts/schema.ts --check",
    "typecheck": "bun check --no-script -p tsconfig.json"
  },
  "files": [
    "src",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./schema/*.json": "./schema/*.json"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "markdown-it": "15.0.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-tables": "1.8.5",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5"
  }
}
