{
  "name": "rezics",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "services/main",
    "services/account"
  ],
  "scripts": {
    "account:dev": "bun --watch services/account/src/index.ts",
    "account:typecheck": "corepack yarn workspace @rezics/account typecheck",
    "account:test": "bun test services/account/tests",
    "main:dev": "bun --watch services/main/src/index.ts",
    "main:relay": "corepack yarn workspace @rezics/main relay",
    "main:relay:init": "corepack yarn workspace @rezics/main relay:init",
    "main:typecheck": "corepack yarn workspace @rezics/main typecheck",
    "main:test": "bun test services/main/tests"
  }
}
