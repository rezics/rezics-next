{
  "name": "rezics",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun scripts/gate.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun scripts/typecheck.ts",
    "lint": "bun lint --no-script --config .oxlintrc.json ."
  },
  "patchedDependencies": {
    "@dbos-inc/dbos-sdk@5.5.3-preview": "patches/@dbos-inc%2Fdbos-sdk@5.5.3-preview.patch",
    "@better-auth/oauth-provider@1.8.0-beta.3": "patches/@better-auth%2Foauth-provider@1.8.0-beta.3.patch",
    "@storybook/react@11.0.0-alpha.8": "patches/@storybook%2Freact@11.0.0-alpha.8.patch"
  },
  "devDependencies": {
    "@rezics/auth": "workspace:*",
    "@rezics/client": "workspace:*",
    "@rezics/definitions": "workspace:*",
    "@rezics/document": "workspace:*",
    "@rezics/operations": "workspace:*",
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.1.0-beta",
    "bun": "1.4.4-canary.20261031.1"
  },
  "packageManager": "bun@1.4.4-canary.20261031.1"
}
