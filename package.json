{
  "name": "rezics",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun scripts/gate.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun scripts/typecheck.ts",
    "lint": "bun lint --no-script --config .oxlintrc.json ."
  },
  "patchedDependencies": {
    "@better-auth/oauth-provider@1.8.0-beta.2": "patches/@better-auth%2Foauth-provider@1.8.0-beta.2.patch"
  },
  "devDependencies": {
    "@rezics/auth": "workspace:*",
    "@rezics/client": "workspace:*",
    "@rezics/definitions": "workspace:*",
    "@rezics/document": "workspace:*",
    "@types/bun": "1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.1.0-beta",
    "bun": "1.4.4-canary.20261027.1"
  },
  "packageManager": "bun@1.4.4-canary.20261027.1"
}
