+// SDK-owned: old executors execute these native guards too, without new client code.
+function workflowWriterFenceMigration(schemaName) {
+    const s = '"' + schemaName.replace(/"/g, '""') + '"';
+    const tables = [
+        ['workflow_status', 'workflow_uuid'],
+        ['workflow_input', 'workflow_uuid'],
+        ['workflow_output', 'workflow_uuid'],
+        ['operation_outputs', 'workflow_uuid'],
+        ['workflow_events', 'workflow_uuid'],
+        ['workflow_events_history', 'workflow_uuid'],
+        ['notifications', 'destination_uuid'],
+        ['streams', 'workflow_uuid'],
+    ];
+    return {
+        name: '20261031003816_permanent_workflow_writer_fence',
+        pg: [
+            // No FK to execution/history. Deletion/deduplication never removes this identity.
+            `CREATE TABLE ${s}.workflow_writer_fences (
+                workflow_uuid TEXT PRIMARY KEY,
+                generation BIGINT NOT NULL DEFAULT 1,
+                closure_id UUID,
+                closed_at BIGINT,
+                CHECK ((generation = 1 AND closure_id IS NULL AND closed_at IS NULL)
+                    OR (generation = 2 AND closure_id IS NOT NULL AND closed_at IS NOT NULL))
+            )`,
+            `CREATE FUNCTION ${s}.preserve_workflow_writer_fence() RETURNS TRIGGER
+             LANGUAGE plpgsql SET search_path = pg_catalog, pg_temp AS $$
+             BEGIN
+                IF TG_OP IN ('DELETE', 'TRUNCATE') THEN
+                    RAISE EXCEPTION 'DBOS workflow writer identity is permanent';
+                END IF;
+                IF OLD.workflow_uuid IS DISTINCT FROM NEW.workflow_uuid OR
+                   (OLD.closed_at IS NOT NULL AND OLD IS DISTINCT FROM NEW) THEN
+                    RAISE EXCEPTION 'DBOS workflow writer closure is immutable';
+                END IF;
+                RETURN NEW;
+             END $$`,
+            `CREATE TRIGGER preserve_workflow_writer_fence
+             BEFORE UPDATE OR DELETE ON ${s}.workflow_writer_fences
+             FOR EACH ROW EXECUTE FUNCTION ${s}.preserve_workflow_writer_fence()`,
+            `CREATE TRIGGER preserve_workflow_writer_fence_truncate
+             BEFORE TRUNCATE ON ${s}.workflow_writer_fences
+             FOR EACH STATEMENT EXECUTE FUNCTION ${s}.preserve_workflow_writer_fence()`,
+            `ALTER TABLE ${s}.workflow_writer_fences ENABLE ALWAYS TRIGGER preserve_workflow_writer_fence`,
+            `ALTER TABLE ${s}.workflow_writer_fences ENABLE ALWAYS TRIGGER preserve_workflow_writer_fence_truncate`,
+            `CREATE FUNCTION ${s}.guard_workflow_writer(id TEXT) RETURNS VOID
+             LANGUAGE plpgsql SET search_path = pg_catalog, pg_temp AS $$
+             DECLARE live_generation BIGINT;
+             BEGIN
+                -- The conflicting tuple is checked after waiting, even with an older statement snapshot.
+                -- This row lock remains held through the writer's actual COMMIT, not just its admission.
+                INSERT INTO ${s}.workflow_writer_fences AS f (workflow_uuid) VALUES (id)
+                ON CONFLICT (workflow_uuid) DO UPDATE SET generation = f.generation
+                WHERE f.closed_at IS NULL
+                RETURNING generation INTO live_generation;
+                IF NOT FOUND THEN
+                    RAISE EXCEPTION 'DBOS workflow writer is permanently retired'
+                        USING ERRCODE = 'P0001';
+                END IF;
+             END $$`,
+            `CREATE FUNCTION ${s}.guard_workflow_writer_row() RETURNS TRIGGER
+             LANGUAGE plpgsql SET search_path = pg_catalog, pg_temp AS $$
+             DECLARE ids TEXT[]; id TEXT;
+             BEGIN
+                ids := ARRAY[to_jsonb(NEW)->>TG_ARGV[0]];
+                IF TG_OP = 'UPDATE' THEN
+                    ids := array_append(ids, to_jsonb(OLD)->>TG_ARGV[0]);
+                END IF;
+                IF TG_TABLE_NAME = 'workflow_status' THEN
+                    IF TG_OP = 'INSERT' THEN
+                        ids := ids || ARRAY[NEW.parent_workflow_id, NEW.forked_from];
+                    ELSE
+                        IF NEW.parent_workflow_id IS DISTINCT FROM OLD.parent_workflow_id THEN
+                            ids := array_append(ids, NEW.parent_workflow_id);
+                        END IF;
+                        IF NEW.forked_from IS DISTINCT FROM OLD.forked_from THEN
+                            ids := array_append(ids, NEW.forked_from);
+                        END IF;
+                    END IF;
+                END IF;
+                FOR id IN SELECT DISTINCT unnest(ids) ORDER BY 1 LOOP
+                    IF id IS NOT NULL THEN PERFORM ${s}.guard_workflow_writer(id); END IF;
+                END LOOP;
+                RETURN NEW;
+             END $$`,
+            ...tables.flatMap(([table, key]) => [
+                `CREATE TRIGGER guard_workflow_writer BEFORE INSERT OR UPDATE ON ${s}.${table}
+                 FOR EACH ROW EXECUTE FUNCTION ${s}.guard_workflow_writer_row('${key}')`,
+                // Restore/COPY replay and replication-role sessions cannot silently reopen a retired ID.
+                `ALTER TABLE ${s}.${table} ENABLE ALWAYS TRIGGER guard_workflow_writer`,
+            ]),
+            `CREATE FUNCTION ${s}.retire_workflow_writers(id TEXT)
+             RETURNS SETOF ${s}.workflow_writer_fences
+             LANGUAGE plpgsql SET search_path = pg_catalog, pg_temp AS $$
+             DECLARE fence ${s}.workflow_writer_fences%ROWTYPE;
+             BEGIN
+                -- Join the old SDK's native owner-check lock before revoking its execution token.
+                -- No terminal status, cancellation or legal erasure authority is inferred here.
+                PERFORM workflow_uuid FROM ${s}.workflow_status
+                    WHERE workflow_uuid = id FOR NO KEY UPDATE;
+                INSERT INTO ${s}.workflow_writer_fences AS f (workflow_uuid) VALUES (id)
+                ON CONFLICT (workflow_uuid) DO UPDATE SET generation = f.generation
+                RETURNING * INTO fence;
+                IF fence.closed_at IS NULL THEN
+                    -- Old sendFromStep writers check this token in their SAME notification transaction.
+                    -- Revocation makes them roll back even when sending to a different live destination.
+                    UPDATE ${s}.workflow_status SET owner_xid = NULL WHERE workflow_uuid = id;
+                    UPDATE ${s}.workflow_writer_fences
+                        SET generation = 2, closure_id = gen_random_uuid(),
+                            closed_at = (EXTRACT(EPOCH FROM clock_timestamp()) * 1000)::BIGINT
+                        WHERE workflow_uuid = id RETURNING * INTO fence;
+                END IF;
+                RETURN NEXT fence;
+             END $$`,
+        ],
+    };
+}
