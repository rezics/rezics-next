+    const s = '"' + schemaName.replace(/"/g, '""') + '"';
+    return {
+        name: '20261031005632_private_workflow_writer_refusal',
+        pg: [
+            `CREATE OR REPLACE FUNCTION ${s}.guard_workflow_writer(id TEXT) RETURNS VOID
+             LANGUAGE plpgsql SET search_path = pg_catalog, pg_temp AS $$
+             DECLARE live_generation BIGINT;
+             BEGIN
+                -- The conflicting tuple is checked after waiting, even with an older statement snapshot.
+                -- This row lock remains held through the writer's actual COMMIT, not just its admission.
+                INSERT INTO ${s}.workflow_writer_fences AS f (workflow_uuid) VALUES (id)
+                ON CONFLICT (workflow_uuid) DO UPDATE SET generation = f.generation
+                WHERE f.closed_at IS NULL
+                RETURNING generation INTO live_generation;
+                IF NOT FOUND THEN
+                    RAISE EXCEPTION 'DBOS workflow writer is permanently retired'
+                        USING ERRCODE = 'P0001';
+                END IF;
+             END $$`,
+        ],
+    };
+}
+exports.workflowWriterFencePrivacyMigration = workflowWriterFencePrivacyMigration;
