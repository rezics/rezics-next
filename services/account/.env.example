# Generated by task env:example from services/account/src/config.ts. Do not edit.
# task dev:prepare writes the local values, including generated secrets, to
# .temp/stack/<project>/dev.env (see `task env`). Put personal overrides in the
# repository-root .env.dev; see .env.dev.example.

## Account (src/index.ts, src/migrate.ts)
# Public base URL of Account; the OAuth issuer is <base>/api/auth.
ACCOUNT_BASE_URL=http://127.0.0.1:3002
# Better Auth secret.
ACCOUNT_SECRET=<generated by task dev:prepare>
# OAuth resource identifier for Main.
ACCOUNT_MAIN_RESOURCE=https://main.rezics.test
# Account owner PostgreSQL URL.
ACCOUNT_DATABASE_URL=postgres://account:password@127.0.0.1:5432/account
# Enrollment verifier: cloudflare in production; local always-pass mode permits offline dev/test API clients. (default: cloudflare)
# ACCOUNT_TURNSTILE_MODE=cloudflare
# Cloudflare Turnstile secret, required only in cloudflare mode. (default: )
# ACCOUNT_TURNSTILE_SECRET_KEY=
# Port Account listens on at 127.0.0.1. (default: 3002)
# ACCOUNT_PORT=3002
# Comma-separated socket peer IPs whose ingress replaces X-Forwarded-For with one client address. (default: )
# ACCOUNT_TRUSTED_PROXY_PEERS=
# Access owner URL; enables the account deletion fence. Requires ACCOUNT_RELAY_DATABASE_URL. (optional)
# ACCOUNT_ACCESS_DATABASE_URL=postgres://access:password@127.0.0.1:5432/access
# Relay URL for account deletion events. (optional)
# ACCOUNT_RELAY_DATABASE_URL=postgres://relay:password@127.0.0.1:5432/relay
# One-time first-owner bootstrap candidates; subsequent authority uses stored roles. (default: )
# ACCOUNT_OPERATOR_USER_IDS=
# First-party web OAuth client allowed to read and write display preferences. (default: )
# WEB_OAUTH_CLIENT_ID=
# Main confidential client secret for its Account-owned email digest intake.
ACCOUNT_MAIN_CLIENT_SECRET=<generated by task dev:prepare>
# SMTP host; local development uses Mailpit. (default: 127.0.0.1)
# ACCOUNT_SMTP_HOST=127.0.0.1
# SMTP port; Mailpit uses 1025 (web UI 8025). (default: 1025)
# ACCOUNT_SMTP_PORT=1025
# Use TLS immediately (usually port 465). (default: false)
# ACCOUNT_SMTP_SECURE=false
# Require STARTTLS; enable for remote SMTP. (default: false)
# ACCOUNT_SMTP_REQUIRE_TLS=false
# SMTP authentication username, if required. (default: )
# ACCOUNT_SMTP_USER=
# SMTP authentication password. (default: )
# ACCOUNT_SMTP_PASSWORD=
# Verified transactional sender address. (default: REZICS <accounts@localhost>)
# ACCOUNT_EMAIL_FROM=REZICS <accounts@localhost>
# HMAC key for Access title admission proofs. (optional)
# FUSEKI_TITLE_ADMISSION_KEY=<generated by task dev:prepare>
