# Generated by task env:example from services/main/src/config.ts. Do not edit.
# task dev:prepare writes the local values, including generated secrets, to
# .temp/stack/<project>/dev.env (see `task env`). Put personal overrides in the
# repository-root .env.dev; see .env.dev.example.

## Main API (src/index.ts)
# Fuseki dataset URL, ending in /rezics/.
FUSEKI_URL=http://127.0.0.1:3030/rezics/
# Capability token for Fuseki maintenance requests.
FUSEKI_MAINTENANCE_TOKEN=<generated by task dev:prepare>
# Capability token for Fuseki command requests.
FUSEKI_COMMAND_TOKEN=<generated by task dev:prepare>
# Graph data epoch this stack was initialized with.
MAIN_DATA_EPOCH=1
# Port Main listens on at 127.0.0.1. (default: 3001)
# MAIN_PORT=3001
# Graph routing epoch this stack was initialized with.
MAIN_ROUTING_EPOCH=1
# HMAC key for Fuseki title admission proofs.
FUSEKI_TITLE_ADMISSION_KEY=<generated by task dev:prepare>
# Access owner PostgreSQL URL.
ACCESS_DATABASE_URL=postgres://role:password@127.0.0.1:5432/role
# Content owner PostgreSQL URL.
CONTENT_DATABASE_URL=postgres://role:password@127.0.0.1:5432/role
# Relay PostgreSQL URL; enables relay hand-off positions. (optional)
# MAIN_RELAY_DATABASE_URL=postgres://role:password@127.0.0.1:5432/role
# Relay consumer name; set together with MAIN_RELAY_DATABASE_URL. (optional)
# MAIN_RELAY_CONSUMER=
# Account relay URL for erasure and recommendation events. (optional)
# ACCOUNT_RELAY_DATABASE_URL=postgres://role:password@127.0.0.1:5432/role
# Relay URL for owner operations; defaults to MAIN_RELAY_DATABASE_URL. (optional)
# OWNER_RELAY_DATABASE_URL=postgres://role:password@127.0.0.1:5432/role
# Consumer name for the Content public search projection. (default: main-content-public-search-v1)
# CONTENT_PROJECTION_CONSUMER=main-content-public-search-v1
# Content projection polling interval. (default: 1000)
# CONTENT_PROJECTION_INTERVAL_MS=1000
# Directory for immutable Main objects without S3.
MAIN_OBJECT_DIRECTORY=.temp/stack/rezics-dev/objects
# Local dev only: checkout whose locked Open Library fixtures replace provider requests. (optional)
# MAIN_OPEN_LIBRARY_FIXTURE_ROOT=
# S3 endpoint for immutable objects (RustFS locally).
MAIN_S3_ENDPOINT=http://127.0.0.1:9000
# S3 bucket.
MAIN_S3_BUCKET=rezics-semantic
# S3 region.
MAIN_S3_REGION=us-east-1
# S3 access key.
MAIN_S3_ACCESS_KEY=<generated by task dev:prepare>
# S3 secret key.
MAIN_S3_SECRET_KEY=<generated by task dev:prepare>
# Account OAuth issuer.
ACCOUNT_ISSUER=http://127.0.0.1:3002/api/auth
# OAuth resource identifier for Main.
ACCOUNT_MAIN_RESOURCE=https://main.rezics.test
# Account JWKS URL.
ACCOUNT_JWKS_URL=http://127.0.0.1:3002/api/auth/jwks
# Account token introspection URL.
ACCOUNT_INTROSPECT_URL=http://127.0.0.1:3002/api/auth/oauth2/introspect
# Main's confidential client ID at Account.
ACCOUNT_MAIN_CLIENT_ID=<generated>
# Main's confidential client secret at Account.
ACCOUNT_MAIN_CLIENT_SECRET=<generated by task dev:prepare>
# Notification provider URL; enables delivery. (optional)
# MAIN_NOTIFICATION_PROVIDER_URL=
# Notification provider bearer token. (optional)
# MAIN_NOTIFICATION_PROVIDER_TOKEN=<secret>
# Secret for notification delivery callbacks. (optional)
# MAIN_NOTIFICATION_CALLBACK_SECRET=<secret>
# Notification delivery polling interval. (default: 1000)
# MAIN_NOTIFICATION_INTERVAL_MS=1000
# Account recovery URL used by owner operations. (optional)
# ACCOUNT_RECOVERY_DATABASE_URL=postgres://role:password@127.0.0.1:5432/role
# HMAC key for owner recovery manifests. (optional)
# RECOVERY_MANIFEST_HMAC_KEY=<secret>
# Target URL for an owner relocation. (optional)
# OWNER_RELOCATION_TARGET_URL=postgres://role:password@127.0.0.1:5432/role
# Target object directory for an owner relocation. (optional)
# OWNER_RELOCATION_TARGET_OBJECT_DIRECTORY=
# Load run ID tagged onto search metrics during `task load`. (optional)
# REZICS_LOAD_RUN_ID=

## Main relay (src/relay.ts, src/relay-init.ts)
# Relay polling interval. (default: 1000)
# MAIN_RELAY_INTERVAL_MS=1000
