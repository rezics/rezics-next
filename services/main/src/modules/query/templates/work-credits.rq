PREFIX rv: <https://rezics.com/vocab/>
PREFIX schema: <https://schema.org/>
# An unbound _role reads author, director, artist and animation-studio. The seek key supplies that order.
SELECT ?id ?key ?ordinal ?confirmation ?role ?participantKind ?provider ?agent WHERE {
  VALUES (?_work_iri ?_main_iri) {}
  VALUES (?id ?_sort) {}
  {
    GRAPH <urn:rezics:graph:current> {
      ?id a rv:AuthorCredit ; rv:work ?_work_iri ; rv:creditRevision ?revision ;
        schema:roleName "author" ; rv:externalProvider "open-library" ; rv:externalNamespace "author" ;
        rv:externalKey ?key ; schema:position ?ordinal ; rv:editControl rv:HumanConfirmed .
      FILTER NOT EXISTS { ?id rv:retiredBy ?retirement }
    }
    GRAPH <urn:rezics:graph:revisions> {
      ?revision a rv:AuthorCreditRevision ; rv:component ?id ; rv:work ?_work_iri ; rv:externalKey ?key ; schema:position ?ordinal .
    }
    BIND("author" AS ?role)
    BIND("external-reference" AS ?participantKind)
    BIND("open-library" AS ?provider)
    FILTER(!BOUND(?_role) || ?_role = "author")
  } UNION {
    GRAPH <urn:rezics:graph:current> {
      ?id a rv:NativeAgentCredit ; rv:work ?_work_iri ; rv:creditRevision ?revision ;
        rv:agent ?agent ; schema:roleName ?role .
    }
    GRAPH <urn:rezics:graph:revisions> {
      ?revision a rv:NativeAgentCreditRevision ; rv:component ?id ; rv:work ?_work_iri ;
        rv:agent ?agent ; schema:roleName ?role .
    }
    BIND("agent" AS ?participantKind)
    FILTER(?role = "author" || ?role = "director" || ?role = "artist" || ?role = "animation-studio")
    FILTER(!BOUND(?_role) || ?role = ?_role)
  } UNION {
    VALUES (?id ?key ?ordinal ?_work_iri ?_source_confirmed) {}
    FILTER(!?_source_confirmed)
    FILTER(!BOUND(?_role) || ?_role = "author")
    BIND("source-reported" AS ?confirmation)
    BIND("author" AS ?role)
    BIND("external-reference" AS ?participantKind)
    BIND("open-library" AS ?provider)
  }
}
