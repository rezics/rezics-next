PREFIX rv: <https://rezics.com/vocab/>
PREFIX schema: <https://schema.org/>
# The seek key orders every admitted role for either participant alternative.
SELECT ?id ?key ?ordinal ?confirmation ?role ?participantKind ?provider ?namespace ?agent ?displayName WHERE {
  VALUES (?_work_iri ?_main_iri) {}
  VALUES (?id ?_sort) {}
  {
    GRAPH <urn:rezics:graph:current> {
      ?id a rv:AuthorCredit ; rv:work ?_work_iri ; rv:creditRevision ?revision ;
        schema:roleName ?role ; rv:externalProvider ?provider ; rv:externalNamespace ?namespace ;
        rv:externalKey ?key ; schema:position ?ordinal ; rv:editControl rv:HumanConfirmed .
      FILTER NOT EXISTS { ?id rv:retiredBy ?retirement }
    }
    GRAPH <urn:rezics:graph:revisions> {
      ?revision a rv:AuthorCreditRevision ; rv:component ?id ; rv:work ?_work_iri ; schema:roleName ?role ; rv:externalProvider ?provider ;
        rv:externalNamespace ?namespace ; rv:externalKey ?key ; schema:position ?ordinal .
      FILTER NOT EXISTS { ?revision a rv:ErasedRevision }
    }
    BIND("external-reference" AS ?participantKind)
    FILTER(!BOUND(?_role) || ?_role = ?role)
  } UNION {
    # Every native role shares the attribution owner's post-hydration admission;
    # a bound Agent reference alone is not permission to disclose its identity.
    GRAPH <urn:rezics:graph:current> {
      ?id a rv:NativeAgentCredit ; rv:work ?_work_iri ; rv:creditRevision ?revision ;
        rv:agent ?agent ; schema:roleName ?role .
    }
    GRAPH <urn:rezics:graph:revisions> {
      ?revision a rv:NativeAgentCreditRevision ; rv:component ?id ; rv:work ?_work_iri ;
        rv:agent ?agent ; schema:roleName ?role .
      FILTER NOT EXISTS { ?revision a rv:ErasedRevision }
    }
    FILTER NOT EXISTS { GRAPH <urn:rezics:graph:current> { ?id rv:retiredBy ?retirement } }
    BIND("agent" AS ?participantKind)
    FILTER(?role IN ("author", "director", "artist", "animation-studio", "translator", "editor", "performer"))
    FILTER(!BOUND(?_role) || ?role = ?_role)
  } UNION {
    VALUES (?id ?key ?ordinal ?_work_iri ?_source_confirmed ?_source_role ?_source_provider ?_source_agent ?_source_name) {}
    FILTER(!?_source_confirmed)
    FILTER(!BOUND(?_role) || ?_role = ?_source_role)
    BIND("source-reported" AS ?confirmation)
    BIND(?_source_role AS ?role)
    BIND(IF(?_source_role = "transcriber", "agent", "external-reference") AS ?participantKind)
    BIND(?_source_provider AS ?provider)
    BIND(IF(STRLEN(?_source_agent) > 0, IRI(?_source_agent), 1/0) AS ?agent)
    BIND(IF(STRLEN(?_source_name) > 0, ?_source_name, 1/0) AS ?displayName)
  }
}
