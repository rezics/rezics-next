    "content.board": { "owner": "content.board.owner", "standing": ["content.board.standing"] },
    "content.thread": { "owner": "content.thread.owner", "standing": ["content.thread.standing"] },
    "content.post": { "owner": "content.post.owner", "standing": ["content.post.standing"] },
    "content.media": { "owner": "content.media.owner", "standing": [] },
