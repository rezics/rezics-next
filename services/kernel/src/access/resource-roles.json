    "content.thread.standing": ["post:create", "media:create", "report:create"],
    "content.post.owner": ["post:read", "post:revise", "post:erase", "media:create"],
    "content.post.standing": ["report:create"],
    "content.media.owner": ["media:read_reservation", "media:read", "media:complete", "media:erase"]
  },
