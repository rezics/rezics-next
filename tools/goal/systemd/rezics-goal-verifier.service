[Unit]
Description=Goal dev verifier
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=@CHECKOUT@
EnvironmentFile=@ENVIRONMENT@
ExecStart=/usr/bin/env -i "HOME=${HOME}" "PATH=${PATH}" "GOAL_MAIN_CHECKOUT=${GOAL_MAIN_CHECKOUT}" "GOAL_LOCAL_CONFIG=${GOAL_LOCAL_CONFIG}" "KERNEL_CHECK_REMOTE=${KERNEL_CHECK_REMOTE}" "XDG_RUNTIME_DIR=%t" "DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus" @BUN@ @CLI@ service run-verifier
Restart=always
RestartSec=30s
KillMode=control-group

[Install]
WantedBy=default.target
