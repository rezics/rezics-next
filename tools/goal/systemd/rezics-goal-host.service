[Unit]
Description=Resident Goal manager host
StartLimitIntervalSec=0

[Service]
Type=notify
WorkingDirectory=@CHECKOUT@
EnvironmentFile=@ENVIRONMENT@
ExecStart=/usr/bin/env -i "HOME=${HOME}" "PATH=${PATH}" "GOAL_MAIN_CHECKOUT=${GOAL_MAIN_CHECKOUT}" "GOAL_LOCAL_CONFIG=${GOAL_LOCAL_CONFIG}" "KERNEL_CHECK_REMOTE=${KERNEL_CHECK_REMOTE}" "XDG_RUNTIME_DIR=%t" "DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus" "NOTIFY_SOCKET=${NOTIFY_SOCKET}" "WATCHDOG_USEC=${WATCHDOG_USEC}" @BUN@ @CLI@ _manager-host
Restart=always
RestartSec=5s
WatchdogSec=60s
NotifyAccess=all
KillMode=process
TimeoutStartSec=90s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
