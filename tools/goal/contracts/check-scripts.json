{
  "contract": "rezics.check-scripts",
  "version": 1,
  "workerCheck": {
    "script": "scripts/worker-check.ts",
    "startArgv": ["--", "<command...>"],
    "startOutput": "check: id <uuid>",
    "foregroundArgv": ["--wait", "<id>"],
    "foregroundOutput": ["check: exit status <exitCode>", "check: log <path>"],
    "resultPath": ".temp/goal/checks/results/<id>.json",
    "logPathPrefix": ".temp/goal/checks/worker-check-",
    "record": {
      "identityFields": ["id", "cwd", "argv", "runnerPid", "runnerHost"],
      "sharedFields": ["status", "log"],
      "states": {
        "running": {
          "status": "running",
          "requiredFields": ["id", "cwd", "argv", "status", "log", "runnerPid", "runnerHost"],
          "exitCode": "absent"
        },
        "completed": {
          "status": "finished",
          "requiredFields": ["id", "cwd", "argv", "status", "log", "runnerPid", "runnerHost", "exitCode"],
          "exitCode": "integer"
        }
      },
      "id": "uuid",
      "cwd": "absolute-worktree-root",
      "argv": "worker-check-options-and-command-string-array",
      "runnerPid": "positive-safe-integer",
      "runnerHost": "non-empty-string",
      "log": "worktree-relative-log-path"
    },
    "bun": {
      "manifestField": "package.json#packageManager",
      "versionPrefix": "bun@",
      "lookup": "node_modules/.bin/bun",
      "versionArgv": ["--version"],
      "revisionArgv": ["--eval", "console.log(Bun.revision)"],
      "versionMustMatchManifest": true,
      "identityPolicy": "Require exact manifest/dependency/lockfile package pin, known lockfile integrity, installed package metadata, resolved executable SHA-256, runtime version and runtime revision. Unknown pins or platform artifacts fail closed. The canary package label is not Bun.version.",
      "artifacts": {
        "bun@1.4.4-canary.20261027.1": {
          "packageVersion": "1.4.4-canary.20261027.1+9b8347a",
          "runtimeVersion": "1.4.4",
          "runtimeRevision": "a0cc096ce8ceed48cfefbdd2d97aa3f905b8be6b",
          "packageIntegrity": "sha512-yAKBNhBZomCqRV8a/icJPhQq47sjGRDZBDqrzJT8XSOkjzIipVZS462aHr9qTVh2QesoOnQsPpYFkQSocOiJ0A==",
          "packageTarball": "https://registry.npmjs.org/bun/-/bun-1.4.4-canary.20261027.1.tgz",
          "provenance": "npm tarballs verified against dev bun.lock SHA-512 integrity; executable hashed and probed for --version and Bun.revision. This pinned bun/install.js optimizeBun renames the optional platform executable to bun/bin/bun.exe; accept retained or package-owned moved layouts with exact metadata/dependency custody, checking any retained executable too. Package build metadata differs from the embedded runtime revision.",
          "platforms": {
            "linux-x64": {
              "package": "@oven/bun-linux-x64",
              "integrity": "sha512-GTKkejc85y2PEelaq9DJnbwJaVfDjJYR8bFKCeUnnbq4s/dWJFv602rp8FW/CnkxNQ/3RKUjB+lk4DTJ87cU5g==",
              "tarball": "https://registry.npmjs.org/@oven/bun-linux-x64/-/bun-linux-x64-1.4.4-canary.20261027.1.tgz",
              "executable": "bin/bun",
              "executableSha256": "bc54c90edf4f07206a316514ae9a09ca9cbfbeeb50654bf0f1928d2b38c87c68"
            }
          }
        },
        "bun@1.4.4-canary.20261031.1": {
          "packageVersion": "1.4.4-canary.20261031.1+34cbc70",
          "runtimeVersion": "1.4.4",
          "runtimeRevision": "da867c60bf0bcbf9d6d36994f8ca0efa42075115",
          "packageIntegrity": "sha512-kW0NXASzus9u6ag/o6Opm+vqN7FIu1pd2Fb3FIMqbS5PelHbkn8pKX39QO+HbWKM84HRlGnthsexE3JdHHoGfA==",
          "packageTarball": "https://registry.npmjs.org/bun/-/bun-1.4.4-canary.20261031.1.tgz",
          "provenance": "Official npm wrapper and linux-x64 platform metadata supplied after SHA-512 verification against the captured dev lockfile. Executable SHA-256 and embedded runtime identity are exact supplied artifact metadata, not release verification. Only the supplied linux-x64 platform is supported.",
          "platforms": {
            "linux-x64": {
              "package": "@oven/bun-linux-x64",
              "integrity": "sha512-G2RHjlnR1HdpIwPphi0e9Ku3KJh9f2J+MD8QxKW61TQr1hOEacIQkIZsyikibnHUFCPM2ZIY4IqZvsG/FeM7ZQ==",
              "tarball": "https://registry.npmjs.org/@oven/bun-linux-x64/-/bun-linux-x64-1.4.4-canary.20261031.1.tgz",
              "executable": "bin/bun",
              "executableSha256": "fe406996b9915f388e3fad9e6e29ece9c7cb81e06257bbcb4c50f91691b46810"
            }
          }
        }
      }
    },
    "execution": "Start returns a detached check UUID; foregroundArgv waits for that existing check and returns its recorded exit status. It does not start a new foreground check."
  },
  "remoteCheck": {
    "script": "scripts/remote-check.ts",
    "requiredEnvironment": {
      "KERNEL_CHECK_REMOTE": "hosts-file-path"
    },
    "optionalEnvironment": {
      "REMOTE_CHECK_PRIORITY": ["landing", "critical"]
    },
    "requiredOptions": [
      {
        "flag": "--memory-gib",
        "value": "<positive-integer>",
        "consumer": "worker-check.ts"
      },
      {
        "flag": "--returns",
        "value": "<path>",
        "consumer": "worker-check.ts",
        "repeatable": true
      }
    ],
    "commandTail": ["<workspace>", "--", "<command...>"]
  }
}
