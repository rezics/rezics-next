{
  "version": 1,
  "mainBranch": "main",
  "branchPrefix": "worker/",
  "terminationGraceMs": 1500,
  "silenceMs": 2400000,
  "affectedTests": [
    {
      "paths": ["services/kernel/**"],
      "command": ["env", "KERNEL_CHECK_AFFECTED_MAX=60", "bun", "run", "--cwd", "services/kernel", "check"]
    }
  ],
  "verifierChecks": [
    {
      "paths": ["services/kernel/**"],
      "command": ["env", "KERNEL_CHECK_AFFECTED_MAX=60", "bun", "run", "--cwd", "services/kernel", "check"]
    },
    {
      "paths": [
        "apps/**",
        "services/**",
        "packages/**",
        "specs/**",
        "scripts/**",
        "package.json",
        "bun.lock",
        "tsconfig*.json"
      ],
      "command": ["bun", "scripts/workspace-imports.ts"]
    },
    {
      "paths": ["apps/web/**", "packages/ui/**", "packages/document/**"],
      "command": ["bun", "test", "apps/web/tests/library-page-smoke.test.ts"]
    },
    {
      "paths": ["apps/web/scripts/**"],
      "command": ["bun", "test", "apps/web/scripts/remote-browser.test.ts"]
    },
    {
      "paths": ["packages/client/src/kernel/**"],
      "command": [
        "sh",
        "-c",
        "bun run --cwd apps/web generate && bun apps/web/scripts/isolated.ts bun test apps/web/tests/page-stories.test.ts -t 'each recorded response type-checks'"
      ]
    }
  ],
  "siblingTests": {
    "command": ["bun", "test"]
  },
  "integrationChecks": [
    {
      "paths": [
        "apps/**",
        "services/**",
        "packages/**",
        "specs/**",
        "scripts/**",
        "package.json",
        "bun.lock",
        "tsconfig*.json"
      ],
      "command": ["bun", "install"]
    },
    {
      "paths": [
        "apps/**",
        "services/**",
        "packages/**",
        "specs/**",
        "scripts/**",
        "package.json",
        "bun.lock",
        "tsconfig*.json"
      ],
      "command": ["bun", "scripts/typecheck.ts"]
    },
    {
      "paths": [
        "apps/**",
        "services/**",
        "packages/**",
        "specs/**",
        "scripts/**",
        "package.json",
        "bun.lock",
        "tsconfig*.json"
      ],
      "command": ["bun", "scripts/workspace-imports.ts"]
    },
    {
      "paths": ["apps/web/**", "packages/ui/**", "packages/document/**"],
      "command": ["bun", "test", "apps/web/tests/library-page-smoke.test.ts"]
    },
    {
      "paths": ["packages/client/src/kernel/**"],
      "command": [
        "sh",
        "-c",
        "bun run --cwd apps/web generate && bun apps/web/scripts/isolated.ts bun test apps/web/tests/page-stories.test.ts -t 'each recorded response type-checks'"
      ]
    }
  ],
  "derivedFiles": [
    {
      "path": "bun.lock",
      "stage": "integration",
      "command": ["bun", "install"]
    },
    {
      "path": "services/kernel/db/*/schema.sql",
      "stage": "integration",
      "command": ["bun", "run", "--cwd", "services/kernel", "derived", "schema"]
    },
    {
      "path": "packages/client/src/kernel/**",
      "stage": "promotion",
      "command": ["bun", "run", "--cwd", "services/kernel", "derived"],
      "inputs": ["services/kernel/**"]
    },
    {
      "path": "contracts/openapi.json",
      "stage": "promotion",
      "command": ["bun", "run", "--cwd", "services/kernel", "derived"],
      "inputs": ["services/kernel/**"]
    }
  ],
  "jsonMessageConflicts": ["apps/web/messages/*.json"],
  "integration": {
    "batchSize": 4,
    "devLandingChecks": true,
    "batchAcceptanceConcurrency": 8,
    "gateConcurrency": 1,
    "gateTimeoutMs": 1800000,
    "tmuxCommand": "tmux",
    "tmuxSession": "goal",
    "managerCompactTokens": 300000,
    "checkResultReuse": false,
    "supermanager": "supermanager",
    "hourlyReportTimeoutMs": 20000,
    "managerLimits": {
      "turns": 100,
      "turnsWithoutDecision": 10,
      "wallMs": 43200000
    },
    "termspacesCommand": "termspaces",
    "devPrelandingTypecheck": false
  },
  "codex": {
    "serviceTier": "default",
    "compactTokens": {
      "sol": 160000,
      "luna": 200000
    },
    "solContextWindow": 500000,
    "toolOutputTokens": 4000,
    "backgroundTerminalMaxTimeoutMs": 7200000
  },
  "launchSmokePaths": ["tools/goal/**"],
  "gate": ["bun", "scripts/gate.ts"],
  "promotionParallelism": 4,
  "flow": {
    "efficiencyBelow": 0.4,
    "oldestQueueMs": 3600000,
    "landingP90Ms": 1800000,
    "attemptsPerIntegrated": 1.5
  },
  "policy": {
    "backlog": {
      "lowWater": 8,
      "wakeIntervalMs": 3600000,
      "stoppedTaskLimitMs": 3600000,
      "stoppedTasksPerGoalPerRun": 20,
      "dispatchesPerSweep": 4,
      "settleMs": 10000,
      "refusalBriefs": 4,
      "refusalReasonCharacters": 160,
      "refusalSummaryCharacters": 1000
    },
    "capacity": {
      "maxWorkers": 32,
      "minAvailableMiB": 6144,
      "criticalHeadStartMs": 1800000,
      "admissionRetryMs": 50,
      "pollIntervalMs": 15000,
      "reservationPollMs": 250
    },
    "validation": {
      "notifierArguments": 32,
      "notifierArgumentCharacters": 4096,
      "hourlyReportMaxTimeoutMs": 120000
    },
    "flowHistoryMs": 2592000000,
    "worker": {
      "capacityPauseMs": 10000,
      "usageLimitRetryPauseMs": 180000,
      "usageLimitRefusalWindowMs": 3600000,
      "usageLimitRefusals": 3,
      "usageLimitExhaustionMs": 3600000,
      "waitingResumeLaunchFailures": 3,
      "startGraceMs": 600000,
      "silenceCheckMs": 60000,
      "activityPollMs": 30000,
      "orphanStartGraceMultiplier": 2,
      "sweepYieldItems": 8,
      "retryIntentLeadMs": 1000,
      "toolRetryBackoffMs": [120000, 600000, 1800000],
      "toolRetryWindowMs": 3600000,
      "toolRetryEventRows": 5000,
      "settlementBackoffMs": [500, 1000, 2000, 4000, 8000],
      "logTailBytes": 262144,
      "diagnosticCharacters": 4000,
      "summaryCharacters": 1000,
      "reportResultCharacters": 2000,
      "failedResultCharacters": 500,
      "fixtureCleanupGraceMs": 250
    },
    "workerResources": {
      "cpuWeight": 50,
      "ioWeight": 50,
      "preparationTimeoutMs": 5000,
      "memoryReserveGiB": 14,
      "minimumMemoryFraction": 0.25
    },
    "appServer": {
      "requestTimeoutMs": 30000,
      "readinessTimeoutMs": 30000,
      "connectTimeoutMs": 30000,
      "terminationGraceMs": 500,
      "diagnosticCharacters": 262144,
      "exitPollMs": 20,
      "killWaitMs": 5000
    },
    "containers": {
      "commandTimeoutMs": 15000,
      "maxAgeHours": 4,
      "cleanupIntervalMs": 600000
    },
    "process": {
      "groupPollMs": 1000,
      "exitPollMs": 50,
      "signalDiagnosticCharacters": 4096,
      "resolverTerminationGraceMs": 1000
    },
    "host": {
      "startupTimeoutMs": 45000,
      "supervisorStartupTimeoutMs": 45000,
      "socketTimeoutMs": 250,
      "leasePollMs": 25,
      "pollMs": 1000,
      "minBackoffMs": 250,
      "maxBackoffMs": 30000,
      "retryFailures": 30,
      "healthResetMs": 60000,
      "startupLogBytes": 4000,
      "retryDiagnosticCharacters": 160,
      "restartIntervalMs": 600000,
      "stateSweepIntervalMs": 60000,
      "codePollMs": 1000,
      "recoveryIntervalMs": 60000,
      "recoveryReadinessMs": 100,
      "requestTimeoutMs": 60000,
      "requestRetryMs": 25,
      "decisionAuditTimeoutMs": 500,
      "flowReviewIntervalMs": 3600000,
      "reportTimeoutMs": 150000,
      "reportOverheadMs": 30000,
      "reportTerminationGraceMs": 250,
      "reportOutputCharacters": 512
    }
  }
}
