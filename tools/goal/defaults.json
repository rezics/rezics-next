{
  "version": 1,
  "mainBranch": "main",
  "branchPrefix": "worker/",
  "terminationGraceMs": 1500,
  "integrationChecks": [
    ["bun", "install"],
    ["bun", "run", "--cwd", "services/kernel", "openapi"]
  ],
  "derivedFiles": [
    {
      "path": "bun.lock",
      "stage": "integration",
      "command": ["bun", "install"]
    },
    {
      "path": "packages/client/src/kernel/**",
      "stage": "promotion",
      "command": ["bun", "run", "--cwd", "services/kernel", "derived"]
    },
    {
      "path": "contracts/openapi.json",
      "stage": "promotion",
      "command": ["bun", "run", "--cwd", "services/kernel", "derived"]
    }
  ],
  "integration": {
    "gateConcurrency": 1,
    "gateTimeoutMs": 1800000,
    "tmuxCommand": "tmux",
    "tmuxSession": "goal",
    "managerCompactTokens": 300000,
    "supermanager": "supermanager",
    "managerLimits": {
      "turns": 100,
      "turnsWithoutDecision": 10,
      "wallMs": 43200000
    },
    "termspacesCommand": "termspaces"
  },
  "codex": {
    "serviceTier": "fast",
    "compactTokens": {
      "sol": 160000,
      "luna": 200000
    },
    "solContextWindow": 500000,
    "toolOutputTokens": 4000
  },
  "gate": [
    "bun",
    "scripts/gate.ts"
  ]
}
