{
  "@context": {
    "sh": {
      "@id": "http://www.w3.org/ns/shacl#",
      "@prefix": true
    },
    "rdf": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "@prefix": true
    },
    "xsd": {
      "@id": "http://www.w3.org/2001/XMLSchema#",
      "@prefix": true
    },
    "rv": {
      "@id": "https://rezics.com/vocab/",
      "@prefix": true
    },
    "rdf:type": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
      "@type": "@id"
    },
    "rv:binding": {
      "@id": "https://rezics.com/vocab/binding",
      "@type": "@id"
    },
    "rv:bindingHead": {
      "@id": "https://rezics.com/vocab/bindingHead",
      "@type": "@id"
    },
    "rv:bindingState": {
      "@id": "https://rezics.com/vocab/bindingState",
      "@type": "@id"
    },
    "rv:boundEvent": {
      "@id": "https://rezics.com/vocab/boundEvent"
    },
    "rv:predecessor": {
      "@id": "https://rezics.com/vocab/predecessor",
      "@type": "@id"
    },
    "rv:revisedAt": {
      "@id": "https://rezics.com/vocab/revisedAt",
      "@type": "xsd:dateTime"
    },
    "rv:topic": {
      "@id": "https://rezics.com/vocab/topic",
      "@type": "@id"
    }
  }
}
