{
  "@context": {
    "sh": {
      "@id": "http://www.w3.org/ns/shacl#",
      "@prefix": true
    },
    "rdf": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "@prefix": true
    },
    "xsd": {
      "@id": "http://www.w3.org/2001/XMLSchema#",
      "@prefix": true
    },
    "rv": {
      "@id": "https://rezics.com/vocab/",
      "@prefix": true
    },
    "rdf:type": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
      "@type": "@id"
    },
    "rv:authoredBy": {
      "@id": "https://rezics.com/vocab/authoredBy",
      "@type": "@id"
    },
    "rv:component": {
      "@id": "https://rezics.com/vocab/component",
      "@type": "@id"
    },
    "rv:dataEpoch": {
      "@id": "https://rezics.com/vocab/dataEpoch"
    },
    "rv:definitionHead": {
      "@id": "https://rezics.com/vocab/definitionHead",
      "@type": "@id"
    },
    "rv:definitionRef": {
      "@id": "https://rezics.com/vocab/definitionRef",
      "@type": "@id"
    },
    "rv:definitionState": {
      "@id": "https://rezics.com/vocab/definitionState",
      "@type": "@id"
    },
    "rv:manifest": {
      "@id": "https://rezics.com/vocab/manifest",
      "@type": "@id"
    },
    "rv:modelRevision": {
      "@id": "https://rezics.com/vocab/modelRevision",
      "@type": "@id"
    },
    "rv:operation": {
      "@id": "https://rezics.com/vocab/operation",
      "@type": "@id"
    },
    "rv:predecessor": {
      "@id": "https://rezics.com/vocab/predecessor",
      "@type": "@id"
    },
    "rv:sequence": {
      "@id": "https://rezics.com/vocab/sequence",
      "@type": "xsd:integer"
    },
    "rv:shapeRevision": {
      "@id": "https://rezics.com/vocab/shapeRevision",
      "@type": "@id"
    }
  }
}
