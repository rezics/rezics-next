{
  "@context": {
    "sh": {
      "@id": "http://www.w3.org/ns/shacl#",
      "@prefix": true
    },
    "rdf": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "@prefix": true
    },
    "xsd": {
      "@id": "http://www.w3.org/2001/XMLSchema#",
      "@prefix": true
    },
    "time": {
      "@id": "http://www.w3.org/2006/time#",
      "@prefix": true
    },
    "rv": {
      "@id": "https://rezics.com/vocab/",
      "@prefix": true
    },
    "rdf:type": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
      "@type": "@id"
    },
    "rv:event": {
      "@id": "https://rezics.com/vocab/event",
      "@type": "@id"
    },
    "rv:eventEnd": {
      "@id": "https://rezics.com/vocab/eventEnd",
      "@type": "@id"
    },
    "rv:eventStart": {
      "@id": "https://rezics.com/vocab/eventStart",
      "@type": "@id"
    },
    "rv:eventTime": {
      "@id": "https://rezics.com/vocab/eventTime",
      "@type": "@id"
    },
    "rv:eventTimeHead": {
      "@id": "https://rezics.com/vocab/eventTimeHead",
      "@type": "@id"
    },
    "rv:pointState": {
      "@id": "https://rezics.com/vocab/pointState",
      "@type": "@id"
    },
    "rv:predecessor": {
      "@id": "https://rezics.com/vocab/predecessor",
      "@type": "@id"
    },
    "rv:recordedAt": {
      "@id": "https://rezics.com/vocab/recordedAt",
      "@type": "xsd:dateTime"
    },
    "rv:temporalKind": {
      "@id": "https://rezics.com/vocab/temporalKind",
      "@type": "@id"
    },
    "rv:temporalValue": {
      "@id": "https://rezics.com/vocab/temporalValue",
      "@type": "@id"
    },
    "rv:timeAvailability": {
      "@id": "https://rezics.com/vocab/timeAvailability",
      "@type": "@id"
    },
    "rv:timeEvidence": {
      "@id": "https://rezics.com/vocab/timeEvidence",
      "@type": "@id"
    },
    "rv:timeStatus": {
      "@id": "https://rezics.com/vocab/timeStatus",
      "@type": "@id"
    },
    "rv:unknownLexical": {
      "@id": "https://rezics.com/vocab/unknownLexical"
    }
  }
}
