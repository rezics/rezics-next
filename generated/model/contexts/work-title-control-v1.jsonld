{
  "@context": {
    "sh": {
      "@id": "http://www.w3.org/ns/shacl#",
      "@prefix": true
    },
    "rdf": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "@prefix": true
    },
    "xsd": {
      "@id": "http://www.w3.org/2001/XMLSchema#",
      "@prefix": true
    },
    "schema": {
      "@id": "https://schema.org/",
      "@prefix": true
    },
    "rv": {
      "@id": "https://rezics.com/vocab/",
      "@prefix": true
    },
    "rdf:type": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
      "@type": "@id"
    },
    "rv:component": {
      "@id": "https://rezics.com/vocab/component",
      "@type": "@id"
    },
    "rv:controlEpoch": {
      "@id": "https://rezics.com/vocab/controlEpoch",
      "@type": "xsd:integer"
    },
    "rv:controlField": {
      "@id": "https://rezics.com/vocab/controlField",
      "@type": "@id"
    },
    "rv:controlIntent": {
      "@id": "https://rezics.com/vocab/controlIntent"
    },
    "rv:controlMode": {
      "@id": "https://rezics.com/vocab/controlMode",
      "@type": "@id"
    },
    "rv:dataEpoch": {
      "@id": "https://rezics.com/vocab/dataEpoch"
    },
    "rv:manifest": {
      "@id": "https://rezics.com/vocab/manifest",
      "@type": "@id"
    },
    "rv:modelRevision": {
      "@id": "https://rezics.com/vocab/modelRevision",
      "@type": "@id"
    },
    "rv:operation": {
      "@id": "https://rezics.com/vocab/operation",
      "@type": "@id"
    },
    "rv:predecessor": {
      "@id": "https://rezics.com/vocab/predecessor",
      "@type": "@id"
    },
    "rv:sequence": {
      "@id": "https://rezics.com/vocab/sequence",
      "@type": "xsd:integer"
    },
    "rv:shapeRevision": {
      "@id": "https://rezics.com/vocab/shapeRevision",
      "@type": "@id"
    },
    "rv:workRevision": {
      "@id": "https://rezics.com/vocab/workRevision",
      "@type": "@id"
    }
  }
