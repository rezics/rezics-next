{
  "@context": {
    "sh": {
      "@id": "http://www.w3.org/ns/shacl#",
      "@prefix": true
    },
    "rdf": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "@prefix": true
    },
    "xsd": {
      "@id": "http://www.w3.org/2001/XMLSchema#",
      "@prefix": true
    },
    "rv": {
      "@id": "https://rezics.com/vocab/",
      "@prefix": true
    },
    "rdf:type": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
      "@type": "@id"
    },
    "rv:approvedAt": {
      "@id": "https://rezics.com/vocab/approvedAt",
      "@type": "xsd:dateTime"
    },
    "rv:approverSlot": {
      "@id": "https://rezics.com/vocab/approverSlot",
      "@type": "@id"
    },
    "rv:candidateDigest": {
      "@id": "https://rezics.com/vocab/candidateDigest"
    },
    "rv:expectedBallotRevision": {
      "@id": "https://rezics.com/vocab/expectedBallotRevision",
      "@type": "@id"
    },
    "rv:holderCharter": {
      "@id": "https://rezics.com/vocab/holderCharter",
      "@type": "@id"
    },
    "rv:mandatePolicyRevision": {
      "@id": "https://rezics.com/vocab/mandatePolicyRevision",
      "@type": "@id"
    },
    "rv:operation": {
      "@id": "https://rezics.com/vocab/operation",
      "@type": "@id"
    },
    "rv:poll": {
      "@id": "https://rezics.com/vocab/poll",
      "@type": "@id"
    },
    "rv:pollOpening": {
      "@id": "https://rezics.com/vocab/pollOpening",
      "@type": "@id"
    },
    "rv:seat": {
      "@id": "https://rezics.com/vocab/seat",
      "@type": "@id"
    }
  }
}
