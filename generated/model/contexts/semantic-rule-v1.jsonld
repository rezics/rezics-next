    },
    "rv:derivedGenerationHead": {
      "@id": "https://rezics.com/vocab/derivedGenerationHead",
      "@type": "@id"
    },
    "rv:manifest": {
      "@id": "https://rezics.com/vocab/manifest",
      "@type": "@id"
    },
    "rv:modelGeneration": {
      "@id": "https://rezics.com/vocab/modelGeneration",
      "@type": "@id"
    },
    "rv:modelRevision": {
      "@id": "https://rezics.com/vocab/modelRevision",
      "@type": "@id"
    },
    "rv:operation": {
      "@id": "https://rezics.com/vocab/operation",
      "@type": "@id"
    },
    "rv:outputPredicate": {
