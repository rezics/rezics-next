      "@type": "@id"
    },
    "rv:predecessor": {
      "@id": "https://rezics.com/vocab/predecessor",
      "@type": "@id"
    },
    "rv:realm": {
      "@id": "https://rezics.com/vocab/realm",
      "@type": "@id"
    },
    "rv:ruleHead": {
      "@id": "https://rezics.com/vocab/ruleHead",
