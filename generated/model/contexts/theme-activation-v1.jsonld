    "rv:datasetId": {
      "@id": "https://rezics.com/vocab/datasetId",
      "@type": "@id"
    },
    "rv:dependencyDigest": {
      "@id": "https://rezics.com/vocab/dependencyDigest"
    },
    "rv:modelRevision": {
