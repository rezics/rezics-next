      "@id": "https://rezics.com/vocab/capabilities"
    },
    "rv:capabilityDigest": {
      "@id": "https://rezics.com/vocab/capabilityDigest"
    },
    "rv:component": {
      "@id": "https://rezics.com/vocab/component",
      "@type": "@id"
    },
