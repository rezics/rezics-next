    "rv:operation": {
      "@id": "https://rezics.com/vocab/operation",
      "@type": "@id"
    },
    "rv:origin": {
      "@id": "https://rezics.com/vocab/origin"
    },
    "rv:predecessor": {
      "@id": "https://rezics.com/vocab/predecessor",
      "@type": "@id"
    },
    "rv:runtime": {
      "@id": "https://rezics.com/vocab/runtime",
