{
  "@context": {
    "sh": {
      "@id": "http://www.w3.org/ns/shacl#",
      "@prefix": true
    },
    "rdf": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "@prefix": true
    },
    "xsd": {
      "@id": "http://www.w3.org/2001/XMLSchema#",
      "@prefix": true
    },
    "rv": {
      "@id": "https://rezics.com/vocab/",
      "@prefix": true
    },
    "rdf:type": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
      "@type": "@id"
    },
    "rv:effectCapability": {
      "@id": "https://rezics.com/vocab/effectCapability"
    },
    "rv:effectDigest": {
      "@id": "https://rezics.com/vocab/effectDigest"
    },
    "rv:effectTarget": {
      "@id": "https://rezics.com/vocab/effectTarget",
      "@type": "@id"
    },
    "rv:executedAt": {
      "@id": "https://rezics.com/vocab/executedAt",
      "@type": "xsd:dateTime"
    },
    "rv:expectedTargetState": {
      "@id": "https://rezics.com/vocab/expectedTargetState"
    },
    "rv:governingBody": {
      "@id": "https://rezics.com/vocab/governingBody",
      "@type": "@id"
    },
    "rv:operation": {
      "@id": "https://rezics.com/vocab/operation",
      "@type": "@id"
    },
    "rv:pollResolution": {
      "@id": "https://rezics.com/vocab/pollResolution",
      "@type": "@id"
    },
    "rv:predecessor": {
      "@id": "https://rezics.com/vocab/predecessor",
      "@type": "@id"
    },
    "rv:proposal": {
      "@id": "https://rezics.com/vocab/proposal",
      "@type": "@id"
    },
    "rv:proposalExecution": {
      "@id": "https://rezics.com/vocab/proposalExecution",
      "@type": "@id"
    },
    "rv:proposalHead": {
      "@id": "https://rezics.com/vocab/proposalHead",
      "@type": "@id"
    },
    "rv:proposalRevision": {
      "@id": "https://rezics.com/vocab/proposalRevision",
      "@type": "@id"
    },
    "rv:proposalState": {
      "@id": "https://rezics.com/vocab/proposalState",
      "@type": "@id"
    },
    "rv:resultingTargetRevision": {
      "@id": "https://rezics.com/vocab/resultingTargetRevision",
      "@type": "@id"
    },
    "rv:revisedAt": {
      "@id": "https://rezics.com/vocab/revisedAt",
      "@type": "xsd:dateTime"
    },
    "rv:ruleRevision": {
      "@id": "https://rezics.com/vocab/ruleRevision",
      "@type": "@id"
    }
  }
}
