    },
    "rv:validUntil": {
      "@id": "https://rezics.com/vocab/validUntil",
      "@type": "xsd:dateTime"
    },
    "rv:valuePrecision": {
      "@id": "https://rezics.com/vocab/valuePrecision",
      "@type": "@id"
    },
    "rv:valueQualifier": {
