{
  "@context": {
    "sh": {
      "@id": "http://www.w3.org/ns/shacl#",
      "@prefix": true
    },
    "rdf": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "@prefix": true
    },
    "xsd": {
      "@id": "http://www.w3.org/2001/XMLSchema#",
      "@prefix": true
    },
    "schema": {
      "@id": "https://schema.org/",
      "@prefix": true
    },
    "rv": {
      "@id": "https://rezics.com/vocab/",
      "@prefix": true
    },
    "rdf:type": {
      "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
      "@type": "@id"
    },
    "rv:creditedName": {
      "@id": "https://rezics.com/vocab/creditedName"
    },
    "rv:occurrence": {
      "@id": "https://rezics.com/vocab/occurrence",
      "@type": "@id"
    },
    "rv:participant": {
      "@id": "https://rezics.com/vocab/participant",
      "@type": "@id"
    },
    "rv:participationFormat": {
      "@id": "https://rezics.com/vocab/participationFormat",
      "@type": "@id"
    },
    "rv:role": {
      "@id": "https://rezics.com/vocab/role",
      "@type": "@id"
    },
    "schema:position": {
      "@id": "https://schema.org/position",
      "@type": "xsd:integer"
    }
  }
}
