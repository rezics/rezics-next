# One terminal decision per correction proposal revision; approval and its one application commit together.
# The independence proof is an opaque Access reference. The application preserves effective protection.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/correction-decision-v1/decision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:CorrectionDecision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:proposalRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:CorrectionProposal ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:candidateDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path rv:outcome ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Accepted rv:Rejected ) ] ;
    sh:property [ sh:path rv:ruleRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( <urn:rezics:protection-rule:independent-human-review-v1> ) ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 0 ] ;
    sh:property [ sh:path rv:evidence ; sh:maxCount 32 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:agent ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:decisionIntent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 16000 ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/correction-decision-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/correction-decision-v1> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:or (
        [ sh:property [ sh:path rv:outcome ; sh:hasValue rv:Accepted ] ;
          sh:property [ sh:path rv:independenceProof ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ]
        [ sh:property [ sh:path rv:outcome ; sh:hasValue rv:Rejected ] ;
          sh:property [ sh:path rv:independenceProof ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ]
    ) .

<https://rezics.com/definition/correction-decision-v1/application-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:CorrectionApplication rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:proposalRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:CorrectionProposal ] ;
    sh:property [ sh:path rv:decision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:CorrectionDecision ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:baseRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RevisionAnchor ] ;
    sh:property [ sh:path rv:workRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RevisionAnchor ] ;
    sh:property [ sh:path rv:controlRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:EditorialControlRevision ] ;
    sh:property [ sh:path rv:protectionRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/correction-decision-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/correction-decision-v1> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .
