# One Account-principal standing slot for one MainVersion and Global question, valued 1-5.
# The slot is opaque; principal identity belongs to Access, not public RDF.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/global-rating-standing-observation-v1/context-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:GlobalRatingContext ] ;
    sh:property [ sh:path rv:contextState ; sh:hasValue rv:Active ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:realm ; sh:maxCount 0 ] ;
    sh:property [ sh:path rv:ratingPopulationOwner ; sh:hasValue <https://rezics.com/id/00000000-0000-8000-8000-676c6f62616c> ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:targetGrain ; sh:hasValue rv:MainVersion ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:ratingScaleMin ; sh:hasValue 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path rv:ratingScaleMax ; sh:hasValue 5 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path rv:ratingCadence ; sh:hasValue <https://rezics.com/definition/rating-standing-v1> ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:ratingPopulationPolicy ; sh:hasValue <https://rezics.com/definition/rating-global-account-principal-population-v1> ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:ratingAggregationPolicy ; sh:hasValue <https://rezics.com/definition/rating-latest-per-rater-mean-v1> ; sh:maxCount 1 ] .

<https://rezics.com/definition/global-rating-standing-observation-v1/work-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue schema:CreativeWork ] ;
    sh:property [ sh:path rv:mainVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:MainVersion ] .

<https://rezics.com/definition/global-rating-standing-observation-v1/main-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:MainVersion ] ;
    sh:property [ sh:path rv:work ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] .

<https://rezics.com/definition/global-rating-standing-observation-v1/observation-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:GlobalRatingObservation ] ;
    sh:property [ sh:path rv:ratingContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:GlobalRatingContext ] ;
    sh:property [ sh:path rv:targetMainVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:MainVersion ] ;
    sh:property [ sh:path rv:ratingSlot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:observationHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:GlobalRatingObservationRevision ] .

<https://rezics.com/definition/global-rating-standing-observation-v1/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:GlobalRatingObservationRevision ] ;
    sh:property [ sh:path rv:observation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:GlobalRatingObservation ] ;
    sh:property [ sh:path rv:ratingAvailability ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Available rv:Withdrawn ) ] ;
    sh:property [ sh:path rv:evaluatedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:submittedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:originalSubmissionAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:revisedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:GlobalRatingObservationRevision ] ;
    sh:or (
        [ sh:property [ sh:path rv:ratingAvailability ; sh:hasValue rv:Available ] ;
          sh:property [ sh:path rv:ratingValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 5 ] ]
        [ sh:property [ sh:path rv:ratingAvailability ; sh:hasValue rv:Withdrawn ] ;
          sh:property [ sh:path rv:ratingValue ; sh:maxCount 0 ] ]
    ) .

# Authored SHACL constraints for rating evidence.
