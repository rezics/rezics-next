# A named-event topic binds to one Event occurrence; the Event keeps the only date authority.
# The binding node is deterministic per topic, so distinct topics may share one Event.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/event-topic-binding-v1/event-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:Event ] .

<https://rezics.com/definition/event-topic-binding-v1/binding-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:EventTopicBinding ] ;
    sh:property [ sh:path rv:topic ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:bindingHead ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class rv:EventTopicBindingRevision ] .

<https://rezics.com/definition/event-topic-binding-v1/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:EventTopicBindingRevision ] ;
    sh:property [ sh:path rv:binding ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class rv:EventTopicBinding ] ;
    sh:property [ sh:path rv:bindingState ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( rv:AcceptedBinding rv:WithdrawnBinding ) ] ;
    sh:property [ sh:path rv:revisedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ;
        sh:class rv:EventTopicBindingRevision ] ;
    sh:or (
        [ sh:property [ sh:path rv:bindingState ; sh:hasValue rv:AcceptedBinding ] ;
          sh:property [ sh:path rv:boundEvent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Event ] ]
        [ sh:property [ sh:path rv:bindingState ; sh:hasValue rv:WithdrawnBinding ] ;
          sh:property [ sh:path rv:boundEvent ; sh:maxCount 0 ] ]
    ) .
