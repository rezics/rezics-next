# One Composed profile admits independently maintained Works at every creative level and medium.
# A part qualifier holds its local display label and inclusion; order remains the Structure order.
# The composing Work owns the Main Version component. Membership never writes schema:isPartOf.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/structure-work-composition-v1/structure-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:Structure ] ;
    sh:property [ sh:path rv:structureOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:structureProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:WorkComposition ) ] ;
    sh:property [ sh:path rv:structureHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureRevision ] ;
    sh:property [ sh:path rv:selectedGeneration ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureGeneration ] .

<https://rezics.com/definition/structure-work-composition-v1/placement-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:OccurrencePlacement ] ;
    sh:property [ sh:path rv:occurrence ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:ListItem ] ;
    sh:property [ sh:path rv:generation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureGeneration ] ;
    sh:property [ sh:path rv:orderSegment ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:OrderSegment ] ;
    sh:property [ sh:path rv:orderKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z0-9]+(-[a-z0-9]+)*$" ; sh:maxLength 32 ] ;
    sh:property [ sh:path rv:occurrenceRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:GroupRole rv:PartRole ) ] ;
    sh:property [ sh:path rv:occurrenceLabel ; sh:datatype rdf:langString ; sh:uniqueLang true ; sh:maxLength 500 ] ;
    sh:property [ sh:path rv:qualifier ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:sourceKey ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 200 ] ;
    sh:property [ sh:path schema:item ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:selectionMode ; sh:maxCount 1 ; sh:in ( rv:FollowContext rv:FixedRealm rv:FixedRevision ) ] ;
    sh:property [ sh:path rv:selectionRealm ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:pinnedRevision ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:or (
        [ sh:property [ sh:path schema:item ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:selectionMode ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:selectionRealm ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:pinnedRevision ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:item ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path rv:selectionMode ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:selectionRealm ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:pinnedRevision ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:item ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path rv:selectionMode ; sh:hasValue rv:FollowContext ] ;
          sh:property [ sh:path rv:selectionRealm ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:pinnedRevision ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:item ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path rv:selectionMode ; sh:hasValue rv:FixedRealm ] ;
          sh:property [ sh:path rv:selectionRealm ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Realm ] ;
          sh:property [ sh:path rv:pinnedRevision ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:item ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path rv:selectionMode ; sh:hasValue rv:FixedRevision ] ;
          sh:property [ sh:path rv:selectionRealm ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:pinnedRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ]
    ) .

<https://rezics.com/definition/structure-work-composition-v1/removed-placement-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:RemovedPlacement ] ;
    sh:property [ sh:path rv:occurrence ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:ListItem ] ;
    sh:property [ sh:path rv:generation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureGeneration ] ;
    sh:property [ sh:path rv:orderSegment ; sh:maxCount 0 ] ;
    sh:property [ sh:path rv:orderKey ; sh:maxCount 0 ] ;
    sh:property [ sh:path rv:occurrenceRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:GroupRole rv:PartRole ) ] ;
    sh:property [ sh:path rv:lastParent ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:removedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureRevision ] ;
    sh:property [ sh:path schema:item ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:sourceKey ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 200 ] .

<https://rezics.com/definition/structure-work-composition-v1/part-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:WorkPart ] ;
    sh:property [ sh:path rv:generation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureGeneration ] ;
    sh:property [ sh:path rv:displayLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 500 ] ;
    sh:property [ sh:path rv:partInclusion ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:RequiredPart rv:OptionalPart rv:ExtraPart ) ] .
