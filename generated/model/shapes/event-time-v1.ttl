# One identified Event occurrence with separate actual and planned time slots.
# Each revision keeps precision, calendar, reference, qualifier and source lexical;
# normalized interval keys are derived outside the graph under a conversion profile.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/event-time-v1/event-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:Event ] ;
    sh:property [ sh:path rv:eventTime ; sh:maxCount 2 ; sh:class rv:EventTime ] .

<https://rezics.com/definition/event-time-v1/slot-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:EventTime ] ;
    sh:property [ sh:path rv:event ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class rv:Event ] ;
    sh:property [ sh:path rv:timeStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( rv:ActualTime rv:PlannedTime ) ] ;
    sh:property [ sh:path rv:eventTimeHead ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class rv:EventTimeRevision ] .

<https://rezics.com/definition/event-time-v1/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:EventTimeRevision ] ;
    sh:property [ sh:path rv:eventTime ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class rv:EventTime ] ;
    sh:property [ sh:path rv:timeAvailability ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( rv:Available rv:Withdrawn ) ] ;
    sh:property [ sh:path rv:recordedAt ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ;
        sh:class rv:EventTimeRevision ] ;
    sh:property [ sh:path rv:timeEvidence ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:or (
        [ sh:property [ sh:path rv:timeAvailability ; sh:hasValue rv:Withdrawn ] ;
          sh:property [ sh:path rv:temporalKind ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:eventStart ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:eventEnd ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:timeAvailability ; sh:hasValue rv:Available ] ;
          sh:property [ sh:path rv:temporalKind ; sh:hasValue rv:InstantTime ] ;
          sh:property [ sh:path rv:eventStart ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:class rv:EventTimePoint ] ;
          sh:property [ sh:path rv:eventEnd ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:timeAvailability ; sh:hasValue rv:Available ] ;
          sh:property [ sh:path rv:temporalKind ; sh:hasValue rv:IntervalTime ] ;
          sh:property [ sh:path rv:eventStart ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:class rv:EventTimePoint ] ;
          sh:property [ sh:path rv:eventEnd ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:class rv:EventTimePoint ] ]
    ) .

<https://rezics.com/definition/event-time-v1/point-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:EventTimePoint ] ;
    sh:property [ sh:path rv:pointState ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( rv:KnownPoint rv:UnknownPoint rv:OpenPoint ) ] ;
    sh:property [ sh:path rv:timeCalendar ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:sourceLexical ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 200 ] ;
    sh:property [ sh:path rv:timePrecision ; sh:maxCount 1 ;
        sh:in ( rv:YearPrecision rv:MonthPrecision rv:DayPrecision rv:MinutePrecision rv:SecondPrecision ) ] ;
    sh:property [ sh:path rv:timeReference ; sh:maxCount 1 ;
        sh:in ( rv:FloatingCivilTime rv:OffsetTime rv:ZonedTime ) ] ;
    sh:property [ sh:path rv:timeZone ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:minLength 1 ; sh:maxLength 64 ] ;
    sh:property [ sh:path rv:utcOffset ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^[+-](0[0-9]|1[0-4]):[0-5][0-9]$" ] ;
    sh:property [ sh:path rv:timeQualifier ; sh:maxCount 1 ;
        sh:in ( rv:ApproximateTime rv:UncertainTime ) ] ;
    sh:property [ sh:path rv:yearValue ; sh:maxCount 1 ;
        sh:datatype xsd:integer ] ;
    sh:property [ sh:path rv:monthValue ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 12 ] ;
    sh:property [ sh:path rv:dayValue ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 31 ] ;
    sh:property [ sh:path rv:hourValue ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 23 ] ;
    sh:property [ sh:path rv:minuteValue ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 59 ] ;
    sh:property [ sh:path rv:secondValue ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 60 ] ;
    sh:or (
        [ sh:property [ sh:path rv:pointState ; sh:hasValue rv:UnknownPoint ] ;
          sh:property [ sh:path rv:timePrecision ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:yearValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:monthValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:dayValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:hourValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:minuteValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:secondValue ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:pointState ; sh:hasValue rv:OpenPoint ] ;
          sh:property [ sh:path rv:timePrecision ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:yearValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:monthValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:dayValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:hourValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:minuteValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:secondValue ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:pointState ; sh:hasValue rv:KnownPoint ] ;
          sh:property [ sh:path rv:timePrecision ; sh:hasValue rv:YearPrecision ] ;
          sh:property [ sh:path rv:yearValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ] ;
          sh:property [ sh:path rv:monthValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:dayValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:hourValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:minuteValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:secondValue ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:pointState ; sh:hasValue rv:KnownPoint ] ;
          sh:property [ sh:path rv:timePrecision ; sh:hasValue rv:MonthPrecision ] ;
          sh:property [ sh:path rv:yearValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ] ;
          sh:property [ sh:path rv:monthValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 12 ] ;
          sh:property [ sh:path rv:dayValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:hourValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:minuteValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:secondValue ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:pointState ; sh:hasValue rv:KnownPoint ] ;
          sh:property [ sh:path rv:timePrecision ; sh:hasValue rv:DayPrecision ] ;
          sh:property [ sh:path rv:yearValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ] ;
          sh:property [ sh:path rv:monthValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 12 ] ;
          sh:property [ sh:path rv:dayValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 31 ] ;
          sh:property [ sh:path rv:hourValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:minuteValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:secondValue ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:pointState ; sh:hasValue rv:KnownPoint ] ;
          sh:property [ sh:path rv:timePrecision ; sh:hasValue rv:MinutePrecision ] ;
          sh:property [ sh:path rv:yearValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ] ;
          sh:property [ sh:path rv:monthValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 12 ] ;
          sh:property [ sh:path rv:dayValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 31 ] ;
          sh:property [ sh:path rv:hourValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 23 ] ;
          sh:property [ sh:path rv:minuteValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 59 ] ;
          sh:property [ sh:path rv:secondValue ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:pointState ; sh:hasValue rv:KnownPoint ] ;
          sh:property [ sh:path rv:timePrecision ; sh:hasValue rv:SecondPrecision ] ;
          sh:property [ sh:path rv:yearValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ] ;
          sh:property [ sh:path rv:monthValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 12 ] ;
          sh:property [ sh:path rv:dayValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 31 ] ;
          sh:property [ sh:path rv:hourValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 23 ] ;
          sh:property [ sh:path rv:minuteValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 59 ] ;
          sh:property [ sh:path rv:secondValue ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 60 ] ]
        [ sh:property [ sh:path rv:pointState ; sh:hasValue rv:KnownPoint ] ;
          sh:property [ sh:path rv:timePrecision ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:in ( rv:YearPrecision rv:MonthPrecision rv:DayPrecision rv:MinutePrecision rv:SecondPrecision ) ] ;
          sh:property [ sh:path rv:yearValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:monthValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:dayValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:hourValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:minuteValue ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:secondValue ; sh:maxCount 0 ] ]
    ) .
