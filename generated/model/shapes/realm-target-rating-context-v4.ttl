# An exact-target question with optional subject types and projection frame dimensions, owned by a Realm or Global.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/realm-target-rating-context-v4/realm-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rv:ratingContext ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:or (
        [ sh:property [ sh:path rdf:type ; sh:hasValue rv:Realm ] ;
          sh:property [ sh:path rv:realmState ; sh:maxCount 1 ; sh:hasValue rv:Active ] ]
        [ sh:property [ sh:path rdf:type ; sh:hasValue rv:GlobalRatingPopulation ] ]
    ) .

<https://rezics.com/definition/realm-target-rating-context-v4/context-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:TargetRatingContext ] ;
    sh:property [ sh:path rv:contextState ; sh:hasValue rv:Active ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:realm ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:question ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype rdf:langString ; sh:minLength 3 ;
                  sh:maxLength 120 ] ;
    sh:property [ sh:path rv:targetGrain ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Release rv:Realization rv:Occurrence rv:Resource rv:Projection ) ] ;
    sh:property [ sh:path rv:ratingScaleMin ; sh:hasValue 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ] ;
    sh:property [ sh:path rv:ratingScaleMax ; sh:hasValue 10 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ] ;
    sh:property [ sh:path rv:ratingCadence ;
                  sh:hasValue <https://rezics.com/definition/rating-standing-v1> ;
                  sh:maxCount 1 ] ;
    sh:property [ sh:path rv:ratingPopulationPolicy ;
                  sh:hasValue <https://rezics.com/definition/rating-account-principal-population-v1> ;
                  sh:maxCount 1 ] ;
    sh:property [ sh:path rv:ratingAggregationPolicy ;
                  sh:hasValue <https://rezics.com/definition/rating-latest-per-rater-mean-v1> ;
                  sh:maxCount 1 ] ;
    sh:property [ sh:path rv:displayThreshold ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 1000 ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:AcceptedTargetRatingContext ] ;
    sh:property [ sh:path rv:acceptedSubjectType ; sh:maxCount 32 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:acceptedFrameDimension ; sh:maxCount 8 ; sh:datatype xsd:string ; sh:in ( "work" "realization" "release" "position" "event" "continuity" ) ] .
