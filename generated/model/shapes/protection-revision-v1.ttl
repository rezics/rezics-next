# Append-only modification protection of one native Work English title slot in its Global context.
# Protection is not an evidence-quality verdict. Sealed modes and inherited root scopes are not admitted.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/protection-revision-v1/target-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue schema:CreativeWork ] ;
    sh:property [ sh:path rv:head ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RevisionAnchor ] ;
    sh:property [ sh:path rv:protectionHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:ProtectionRevision ] .

<https://rezics.com/definition/protection-revision-v1/protection-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:ProtectionRevision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:protectedSlot ; sh:maxCount 1 ; sh:hasValue "title:en" ] ;
    sh:property [ sh:path rv:adoptionContext ; sh:maxCount 1 ; sh:hasValue rv:GlobalNative ] ;
    sh:property [ sh:path rv:protectionAction ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Tighten rv:Confirm rv:Relax ) ] ;
    sh:property [ sh:path rv:protectionMode ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Open rv:ReviewRequired ) ] ;
    sh:property [ sh:path rv:protectionEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:ProtectionRevision ] ;
    sh:property [ sh:path rv:ruleRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( <urn:rezics:protection-rule:independent-human-review-v1> ) ] ;
    sh:property [ sh:path rv:workRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RevisionAnchor ] ;
    sh:property [ sh:path rv:controlRevision ; sh:maxCount 1 ; sh:class rv:EditorialControlRevision ] ;
    sh:property [ sh:path rv:evidence ; sh:maxCount 32 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:protectionIntent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 16000 ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/protection-revision-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/protection-revision-v1> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:or (
        [ sh:property [ sh:path rv:protectionAction ; sh:hasValue rv:Tighten ] ;
          sh:property [ sh:path rv:protectionMode ; sh:hasValue rv:ReviewRequired ] ]
        [ sh:property [ sh:path rv:protectionAction ; sh:hasValue rv:Confirm ] ;
          sh:property [ sh:path rv:protectionMode ; sh:hasValue rv:ReviewRequired ] ;
          sh:property [ sh:path rv:controlRevision ; sh:minCount 1 ; sh:class rv:EditorialControlRevision ] ]
        [ sh:property [ sh:path rv:protectionAction ; sh:hasValue rv:Relax ] ;
          sh:property [ sh:path rv:protectionMode ; sh:hasValue rv:Open ] ;
          sh:property [ sh:path rv:predecessor ; sh:minCount 1 ; sh:class rv:ProtectionRevision ] ]
    ) .
