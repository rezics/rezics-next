# A Skill package or Prompt is a Work typed with exactly one Hub kind and a MainVersion.
# Exact revisions stay in Content; publication pins them through content-publication-v1.
# The kind never grants execution, tool access or network authority.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/hub-item-v1/skill-package-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( schema:CreativeWork rv:SkillPackage ) ] ;
    sh:property [ sh:path rv:mainVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class rv:MainVersion ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/hub-item-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/hub-item-v1> ] .

<https://rezics.com/definition/hub-item-v1/prompt-template-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( schema:CreativeWork rv:PromptTemplate ) ] ;
    sh:property [ sh:path rv:mainVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class rv:MainVersion ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/hub-item-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/hub-item-v1> ] .
