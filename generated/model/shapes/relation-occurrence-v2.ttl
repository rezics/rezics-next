# A relation participation may record the name credited in that occurrence, as one language-tagged literal.
# The credited name belongs to the participation only; it never renames the participant.
# A v1 participation has no format marker, no credited name and stays valid under its own shape.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/relation-occurrence-v2/participation-shape>
    a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:RelationParticipation ] ;
    sh:property [ sh:path rv:occurrence ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RelationOccurrence ] ;
    sh:property [ sh:path rv:role ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:participant ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:position ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1023 ] ;
    sh:property [ sh:path rv:participationFormat ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue rv:CreditedNameV2 ] ;
    sh:property [ sh:path rv:creditedName ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:maxLength 200 ] .
