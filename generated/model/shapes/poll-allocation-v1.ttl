# Immutable allocation plans split one root entitlement into explicit leaf seats.
# Allocated plus residual units equal the root units; the residual leaf stays with the
# root holder. One activation per poll and root, only while the poll is a draft, so a
# root and its leaves never both count. Leaves keep the root source entitlement.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/poll-allocation-v1/plan-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:AllocationPlan ] ;
    sh:property [ sh:path rv:poll ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Poll ] ;
    sh:property [ sh:path rv:rootEntitlement ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:SourceEntitlement ] ;
    sh:property [ sh:path rv:leafCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 1024 ] ;
    sh:property [ sh:path rv:allocatedUnits ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000 ] ;
    sh:property [ sh:path rv:residualUnits ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000 ] ;
    sh:property [ sh:path rv:planDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^urn:rezics:operation:[0-9a-f]{64}$" ] ;
    sh:property [ sh:path rv:preparedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

<https://rezics.com/definition/poll-allocation-v1/leaf-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:AllocationLeaf ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:VotingSeat ] ;
    sh:property [ sh:path rv:allocationPlan ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:AllocationPlan ] ;
    sh:property [ sh:path rv:sourceEntitlement ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:SourceEntitlement ] ;
    sh:property [ sh:path rv:holder ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:seatClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:PersonSeat rv:OrganizationSeat rv:CollectiveMemberSeat ) ] ;
    sh:property [ sh:path rv:leafKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:AllocatedLeaf rv:ResidualLeaf ) ] ;
    sh:property [ sh:path rv:countingSlot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:leafUnits ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 1000000 ] .

<https://rezics.com/definition/poll-allocation-v1/activation-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:AllocationActivation ] ;
    sh:property [ sh:path rv:poll ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Poll ] ;
    sh:property [ sh:path rv:allocationPlan ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:AllocationPlan ] ;
    sh:property [ sh:path rv:rootEntitlement ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:SourceEntitlement ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^urn:rezics:operation:[0-9a-f]{64}$" ] ;
    sh:property [ sh:path rv:activatedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .
