# The executable positive body is sealed in the immutable manifest and checked by the semantic owner.
# The rule head and derived generation switch atomically; dependent targets are never rewritten on revision.
# Output predicates are admitted only in the derived projection namespace, outside owner authority.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/semantic-rule-v1/slot-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ContextRule ] ;
    sh:property [ sh:path rv:context ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:SemanticContext ] ;
    sh:property [ sh:path rv:realm ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Realm ] ;
    sh:property [ sh:path rv:outputPredicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:ruleHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:FiniteRuleRevision ] ;
    sh:property [ sh:path rv:derivedGenerationHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

<https://rezics.com/definition/semantic-rule-v1/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:FiniteRuleRevision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:ContextRule ] ;
    sh:property [ sh:path rv:context ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:SemanticContext ] ;
    sh:property [ sh:path rv:contextSemanticRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:ContextSemanticRevision ] ;
    sh:property [ sh:path rv:realm ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Realm ] ;
    sh:property [ sh:path rv:outputPredicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:derivedGeneration ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelGeneration ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:ModelGeneration ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:FiniteRuleRevision ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/semantic-rule-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/semantic-rule-v1> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .

<https://rezics.com/definition/semantic-rule-v1/dependency-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:RuleDependency ] ;
    sh:property [ sh:path rv:ruleSlot ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:ContextRule ] ;
    sh:property [ sh:path rv:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:dependencyGeneration ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

<https://rezics.com/definition/semantic-rule-v1/dependency-page-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:RuleDependencyPage rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:ContextRule ] ;
    sh:property [ sh:path rv:derivedGeneration ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/semantic-rule-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/semantic-rule-v1> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .
