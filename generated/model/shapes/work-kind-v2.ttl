# Native catalogue Works retain one metadata Work and MainVersion identity.
# VideoGame joins the reviewed creation types in this revision.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/work-kind-v2/work-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 4 ; sh:in ( schema:CreativeWork schema:Book schema:BookSeries schema:DigitalDocument schema:Recipe schema:SoftwareApplication schema:SoftwareSourceCode schema:VideoGame rv:ModPackage rv:SkillPackage rv:PromptTemplate schema:Movie schema:TVSeries schema:VideoObject schema:AudioObject schema:MusicRecording schema:MusicAlbum ) ; sh:hasValue schema:CreativeWork ] ;
    sh:property [ sh:path rv:mainVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class rv:MainVersion ] .
