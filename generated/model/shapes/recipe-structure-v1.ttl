# A Recipe variant is a Structure: stages and groups, ingredient lines, steps and equipment are occurrences.
# Quantities are exact non-negative rationals with their source lexical form; ambiguous units stay unresolved text.
# Measures state their unit, basis, coverage and provenance; per-serving and whole-recipe values differ.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/recipe-structure-v1/ingredient-line-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:IngredientLine ] ;
    sh:property [ sh:path rv:originalText ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 1 ; sh:maxLength 1000 ] ;
    sh:property [ sh:path rv:amountLexical ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 100 ] ;
    sh:property [ sh:path rv:amountNumerator ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path rv:amountDenominator ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path rv:amountUpperNumerator ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path rv:amountUpperDenominator ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path rv:unit ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:unitText ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 100 ] ;
    sh:property [ sh:path rv:preparation ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 1 ; sh:maxLength 500 ] ;
    sh:property [ sh:path rv:optionality ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Required rv:Optional ) ] ;
    sh:property [ sh:path rv:scaling ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:LinearScaling rv:NonLinearScaling rv:NotScalable ) ] ;
    sh:property [ sh:path rv:substituteFor ; sh:class rv:StructureOccurrence ] ;
    sh:property [ sh:path rv:parseStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Parsed rv:PartiallyParsed rv:Unparsed ) ] ;
    sh:property [ sh:path rv:residual ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:or (
        [ sh:property [ sh:path rv:amountNumerator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ;
          sh:property [ sh:path rv:amountDenominator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 1000000000000 ] ;
          sh:property [ sh:path rv:amountUpperNumerator ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:amountUpperDenominator ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:amountNumerator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ;
          sh:property [ sh:path rv:amountDenominator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 1000000000000 ] ;
          sh:property [ sh:path rv:amountUpperNumerator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ;
          sh:property [ sh:path rv:amountUpperDenominator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 1000000000000 ] ]
        [ sh:property [ sh:path rv:amountNumerator ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:amountDenominator ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:amountUpperNumerator ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:amountUpperDenominator ; sh:maxCount 0 ] ]
    ) .

<https://rezics.com/definition/recipe-structure-v1/step-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:RecipeStep ] ;
    sh:property [ sh:path rv:instructionText ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 1 ; sh:maxLength 4000 ] ;
    sh:property [ sh:path rv:usesIngredient ; sh:class rv:StructureOccurrence ] ;
    sh:property [ sh:path rv:media ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:scaling ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:LinearScaling rv:NonLinearScaling rv:NotScalable ) ] .

<https://rezics.com/definition/recipe-structure-v1/measure-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:RecipeMeasure ] ;
    sh:property [ sh:path rv:generation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureGeneration ] ;
    sh:property [ sh:path rv:measureKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Yield rv:Servings rv:PreparationDuration rv:CookingDuration rv:TotalDuration rv:Nutrient ) ] ;
    sh:property [ sh:path rv:nutrient ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:valueNumerator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ;
    sh:property [ sh:path rv:valueDenominator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 1000000000000 ] ;
    sh:property [ sh:path rv:valueLexical ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 100 ] ;
    sh:property [ sh:path rv:unit ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:unitText ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 100 ] ;
    sh:property [ sh:path rv:basis ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:PerServing rv:WholeRecipe ) ] ;
    sh:property [ sh:path rv:coverage ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Complete rv:Partial rv:Unknown ) ] ;
    sh:property [ sh:path rv:provenance ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Declared rv:SourceStated rv:Computed ) ] ;
    sh:property [ sh:path rv:evidence ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:or (
        [ sh:property [ sh:path rv:measureKind ; sh:hasValue rv:Nutrient ] ;
          sh:property [ sh:path rv:nutrient ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path rv:provenance ; sh:hasValue rv:Computed ] ;
          sh:property [ sh:path rv:evidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ]
        [ sh:property [ sh:path rv:measureKind ; sh:hasValue rv:Nutrient ] ;
          sh:property [ sh:path rv:nutrient ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path rv:provenance ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Declared rv:SourceStated ) ] ]
        [ sh:property [ sh:path rv:measureKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Yield rv:Servings rv:PreparationDuration rv:CookingDuration rv:TotalDuration ) ] ;
          sh:property [ sh:path rv:nutrient ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:provenance ; sh:hasValue rv:Computed ] ;
          sh:property [ sh:path rv:evidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ]
        [ sh:property [ sh:path rv:measureKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Yield rv:Servings rv:PreparationDuration rv:CookingDuration rv:TotalDuration ) ] ;
          sh:property [ sh:path rv:nutrient ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:provenance ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Declared rv:SourceStated ) ] ]
    ) .
