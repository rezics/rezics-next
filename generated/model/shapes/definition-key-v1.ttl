# A lexicon-owned stable registry key identifies one semantic definition independently of its labels.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/definition-key-v1/key-shape>
    a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue rv:DefinitionKey ] ;
    sh:property [ sh:path rv:keyDefinition ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:SemanticDefinition ] ;
    sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z][a-z0-9-]{0,63}$" ] .
