# Standard Recipe facts at occurrence/revision grain. Native CAS and membership checks remain transactional.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/recipe-facts-v1/ingredient-shape> a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rv:definitionProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/recipe-facts-v1> ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue schema:HowToSupply ] ;
    sh:property [ sh:path rv:generation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureGeneration ] ;
    sh:property [ sh:path schema:name ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 0 ; sh:maxLength 1000 ] ;
    sh:property [ sh:path schema:description ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 1 ; sh:maxLength 500 ] ;
    sh:property [ sh:path schema:requiredQuantity ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:QuantitativeValue ] ;
    sh:property [ sh:path schema:valueRequired ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:Entity ] ;
    sh:property [ sh:path rv:scaling ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:LinearScaling rv:NonLinearScaling rv:NotScalable ) ] ;
    sh:property [ sh:path rv:substituteFor ; sh:maxCount 16 ; sh:class schema:ListItem ] .

<https://rezics.com/definition/recipe-facts-v1/step-shape> a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rv:definitionProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/recipe-facts-v1> ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue schema:HowToStep ] ;
    sh:property [ sh:path rv:generation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureGeneration ] ;
    sh:property [ sh:path schema:text ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 1 ; sh:maxLength 4000 ] ;
    sh:property [ sh:path schema:mentions ; sh:maxCount 64 ; sh:class schema:ListItem ] ;
    sh:property [ sh:path schema:associatedMedia ; sh:maxCount 16 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:scaling ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:LinearScaling rv:NonLinearScaling rv:NotScalable ) ] .

<https://rezics.com/definition/recipe-facts-v1/extraction-shape> a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rv:definitionProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/recipe-facts-v1> ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue prov:Entity ] ;
    sh:property [ sh:path schema:text ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 0 ; sh:maxLength 1000 ] ;
    sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 0 ; sh:maxLength 8192 ] .

<https://rezics.com/definition/recipe-facts-v1/quantity-shape> a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rv:definitionProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/recipe-facts-v1> ] ;
    sh:property [ sh:path schema:value ; sh:maxCount 1 ; sh:nodeKind sh:IRIOrLiteral ] ;
    sh:property [ sh:path schema:minValue ; sh:maxCount 1 ; sh:nodeKind sh:IRIOrLiteral ] ;
    sh:property [ sh:path schema:maxValue ; sh:maxCount 1 ; sh:nodeKind sh:IRIOrLiteral ] ;
    sh:property [ sh:path rdf:type ; sh:maxCount 2 ; sh:hasValue schema:QuantitativeValue ; sh:in ( schema:QuantitativeValue schema:PropertyValue schema:Duration ) ] ;
    sh:property [ sh:path schema:unitCode ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:unitText ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 100 ] ;
    sh:property [ sh:path schema:propertyID ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:basis ; sh:maxCount 1 ; sh:in ( rv:PerServing rv:WholeRecipe ) ] ;
    sh:property [ sh:path rv:coverage ; sh:maxCount 1 ; sh:in ( rv:Complete rv:Partial rv:Unknown ) ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:class prov:Activity ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:description ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 100 ] ;
    sh:or (
        [ sh:property [ sh:path schema:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ; sh:property [ sh:path schema:minValue ; sh:maxCount 0 ] ; sh:property [ sh:path schema:maxValue ; sh:maxCount 0 ] ; sh:property [ sh:path rv:basis ; sh:maxCount 0 ] ; sh:property [ sh:path rv:coverage ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype owl:rational ; sh:pattern "^(0|1000000000000|[1-9][0-9]{0,11})/(1000000000000|[1-9][0-9]{0,11})$" ] ; sh:property [ sh:path schema:minValue ; sh:maxCount 0 ] ; sh:property [ sh:path schema:maxValue ; sh:maxCount 0 ] ; sh:property [ sh:path rv:basis ; sh:maxCount 0 ] ; sh:property [ sh:path rv:coverage ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:value ; sh:maxCount 0 ] ; sh:property [ sh:path schema:minValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ; sh:property [ sh:path schema:maxValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ; sh:property [ sh:path rv:basis ; sh:maxCount 0 ] ; sh:property [ sh:path rv:coverage ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:value ; sh:maxCount 0 ] ; sh:property [ sh:path schema:minValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ; sh:property [ sh:path schema:maxValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype owl:rational ; sh:pattern "^(0|1000000000000|[1-9][0-9]{0,11})/(1000000000000|[1-9][0-9]{0,11})$" ] ; sh:property [ sh:path rv:basis ; sh:maxCount 0 ] ; sh:property [ sh:path rv:coverage ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:value ; sh:maxCount 0 ] ; sh:property [ sh:path schema:minValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype owl:rational ; sh:pattern "^(0|1000000000000|[1-9][0-9]{0,11})/(1000000000000|[1-9][0-9]{0,11})$" ] ; sh:property [ sh:path schema:maxValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ; sh:property [ sh:path rv:basis ; sh:maxCount 0 ] ; sh:property [ sh:path rv:coverage ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:value ; sh:maxCount 0 ] ; sh:property [ sh:path schema:minValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype owl:rational ; sh:pattern "^(0|1000000000000|[1-9][0-9]{0,11})/(1000000000000|[1-9][0-9]{0,11})$" ] ; sh:property [ sh:path schema:maxValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype owl:rational ; sh:pattern "^(0|1000000000000|[1-9][0-9]{0,11})/(1000000000000|[1-9][0-9]{0,11})$" ] ; sh:property [ sh:path rv:basis ; sh:maxCount 0 ] ; sh:property [ sh:path rv:coverage ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:value ; sh:maxCount 0 ] ; sh:property [ sh:path schema:minValue ; sh:maxCount 0 ] ; sh:property [ sh:path schema:maxValue ; sh:maxCount 0 ] ; sh:property [ sh:path rv:basis ; sh:maxCount 0 ] ; sh:property [ sh:path rv:coverage ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path schema:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ; sh:property [ sh:path schema:minValue ; sh:maxCount 0 ] ; sh:property [ sh:path schema:maxValue ; sh:maxCount 0 ] ; sh:property [ sh:path rv:basis ; sh:minCount 1 ; sh:in ( rv:PerServing rv:WholeRecipe ) ] ; sh:property [ sh:path rv:coverage ; sh:minCount 1 ; sh:in ( rv:Complete rv:Partial rv:Unknown ) ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:class prov:Activity ] ; sh:property [ sh:path schema:unitCode ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
        [ sh:property [ sh:path schema:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 1000000000000 ] ; sh:property [ sh:path schema:minValue ; sh:maxCount 0 ] ; sh:property [ sh:path schema:maxValue ; sh:maxCount 0 ] ; sh:property [ sh:path rv:basis ; sh:minCount 1 ; sh:in ( rv:PerServing rv:WholeRecipe ) ] ; sh:property [ sh:path rv:coverage ; sh:minCount 1 ; sh:in ( rv:Complete rv:Partial rv:Unknown ) ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:class prov:Activity ] ; sh:property [ sh:path schema:unitText ; sh:minCount 1 ; sh:datatype xsd:string ] ]
        [ sh:property [ sh:path schema:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype owl:rational ; sh:pattern "^(0|1000000000000|[1-9][0-9]{0,11})/(1000000000000|[1-9][0-9]{0,11})$" ] ; sh:property [ sh:path schema:minValue ; sh:maxCount 0 ] ; sh:property [ sh:path schema:maxValue ; sh:maxCount 0 ] ; sh:property [ sh:path rv:basis ; sh:minCount 1 ; sh:in ( rv:PerServing rv:WholeRecipe ) ] ; sh:property [ sh:path rv:coverage ; sh:minCount 1 ; sh:in ( rv:Complete rv:Partial rv:Unknown ) ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:class prov:Activity ] ; sh:property [ sh:path schema:unitCode ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
        [ sh:property [ sh:path schema:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype owl:rational ; sh:pattern "^(0|1000000000000|[1-9][0-9]{0,11})/(1000000000000|[1-9][0-9]{0,11})$" ] ; sh:property [ sh:path schema:minValue ; sh:maxCount 0 ] ; sh:property [ sh:path schema:maxValue ; sh:maxCount 0 ] ; sh:property [ sh:path rv:basis ; sh:minCount 1 ; sh:in ( rv:PerServing rv:WholeRecipe ) ] ; sh:property [ sh:path rv:coverage ; sh:minCount 1 ; sh:in ( rv:Complete rv:Partial rv:Unknown ) ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:class prov:Activity ] ; sh:property [ sh:path schema:unitText ; sh:minCount 1 ; sh:datatype xsd:string ] ]
    ) .

<https://rezics.com/definition/recipe-facts-v1/servings-shape> a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rv:definitionProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/recipe-facts-v1> ] ;
    sh:property [ sh:path schema:value ; sh:maxCount 1 ; sh:nodeKind sh:IRIOrLiteral ] ;
    sh:property [ sh:path schema:minValue ; sh:maxCount 1 ; sh:nodeKind sh:IRIOrLiteral ] ;
    sh:property [ sh:path schema:maxValue ; sh:maxCount 1 ; sh:nodeKind sh:IRIOrLiteral ] ;
    sh:property [ sh:path rdf:type ; sh:maxCount 2 ; sh:hasValue schema:QuantitativeValue ; sh:in ( schema:QuantitativeValue schema:PropertyValue schema:Duration ) ] ;
    sh:property [ sh:path schema:unitCode ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:unitText ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 100 ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:class prov:Activity ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:description ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 100 ] ;
    sh:property [ sh:path schema:propertyID ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue schema:numberOfItems ] ;
    sh:property [ sh:path rv:basis ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue rv:WholeRecipe ] ;
    sh:property [ sh:path rv:coverage ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Complete rv:Partial rv:Unknown ) ] ;
    sh:or (
        [ sh:property [ sh:path schema:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 1000000000000 ] ; sh:property [ sh:path schema:minValue ; sh:maxCount 0 ] ; sh:property [ sh:path schema:maxValue ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:class prov:Activity ] ; sh:property [ sh:path schema:unitText ; sh:minCount 1 ; sh:datatype xsd:string ] ]
        [ sh:property [ sh:path schema:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype owl:rational ; sh:pattern "^(1000000000000|[1-9][0-9]{0,11})/(1000000000000|[1-9][0-9]{0,11})$" ] ; sh:property [ sh:path schema:minValue ; sh:maxCount 0 ] ; sh:property [ sh:path schema:maxValue ; sh:maxCount 0 ] ; sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:class prov:Activity ] ; sh:property [ sh:path schema:unitText ; sh:minCount 1 ; sh:datatype xsd:string ] ]
    ) .

<https://rezics.com/definition/recipe-facts-v1/recipe-shape> a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rv:definitionProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/recipe-facts-v1> ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue schema:Recipe ] ;
    sh:property [ sh:path prov:specializationOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:recipeYield ; sh:maxCount 2 ; sh:class schema:QuantitativeValue ] ;
    sh:property [ sh:path schema:prepTime ; sh:maxCount 1 ; sh:class schema:Duration ] ;
    sh:property [ sh:path schema:cookTime ; sh:maxCount 1 ; sh:class schema:Duration ] ;
    sh:property [ sh:path schema:totalTime ; sh:maxCount 1 ; sh:class schema:Duration ] ;
    sh:property [ sh:path schema:nutrition ; sh:maxCount 1 ; sh:class schema:NutritionInformation ] .

<https://rezics.com/definition/recipe-facts-v1/nutrition-shape> a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rv:definitionProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/recipe-facts-v1> ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue schema:NutritionInformation ] ;
    sh:property [ sh:path schema:additionalProperty ; sh:minCount 1 ; sh:maxCount 64 ; sh:class schema:PropertyValue ] .

<https://rezics.com/definition/recipe-facts-v1/activity-shape> a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rv:definitionProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/recipe-facts-v1> ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue prov:Activity ] ;
    sh:property [ sh:path schema:description ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "declared" "source-stated" "computed" ) ] .
