# An identified claim: one precise proposition about a referent in an interpretation context.
# Revisions are immutable; quality, review, dispute and adoption are separate records.
# The claim head moves by exact CAS. Evidence manifests are Content-owned (verification schema).
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/claim-v1/claim-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:Claim ] ;
    sh:property [ sh:path rv:referent ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:interpretationContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:propositionPredicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:claimHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:ClaimRevision ] ;
    sh:property [ sh:path rv:claimState ; sh:hasValue rv:Active ; sh:maxCount 1 ] .

<https://rezics.com/definition/claim-v1/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:ClaimRevision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Claim ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:ClaimRevision ] ;
    sh:property [ sh:path rv:referent ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:interpretationContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:propositionPredicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:propositionValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRIOrLiteral ] ;
    sh:property [ sh:path rv:valuePrecision ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:ExactValue rv:ApproximateValue rv:UncertainValue ) ] ;
    sh:property [ sh:path rv:valueQualifier ; sh:maxCount 2 ; sh:in ( rv:DisputedAttribution rv:InferredValue ) ] ;
    sh:property [ sh:path rv:validFrom ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:validUntil ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:editionScope ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:claimStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Asserted rv:Withdrawn ) ] ;
    sh:property [ sh:path rv:derivation ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:statedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:recordedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/claim-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/claim-v1> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .
