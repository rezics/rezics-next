# Opt-in Performer admission. Retained V1 shapes and default selection stay unchanged.
# One immutable, human-confirmed credit occurrence with a provider-qualified external participant.
# A source author key does not identify a native Agent. Repeated keys retain separate credit identities.
# The source owner keeps private support and correspondence separately from native identity.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/work-author-credit-v2/credit-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:AuthorCredit ] ;
    sh:property [ sh:path rv:modelRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/work-author-credit-v2> ] ;
    sh:property [ sh:path rv:creditRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:AuthorCreditRevision ] ;
    sh:property [ sh:path rv:work ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path schema:roleName ; sh:maxCount 1 ; sh:minCount 1 ; sh:in ( "author" "translator" "editor" "director" "artist" "animation-studio" "performer" ) ] ;
    sh:property [ sh:path rv:externalProvider ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z][a-z0-9-]{0,63}$" ] ;
    sh:property [ sh:path rv:externalNamespace ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z][a-z0-9-]{0,63}$" ] ;
    sh:property [ sh:path rv:externalKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 200 ] ;
    sh:property [ sh:path rv:sourceRoleKey ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 200 ] ;
    sh:property [ sh:path schema:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 127 ] ;
    sh:property [ sh:path rv:editControl ; sh:maxCount 1 ; sh:hasValue rv:HumanConfirmed ] ;
    sh:property [ sh:path rv:rightsStatus ; sh:maxCount 1 ; sh:hasValue rv:Undetermined ] ;
    sh:property [ sh:path rv:agent ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:author ; sh:maxCount 0 ] .

<https://rezics.com/definition/work-author-credit-v2/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:AuthorCreditRevision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:AuthorCredit ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 0 ] ;
    sh:property [ sh:path rv:confirmedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:workRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RevisionAnchor ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/work-author-credit-v2> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/work-author-credit-v2> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path rv:work ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path schema:roleName ; sh:maxCount 1 ; sh:minCount 1 ; sh:in ( "author" "translator" "editor" "director" "artist" "animation-studio" "performer" ) ] ;
    sh:property [ sh:path rv:externalProvider ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z][a-z0-9-]{0,63}$" ] ;
    sh:property [ sh:path rv:externalNamespace ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z][a-z0-9-]{0,63}$" ] ;
    sh:property [ sh:path rv:externalKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 200 ] ;
    sh:property [ sh:path rv:sourceRoleKey ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 200 ] ;
    sh:property [ sh:path schema:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 127 ] ;
    sh:property [ sh:path rv:editControl ; sh:maxCount 1 ; sh:hasValue rv:HumanConfirmed ] ;
    sh:property [ sh:path rv:rightsStatus ; sh:maxCount 1 ; sh:hasValue rv:Undetermined ] ;
    sh:property [ sh:path rv:agent ; sh:maxCount 0 ] ;
    sh:property [ sh:path schema:author ; sh:maxCount 0 ] .

# Authored SHACL constraints for Work addresses and author credits.
