{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": ["tests/qa/unit/fixtures/**"],
  "rules": {
    "no-debugger": "error",
    "no-dupe-keys": "error",
    "no-fallthrough": "error",
    "no-unreachable": "error",
    // Unused imports, locals and types; parameters stay free so callbacks keep their shape.
    "no-unused-vars": [
      "error",
      { "args": "none", "ignoreRestSiblings": true, "varsIgnorePattern": "^_" }
    ],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "typescript/no-floating-promises": ["error", { "checkThenables": true }],
    "typescript/no-misused-promises": "error"
  }
}
