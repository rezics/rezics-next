{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": ["tests/qa/unit/fixtures/**"],
  "rules": {
    "typescript/no-floating-promises": ["error", { "checkThenables": true }],
    "typescript/no-misused-promises": "error"
  }
}
