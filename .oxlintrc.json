{
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "perf": "off",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "no-debugger": "error",
    "no-dupe-keys": "error",
    "no-fallthrough": "error",
    "no-unreachable": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-unused-vars": ["error", { "args": "none", "ignoreRestSiblings": true, "varsIgnorePattern": "^_" }]
  }
}
