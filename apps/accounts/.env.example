# Generated by task env:example from apps/accounts/features/config/env.ts. Do not edit.
# task dev:prepare writes the local values, including generated secrets, to
# .temp/stack/<project>/dev.env (see `task env`). Put personal overrides in the
# repository-root .env.dev; see .env.dev.example.

## Accounts Worker
# Enrollment widget profile; must match Account. Local mode makes no provider request. (default: cloudflare)
# ACCOUNT_TURNSTILE_MODE=cloudflare
# Public Cloudflare Turnstile site key; missing key disables only the enrollment widget. (default: )
# ACCOUNT_TURNSTILE_SITE_KEY=
# Account service origin that /api/auth, /api/account, /oauth2 and /.well-known proxy to. (default: http://127.0.0.1:3002)
# ACCOUNT_SERVICE_ORIGIN=http://127.0.0.1:3002
# Public Account origin and OAuth issuer base, the same value the Account service uses. (default: http://127.0.0.1:3004)
# ACCOUNT_BASE_URL=http://127.0.0.1:3004
# REZICS web origin linked from the Accounts header. (default: http://127.0.0.1:3000)
# WEB_ORIGIN=http://127.0.0.1:3000
# Development only: sign-up takes its country from the request CF-IPCountry header, not the Cloudflare edge, so a browser tool can choose a region. Production refuses it. (default: false)
# ACCOUNTS_COUNTRY_FROM_HEADER=false
# Public about site origin that publishes the policies sign-up and re-acceptance link to. (default: https://rezics.com)
# ABOUT_SITE_URL=https://rezics.com
