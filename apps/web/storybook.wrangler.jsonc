{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rezics-storybook",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "storybook.rezics.com", "custom_domain": true }],
  "assets": {
    "directory": "./storybook-static",
    "binding": "ASSETS",
    "run_worker_first": false,
  },
}
