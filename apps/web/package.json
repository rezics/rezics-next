{
  "name": "@rezics/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/storybook-dev.ts --app",
    "storybook": "bun scripts/storybook-dev.ts --port 6006",
    "storybook:build": "bun scripts/storybook-build.ts",
    "storybook:deploy": "bun scripts/storybook-deploy.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "record": "bun scripts/record.ts",
    "build": "bun scripts/check-placement.ts --returns apps/web/dist --returns apps/web/.wrangler -- vite build --config vite.config.ts",
    "check": "oxfmt --check . '!src/kernel/recorded/*.json' && bun scripts/check.ts --skip-format --test-command 'bun run test'",
    "typecheck": "bun run generate && bun run generate:routes && bun check --no-script -p tsconfig.json",
    "generate": "bun scripts/generate.ts",
    "generate:routes": "node .storybook/generate-routes.ts",
    "test": "bun scripts/check-placement.ts -- bun scripts/isolated.ts bun test",
    "test:stories": "bun scripts/check.ts --stories --test-command 'bun run test'",
    "test:host": "bun scripts/check.ts --host"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@base-ui/react": "1.9.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@cloudflare/workers-types": "5.20261031.1",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/noto-serif-jp": "5.3.1",
    "@fontsource/noto-serif-kr": "5.3.1",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@fontsource/noto-serif-tc": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-json": "5.1.64",
    "@puckeditor/core": "0.24.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@rezics/client": "workspace:*",
    "@rezics/composition": "workspace:*",
    "@rezics/definitions": "workspace:*",
    "@rezics/document": "workspace:*",
    "@rezics/filter": "workspace:*",
    "@rezics/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "date-fns": "4.4.0",
    "lucide-react": "1.66.0",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satori": "0.63.2",
    "tailwindcss": "4.3.3",
    "typebox": "1.4.3",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "11.0.0-alpha.8",
    "@storybook/addon-docs": "11.0.0-alpha.8",
    "@storybook/addon-mcp": "11.0.0-alpha.8",
    "@storybook/addon-vitest": "11.0.0-alpha.8",
    "@storybook/react-vite": "11.0.0-alpha.8",
    "@tanstack/router-generator": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.1.0-beta.1",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "storybook": "11.0.0-alpha.8",
    "vite": "8.3.5",
    "vitest": "5.1.0-beta.1",
    "wrangler": "4.156.0"
  }
}
