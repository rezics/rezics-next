# Generated by task env:example from apps/web/features/config/env.ts. Do not edit.
# task dev:prepare writes the local values, including generated secrets, to
# .temp/stack/<project>/dev.env (see `task env`). Put personal overrides in the
# repository-root .env.dev; see .env.dev.example.

## Web Worker
# Main origin the BFF proxies to. (default: http://127.0.0.1:3001)
# MAIN_ORIGIN=http://127.0.0.1:3001
# Account origin for OAuth and the auth proxy. (default: http://127.0.0.1:3002)
# ACCOUNT_ORIGIN=http://127.0.0.1:3002
# OAuth resource identifier requested for Main. (default: https://main.rezics.test)
# MAIN_RESOURCE=https://main.rezics.test
# Public PKCE client ID registered at Account by task dev:prepare. (optional)
# WEB_OAUTH_CLIENT_ID=<generated by task dev:prepare>
