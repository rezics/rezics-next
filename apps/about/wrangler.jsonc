{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rezics-about",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/",
      "/api/*",
      "/reading",
      "/light-novels",
      "/serial-fiction",
      "/acgn",
      "/wikis",
      "/agents",
      "/communities",
      "/distribution",
      "/developers",
      "/trust",
      "/roadmap"
    ]
  },
  "env": {
    "production": {
      "name": "rezics-about-production",
      "vars": { "ABOUT_SITE_URL": "<ABOUT_SITE_URL>" }
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rezics-about",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
