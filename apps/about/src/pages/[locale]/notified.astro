---
import { buttonVariants } from '@rezics/ui/button';
import { CircleCheck } from 'lucide-react';
import { copy } from '../../i18n/format.ts';
import type { UiLocale } from '../../i18n/locales.ts';
import Base from '../../layouts/Base.astro';
import { localePaths } from '../../lib/site.ts';
import { pagePath } from '../../pages.ts';

export const getStaticPaths = localePaths;
const locale = Astro.params.locale as UiLocale;
const { notify } = copy('site', locale);
---
<Base locale={locale} page="home" title={notify.successTitle} description={notify.successBody} noindex>
  <div class="mx-auto w-full max-w-2xl px-5 py-24 sm:px-8">
    <CircleCheck aria-hidden className="size-10 text-success-foreground" />
    <h1 class="display mt-6 text-4xl font-extrabold">{notify.successTitle}</h1>
    <p class="prose-lede mt-4 text-lg text-muted-foreground">{notify.successBody}</p>
    <a href={pagePath(locale, 'home')} class={`${buttonVariants({ size: 'lg', variant: 'outline' })} mt-8`}>{notify.back}</a>
  </div>
</Base>
