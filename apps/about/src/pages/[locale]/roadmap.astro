---
import CallToAction from '../../components/sections/CallToAction.astro';
import ChapterHero from '../../components/sections/ChapterHero.astro';
import ScrollStory from '../../components/sections/ScrollStory.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import Statement from '../../components/sections/Statement.astro';
import StoryStep from '../../components/sections/StoryStep.astro';
import { copy, pageLanguage } from '../../i18n/format.ts';
import type { UiLocale } from '../../i18n/locales.ts';
import { RoadmapRoute, StageFrame, type RouteStage } from '../../illustrations/RoadmapPictures.tsx';
import Base from '../../layouts/Base.astro';
import { featureIds, features, horizons, milestoneHorizon, milestones } from '../../features.ts';
import { localePaths } from '../../lib/site.ts';

export const getStaticPaths = localePaths;
const locale = Astro.params.locale as UiLocale;
const text = copy('roadmap', locale);
const featureText = copy('features', locale);
const status = copy('site', locale).status;
const standing = { now: status.inDevelopment, next: status.next, later: status.later };
const stages: RouteStage[] = milestones.map(milestone => ({
  name: text.milestones[milestone].name,
  standing: standing[milestoneHorizon[milestone]],
  now: milestoneHorizon[milestone] === 'now',
}));
const shown = 4;
const available = featureIds.filter(id => features[id].horizon === 'available');
---
<Base locale={locale} page="roadmap" title={text.meta.title} description={text.meta.description}
  contentLang={pageLanguage(locale, 'roadmap', 'features', 'site')}>
  <ChapterHero locale={locale} page="roadmap" title={text.hero.title} lede={text.hero.lede}>
    <RoadmapRoute slot="visual" stages={stages} />
  </ChapterHero>

  <ScrollStory id="stages" title={text.story.title} lede={text.story.lede} steps={milestones.length}>
    {milestones.map((milestone, index) => {
      const titles = featureIds.filter(id => features[id].milestone === milestone).map(id => featureText[id].title);
      return (
        <StoryStep index={index} title={text.milestones[milestone].name} body={text.milestones[milestone].body} number>
          <div slot="frame" class="w-full max-w-2xl" data-step={milestone}>
            <StageFrame stages={stages} index={index} items={titles.slice(0, shown)} more={Math.max(0, titles.length - shown)}
              words={{ stageOf: text.stageOf, more: text.more }} />
          </div>
        </StoryStep>
      );
    })}
  </ScrollStory>

  <section aria-labelledby="columns" class="chapter">
    <div class="page-frame">
      <SectionHeading id="columns" title={text.columns.title} lede={text.columns.lede} />
      <div class="mt-12 grid gap-12 md:mt-16 md:grid-cols-3 md:gap-8">
        {horizons.map(horizon => (
          <div data-roadmap-column={horizon}>
            <div class="relative border-t-2 pt-6" style={horizon === 'now' ? 'border-color: var(--primary)' : 'border-color: var(--border)'}>
              {horizon === 'now' && <span class="ribbon absolute -top-0.5 end-0 h-12 w-3" aria-hidden="true"></span>}
              <h3 class="type-title">{text.horizons[horizon].title}</h3>
              <p class="mt-2 text-muted-foreground">{text.horizons[horizon].body}</p>
            </div>
            <ul class="mt-6 divide-y divide-border border-y border-border">
              {featureIds.filter(id => features[id].horizon === horizon).map(id => (
                <li class="py-4" data-feature={id}>
                  <h4 class="font-semibold">{featureText[id].title}</h4>
                  <p class="mt-1 text-sm text-muted-foreground">{featureText[id].body}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="mt-20">
        <SectionHeading id="available" title={text.availableTitle} lede={text.availableLede} />
        <ul class="mt-6 divide-y divide-border border-y border-border">
          {available.map(id => (
            <li class="py-4" data-feature={id}>
              <h3 class="font-semibold">{featureText[id].title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{featureText[id].body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Statement id="dates" text={text.statement.text} body={text.statement.body} />

  <CallToAction locale={locale} title={text.cta.title} body={text.cta.body} />
</Base>
