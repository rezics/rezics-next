---
import CallToAction from '../components/sections/CallToAction.astro';
import ChapterHero from '../components/sections/ChapterHero.astro';
import Compare from '../components/sections/Compare.astro';
import Ledger from '../components/sections/Ledger.astro';
import ScrollStory from '../components/sections/ScrollStory.astro';
import Showcase from '../components/sections/Showcase.astro';
import Statement from '../components/sections/Statement.astro';
import StoryStep from '../components/sections/StoryStep.astro';
import Tile from '../components/sections/Tile.astro';
import { pageLanguage } from '../i18n/format.ts';
import type { UiLocale } from '../i18n/locales.ts';
import { linePages, type LinePageId } from '../i18n/messages/index.ts';
import { featuresOf, type FeatureId } from '../features.ts';
import Base from './Base.astro';

/**
 * A product line page in the standard order (PATTERNS.md): chapter hero, pinned story,
 * showcase, compare, statement, ledger, call to action, all from the page's `LinePageCopy`.
 * Pages pass their pictures as named slots: `hero`, `step-<key>` for each story step and
 * `tile-<key>` for each showcase tile. A step without a picture shows its text alone.
 */
interface Props {
  locale: UiLocale;
  page: LinePageId;
  /** Features from other lines the page also states; its own line's come first. */
  alsoFeatures?: readonly FeatureId[];
  /** Showcase tile widths by key; tiles default to two of the grid's six columns. */
  tileSpans?: Record<string, 2 | 3 | 4 | 6>;
  /** Tiles set on the line's cloth instead of paper. */
  clothTiles?: readonly string[];
  /** Number the story's steps when they are a real sequence. */
  numbered?: boolean;
}
const { locale, page, alsoFeatures = [], tileSpans = {}, clothTiles = [], numbered = false } = Astro.props;
const text = linePages[page][locale];
const steps = Object.entries(text.story.steps);
const tiles = Object.entries(text.showcase.tiles);
const ids = [...featuresOf(page), ...alsoFeatures];
---
<Base locale={locale} page={page} title={text.meta.title} description={text.meta.description}
  contentLang={pageLanguage(locale, page, 'features', 'illustrations')}>
  <ChapterHero locale={locale} page={page} title={text.hero.title} lede={text.hero.lede}>
    <slot name="hero" slot="visual" />
  </ChapterHero>

  <ScrollStory id="story" title={text.story.title} lede={text.story.lede} steps={steps.length}>
    {steps.map(([key, step], index) => (
      <StoryStep index={index} title={step.title} body={step.body} number={numbered}>
        <div slot="frame" class="w-full max-w-2xl" data-step={key}>
          {Astro.slots.has(`step-${key}`) && <Fragment set:html={Astro.slots.render(`step-${key}`)} />}
        </div>
      </StoryStep>
    ))}
  </ScrollStory>

  <Showcase id="showcase" title={text.showcase.title} lede={text.showcase.lede}>
    {tiles.map(([key, tile]) => (
      <Tile title={tile.title} body={tile.body} span={tileSpans[key] ?? 2}
        surface={clothTiles.includes(key) ? 'cloth' : 'paper'} cloth={clothTiles.includes(key) ? page : undefined}>
        {Astro.slots.has(`tile-${key}`) && <Fragment slot="visual" set:html={Astro.slots.render(`tile-${key}`)} />}
      </Tile>
    ))}
  </Showcase>

  <Compare id="compare" title={text.compare.title} lede={text.compare.lede} today={text.compare.today} rezics={text.compare.rezics} rows={text.compare.rows} />

  <Statement id="statement" text={text.statement.text} body={text.statement.body} />

  <Ledger locale={locale} id="capabilities" title={text.ledger.title} lede={text.ledger.lede} ids={ids} />

  <CallToAction locale={locale} title={text.cta.title} body={text.cta.body} />
</Base>
