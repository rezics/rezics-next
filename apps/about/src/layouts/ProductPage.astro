---
import FeatureList from '../components/FeatureList.astro';
import NotifyPanel from '../components/NotifyPanel.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { copy } from '../i18n/format.ts';
import type { UiLocale } from '../i18n/locales.ts';
import { productPages } from '../i18n/messages/index.ts';
import { featuresOf, type FeatureId } from '../features.ts';
import type { PageId } from '../pages.ts';
import Base from './Base.astro';

interface Props {
  locale: UiLocale;
  page: keyof typeof productPages;
  /** Features from other lines the page also states; its own line's come first. */
  alsoFeatures?: readonly FeatureId[];
}

const { locale, page, alsoFeatures = [] } = Astro.props;
const text = productPages[page][locale];
const site = copy('site', locale);
const ids = [...featuresOf(page as PageId), ...alsoFeatures];
---
<Base locale={locale} page={page} title={text.meta.title} description={text.meta.description}>
  <div class="mx-auto w-full max-w-300 px-5 sm:px-8">
    <PageHero title={text.hero.title} lede={text.hero.lede} />
    <Section id="scene" title={text.scene.title}>
      <div class="grid grid-cols-[minmax(0,1fr)] items-start gap-8 lg:grid-cols-[minmax(0,0.55fr)_minmax(0,1fr)] lg:gap-10">
        <p class="prose-lede max-w-md text-lg">{text.scene.body}</p>
        <slot name="scene" />
      </div>
    </Section>
    <Section id="features" title={text.featuresTitle}>
      <FeatureList locale={locale} ids={ids} />
      <p class="mt-4 text-sm text-muted-foreground">{site.status.legend}</p>
    </Section>
    <NotifyPanel locale={locale} />
  </div>
</Base>
