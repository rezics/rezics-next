---
import { copy } from '../i18n/format.ts';
import type { UiLocale } from '../i18n/locales.ts';
import { NotifyForm } from '../islands/NotifyForm.tsx';

interface Props { locale: UiLocale }
const { locale } = Astro.props;
const { notify } = copy('site', locale);
---
<section id="notify" aria-labelledby="notify-title" class="border-t border-border py-14 md:py-20">
  <div class="rounded-3xl bg-accent/60 p-6 sm:p-10 md:grid md:grid-cols-2 md:gap-14">
    <div>
      <h2 id="notify-title" class="heading text-2xl font-bold md:text-3xl">{notify.title}</h2>
      <p class="prose-lede mt-3 max-w-md text-muted-foreground">{notify.body}</p>
    </div>
    <div class="mt-8 md:mt-0">
      <NotifyForm client:visible locale={locale} labels={{ emailLabel: notify.emailLabel, submit: notify.submit, sending: notify.sending,
        successTitle: notify.successTitle, successBody: notify.successBody, errors: notify.errors }} />
      <p class="mt-3 text-sm text-muted-foreground">{notify.privacy}</p>
    </div>
  </div>
</section>
