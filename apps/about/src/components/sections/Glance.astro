---
import { copy } from '../../i18n/format.ts';
import type { UiLocale } from '../../i18n/locales.ts';
import { milestoneHorizon, milestones } from '../../features.ts';
import { pagePath } from '../../pages.ts';
import SectionHeading from './SectionHeading.astro';

/**
 * The direction at a glance: GOAL.md's five stages in order, with the one in development
 * marked by the ribbon. Stage names and summaries come from the roadmap catalog.
 */
interface Props { locale: UiLocale; id: string; title: string; lede?: string; link?: string; class?: string }
const { locale, id, title, lede, link, class: className = '' } = Astro.props;
const stages = copy('roadmap', locale).milestones;
const status = copy('site', locale).status;
const horizonName = { now: status.inDevelopment, next: status.next, later: status.later };
---
<section aria-labelledby={id} class={`chapter ${className}`}>
  <div class="page-frame">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading id={id} title={title} lede={lede} />
      {link && <a href={pagePath(locale, 'roadmap')} class="rounded-md font-semibold text-primary underline decoration-2 underline-offset-4 outline-none focus-visible:ring-2 focus-visible:ring-ring">{link}</a>}
    </div>
    <ol class="glance mt-12 md:mt-16">
      {milestones.map(milestone => (
        <li class="glance-stage" data-horizon={milestoneHorizon[milestone]}>
          {milestoneHorizon[milestone] === 'now' && <span class="ribbon" aria-hidden="true"></span>}
          <p class="text-sm font-semibold text-muted-foreground" lang={locale}>{horizonName[milestoneHorizon[milestone]]}</p>
          <h3 class="mt-2 text-xl font-bold tracking-[-0.01em]">{stages[milestone].name}</h3>
          <p class="type-body mt-3 text-muted-foreground">{stages[milestone].body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
