---
import SectionHeading from './SectionHeading.astro';

/** The showcase grid: `Tile` children on a six-column grid (two columns on tablets, one on phones). */
interface Props { id: string; title: string; lede?: string; class?: string }
const { id, title, lede, class: className = '' } = Astro.props;
---
<section aria-labelledby={id} class={`chapter ${className}`}>
  <div class="page-frame">
    <SectionHeading id={id} title={title} lede={lede} />
    <div class="showcase mt-12 md:mt-16"><slot /></div>
  </div>
</section>
