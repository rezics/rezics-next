---
/** A section's heading and lede: the one heading style every section pattern shares. */
interface Props { id: string; title: string; lede?: string; class?: string }
const { id, title, lede, class: className = '' } = Astro.props;
---
<div class={`max-w-4xl ${className}`}>
  <h2 id={id} class="type-section">{title}</h2>
  {lede && <p class="type-lede mt-5 text-muted-foreground">{lede}</p>}
</div>
