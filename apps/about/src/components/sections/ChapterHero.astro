---
import { buttonVariants } from '@rezics/ui/button';
import { catalogs } from '../../i18n/messages/index.ts';
import { uiLocales, type UiLocale } from '../../i18n/locales.ts';
import type { PageId } from '../../pages.ts';

/**
 * A product line's opening, like a book's title page: the line's name set huge on its
 * cloth, the same name in the other interface languages beneath it, then the headline
 * (the page's h1), its lede and the picture in the `visual` slot.
 */
interface Props { locale: UiLocale; page: PageId; title: string; lede: string }
const { locale, page, title, lede } = Astro.props;
const site = catalogs.site[locale];
const name = site.pages[page].name;
const seen = new Set([name]);
const otherNames = uiLocales
  .map(other => ({ lang: other, name: catalogs.site[other].pages[page].name }))
  .filter(entry => !seen.has(entry.name) && seen.add(entry.name));
---
<header class="dark cloth chapter-hero" style={`--cloth: var(--cloth-${page})`}>
  <div class="page-frame">
    <p class="chapter-name type-chapter" style={`view-transition-name: line-${page}`}>{name}</p>
    <ul class="chapter-names mt-5" aria-hidden="true">
      {otherNames.map(entry => <li lang={entry.lang}>{entry.name}</li>)}
    </ul>
    <div class="mt-12 grid items-center gap-12 md:mt-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <h1 class="type-title max-w-xl">{title}</h1>
        <p class="type-lede mt-6 text-muted-foreground">{lede}</p>
        <a href="#notify" class={buttonVariants({ size: 'xl', className: 'cloth-button mt-9' })}>{site.header.cta}</a>
      </div>
      <div class="min-w-0"><slot name="visual" /></div>
    </div>
  </div>
</header>
