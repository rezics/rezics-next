---
import { pagePath } from '../pages.ts';
import type { UiLocale } from '../i18n/locales.ts';

interface Props { locale: UiLocale; label: string }
const { locale, label } = Astro.props;
---
<a href={pagePath(locale, 'home')} aria-label={label} class="-ms-1.5 flex h-10 shrink-0 items-center gap-2.5 rounded-xl px-1.5 outline-none focus-visible:ring-2 focus-visible:ring-ring">
  <!-- The Z mark in logo red: a non-text mark, so red is allowed here. -->
  <svg viewBox="0 142.857 1000 714.286" aria-hidden="true" focusable="false" class="h-5 w-7 shrink-0 fill-brand">
    <path d="M0 571.429 642.857 142.857 571.429 428.571 1000 142.857v285.714L357.143 857.143l71.428-285.714L0 857.143Z" />
  </svg>
  <span aria-hidden="true" class="hidden font-extrabold text-[15px] tracking-[0.28em] text-foreground sm:inline">REZICS</span>
</a>
