---
import { ChevronDown, Menu } from 'lucide-react';
import { buttonVariants } from '@rezics/ui/button';
import type { UiLocale } from '../i18n/locales.ts';
import { copy } from '../i18n/format.ts';
import { infoPageIds, pagePath, productLineIds, type RoutePage } from '../pages.ts';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import LocaleMenu from './LocaleMenu.astro';

interface Props { locale: UiLocale; page: RoutePage }
const { locale, page } = Astro.props;
const site = copy('site', locale);
const linkClass = 'rounded-xl px-3 py-2 text-sm font-medium outline-none hover:bg-accent hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-ring aria-[current=page]:text-primary';
const summaryClass = 'flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-xl px-3 text-sm font-medium outline-none hover:bg-accent hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden';
---
<header class="sticky top-0 z-40 border-b border-border/60 bg-background/90 backdrop-blur supports-backdrop-filter:bg-background/80">
  <div class="mx-auto flex h-16 w-full max-w-300 items-center gap-2 px-5 sm:px-8">
    <Logo locale={locale} label={site.pages.home.name} />

    <nav aria-label={site.header.products} class="ms-4 hidden items-center gap-1 lg:flex">
      <details class="relative">
        <summary class={summaryClass}>
          {site.header.products}
          <ChevronDown className="size-4" aria-hidden="true" />
        </summary>
        <ul class="absolute start-0 top-full z-50 mt-2 grid w-[44rem] grid-cols-2 gap-1 rounded-3xl border border-border bg-popover p-2 shadow-(--aura-shadow-float)">
          {productLineIds.map(id => (
            <li>
              <a href={pagePath(locale, id)} aria-current={page === id ? 'page' : undefined} class="block rounded-2xl px-4 py-3 outline-none hover:bg-accent focus-visible:bg-accent aria-[current=page]:bg-accent">
                <span class="block text-sm font-semibold">{site.pages[id].name}</span>
                <span class="mt-0.5 block text-sm text-muted-foreground">{site.pages[id].summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
      {infoPageIds.map(id => (
        <a href={pagePath(locale, id)} aria-current={page === id ? 'page' : undefined} class={linkClass}>{site.pages[id].name}</a>
      ))}
    </nav>

    <div class="ms-auto flex items-center gap-1">
      <LocaleMenu locale={locale} page={page} label={site.header.language} />
      <ThemeToggle labels={site.header} />
      <a href={`${pagePath(locale, 'home')}#notify`} class={`${buttonVariants({ size: 'md' })} hidden sm:inline-flex`}>{site.header.cta}</a>

      <details class="relative lg:hidden">
        <summary class="flex size-9 cursor-pointer list-none items-center justify-center rounded-xl outline-none hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden" aria-label={site.header.menu}>
          <Menu className="size-5" aria-hidden="true" />
        </summary>
        <nav aria-label={site.header.menu} class="absolute end-0 top-full z-50 mt-2 max-h-[calc(100dvh-5rem)] w-[min(22rem,calc(100vw-2.5rem))] overflow-y-auto rounded-3xl border border-border bg-popover p-2 shadow-(--aura-shadow-float)">
          <ul>
            {[...productLineIds, ...infoPageIds].map(id => (
              <li>
                <a href={pagePath(locale, id)} aria-current={page === id ? 'page' : undefined} class="block rounded-2xl px-4 py-2.5 text-sm font-medium outline-none hover:bg-accent focus-visible:bg-accent aria-[current=page]:text-primary">{site.pages[id].name}</a>
              </li>
            ))}
          </ul>
          <a href={`${pagePath(locale, 'home')}#notify`} class={`${buttonVariants({ size: 'lg' })} mt-2 w-full sm:hidden`}>{site.header.cta}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
