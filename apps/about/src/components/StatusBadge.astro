---
import { badgeVariants } from '@rezics/ui/badge';
import { CircleDashed } from 'lucide-react';
import { copy } from '../i18n/format.ts';
import type { UiLocale } from '../i18n/locales.ts';
import type { Feature } from '../features.ts';

interface Props { feature: Feature; locale: UiLocale; class?: string }
const { feature, locale, class: className } = Astro.props;
const words = copy('site', locale).status;
---
{feature.status === 'later' && (
  <span class={badgeVariants({ variant: 'outline', size: 'md', className })} data-status="later" title={words.laterHelp} lang={locale}>
    <CircleDashed aria-hidden />
    {words.later}
  </span>
)}
