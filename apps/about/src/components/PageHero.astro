---
interface Props { title: string; lede: string }
const { title, lede } = Astro.props;
---
<header class="grid gap-8 pb-14 pt-14 md:pb-20 md:pt-24 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
  <div>
    <h1 class="display text-[clamp(2.25rem,5.4vw,4.25rem)] font-extrabold">{title}</h1>
    <p class="prose-lede mt-6 max-w-2xl text-lg text-muted-foreground md:text-xl">{lede}</p>
  </div>
  <div><slot /></div>
</header>
