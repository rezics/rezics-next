---
import { copy } from '../i18n/format.ts';
import type { UiLocale } from '../i18n/locales.ts';
import { features, type FeatureId } from '../features.ts';
import StatusBadge from './StatusBadge.astro';

interface Props { locale: UiLocale; ids: readonly FeatureId[] }
const { locale, ids } = Astro.props;
const text = copy('features', locale);
---
<ul class="divide-y divide-border border-y border-border">
  {ids.map(id => (
    <li class="flex flex-col gap-3 py-6 sm:flex-row sm:items-start sm:justify-between sm:gap-8" data-feature={id}>
      <div class="max-w-xl">
        <h3 class="text-lg font-semibold">{text[id].title}</h3>
        <p class="prose-lede mt-1.5 text-muted-foreground">{text[id].body}</p>
      </div>
      <div class="shrink-0"><StatusBadge status={features[id].status} locale={locale} /></div>
    </li>
  ))}
</ul>
