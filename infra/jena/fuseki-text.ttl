# Graph-substrate example for Apache Jena/Fuseki 6.2.0.
# Product assembler: storage paths resolve against FUSEKI_BASE (/fuseki in the image).
# The standalone substrate quickstart retains the stock cjk-bigram-v1 analyzer.
PREFIX fuseki: <http://jena.apache.org/fuseki#>
PREFIX ja: <http://jena.hpl.hp.com/2005/11/Assembler#>
PREFIX tdb2:   <http://jena.apache.org/2016/tdb#>
PREFIX text:   <http://jena.apache.org/text#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rv:     <https://rezics.com/vocab/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <https://schema.org/>

[] ja:loadClass "org.apache.jena.query.text.TextQuery" .
<https://rezics.com/fuseki/FilteredGraphTextIndex> rdfs:subClassOf ja:Object .

<#server> a fuseki:Server ;
    fuseki:services ( <#service> ) .

<#service> a fuseki:Service ;
    fuseki:name "rezics" ;
    fuseki:serviceQuery "query" ;
    fuseki:endpoint [ fuseki:operation <https://rezics.com/fuseki/command> ; fuseki:name "command" ] ;
    fuseki:dataset <#text_dataset> .

# Exactly one text dataset also lets jena.textindexer reuse this assembler.
<#text_dataset> a text:TextDataset ;
    text:dataset <#tdb_dataset> ;
    text:index <#text_index> .

<#tdb_dataset> a tdb2:DatasetTDB2 ;
    tdb2:location "databases/rezics/tdb2" .

<#text_index> a <https://rezics.com/fuseki/FilteredGraphTextIndex> ;
    text:directory "databases/rezics/lucene" ;
    text:entityMap <#entity_map> ;
    # REZICS cjk-bigram-v2: ICU NFKC case/width normalization, Chinese and kana
    # folding, then CJK bigrams. Dataset profile v3 requires an index rebuild.
    text:analyzer [ a text:GenericAnalyzer ;
        text:class "com.rezics.jena.FilteredGraphTextAssembler$CjkBigramV2" ] ;
    text:storeValues true ;
    text:ignoreIndexErrors false .

<#entity_map> a text:EntityMap ;
    text:entityField "uri" ;
    text:defaultField "label" ;
    text:uidField "uid" ;
    text:graphField "graph" ;
    text:langField "lang" ;
    text:map ( [ text:field "label" ; text:predicate rdfs:label ]
               [ text:field "name" ; text:predicate schema:name ]
               [ text:field "conceptLabel" ; text:predicate skos:prefLabel ]
               [ text:field "conceptAlias" ; text:predicate skos:altLabel ]
               [ text:field "publicTitle" ; text:predicate rv:publicTitle ]
               [ text:field "body" ; text:predicate rv:searchBody ]
               [ text:field "privateBody" ; text:predicate rv:privateSearchBody ] ) .
