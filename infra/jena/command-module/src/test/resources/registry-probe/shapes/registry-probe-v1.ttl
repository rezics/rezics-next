# Synthetic profile proving registry-only command routing; test fixture only.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/registry-probe-v1/item-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rv:probeLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

<https://rezics.com/definition/registry-probe-v1/sealed-item-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rv:probeLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sealedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

<https://rezics.com/definition/registry-probe-v1/record-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rv:item ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
