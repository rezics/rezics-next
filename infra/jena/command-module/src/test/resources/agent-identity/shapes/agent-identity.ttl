@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rv: <https://rezics.com/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://rezics.com/definition/agent-identity-probe/agent-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rv:agentKind ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
