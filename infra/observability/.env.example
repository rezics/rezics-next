# Supply real files outside Git. The smoke task creates disposable files under
# .temp only; these paths are operator inputs for a future private deployment.
GREPTIME_USERS_FILE=/etc/rezics/secrets/greptime-users
GREPTIME_PASSWORD_FILE=/etc/rezics/secrets/greptime-password
PERSES_ENCRYPTION_KEY_FILE=/etc/rezics/secrets/perses-encryption-key
PERSES_GREPTIME_SECRET_FILE=/etc/rezics/secrets/perses-greptime.json
GREPTIME_HTTP_PORT=4000
OTLP_HTTP_PORT=4318
PERSES_HTTP_PORT=8088

# Application processes receive the following standard settings. The Collector
# ingress is private/loopback. Cross-host access requires an authenticated TLS
# transport or the existing WireGuard interface, with a receiver bind override.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_VERSION=<release-artifact-id>
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRIC_EXPORT_INTERVAL=15000
