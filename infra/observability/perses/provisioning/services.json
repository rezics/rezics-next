{
  "kind": "Dashboard",
  "metadata": { "name": "services", "project": "rezics" },
  "spec": {
    "display": { "name": "Service health" },
    "duration": "1h",
    "refreshInterval": "15s",
    "panels": {
      "traffic": {
        "kind": "Panel",
        "spec": {
          "display": { "name": "Requests per second" },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": { "legend": { "position": "bottom", "mode": "list" } }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": { "kind": "PrometheusDatasource", "name": "metrics" },
                    "query": "sum by (service_name) (rate(http_server_request_duration_seconds_count[5m]))"
                  }
                }
              }
            }
          ]
        }
      },
      "errors": {
        "kind": "Panel",
        "spec": {
          "display": { "name": "Server error ratio" },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": { "legend": { "position": "bottom", "mode": "list" } }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": { "kind": "PrometheusDatasource", "name": "metrics" },
                    "query": "sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) / sum by (service_name) (rate(http_server_request_duration_seconds_count[5m]))"
                  }
                }
              }
            }
          ]
        }
      },
      "latency": {
        "kind": "Panel",
        "spec": {
          "display": { "name": "Request latency p95" },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": { "format": { "unit": "seconds" } },
              "legend": { "position": "bottom", "mode": "list" }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": { "kind": "PrometheusDatasource", "name": "metrics" },
                    "query": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket[5m])))"
                  }
                }
              }
            }
          ]
        }
      },
      "logs": {
        "kind": "Panel",
        "spec": {
          "display": { "name": "Recent service events" },
          "plugin": { "kind": "LogsTable", "spec": {} },
          "queries": [
            {
              "kind": "LogQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBLogQuery",
                  "spec": {
                    "datasource": { "kind": "GreptimeDBDatasource", "name": "telemetry" },
                    "query": "SELECT * FROM rezics_logs WHERE timestamp >= to_timestamp_millis(${__from}) AND timestamp <= to_timestamp_millis(${__to}) ORDER BY timestamp DESC LIMIT 200"
                  }
                }
              }
            }
          ]
        }
      },
      "traces": {
        "kind": "Panel",
        "spec": {
          "display": { "name": "Recent request traces" },
          "plugin": { "kind": "TraceTable", "spec": {} },
          "queries": [
            {
              "kind": "TraceQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTraceQuery",
                  "spec": {
                    "datasource": { "kind": "GreptimeDBDatasource", "name": "telemetry" },
                    "query": "SELECT * FROM rezics_traces WHERE timestamp >= to_timestamp_millis(${__from}) AND timestamp <= to_timestamp_millis(${__to}) ORDER BY timestamp DESC LIMIT 200"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": { "title": "HTTP, logs and traces" },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": { "$ref": "#/spec/panels/traffic" }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": { "$ref": "#/spec/panels/errors" }
            },
            {
              "x": 0,
              "y": 8,
              "width": 24,
              "height": 8,
              "content": { "$ref": "#/spec/panels/latency" }
            },
            {
              "x": 0,
              "y": 16,
              "width": 24,
              "height": 10,
              "content": { "$ref": "#/spec/panels/logs" }
            },
            {
              "x": 0,
              "y": 26,
              "width": 24,
              "height": 10,
              "content": { "$ref": "#/spec/panels/traces" }
            }
          ]
        }
      }
    ]
  }
}
