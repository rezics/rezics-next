#!/usr/bin/env bash
# QA puts this directory first on PATH. run and create gain the reap-owner and,
# when a child was given one, the reap-scope label. Every other docker command,
# including compose, is executed unchanged.
# The binary is the next docker on PATH that does not live in this directory.
# A stub placed before or between copies of the shim is the one that runs.
set -euo pipefail

self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
real=
IFS=':' read -r -a path_dirs <<< "${PATH-}"
for dir in "${path_dirs[@]}"; do
  [[ -n $dir ]] || continue
  resolved=$(cd "$dir" 2>/dev/null && pwd -P) || continue
  [[ $resolved == "$self" ]] && continue
  candidate=$resolved/docker
  if [[ -x $candidate && ! -d $candidate ]]; then
    real=$candidate
    break
  fi
done
if [[ -z $real ]]; then
  printf '%s\n' 'docker shim: no docker on PATH after the shim' >&2
  exit 127
fi
if [[ -z ${REZICS_REAP_OWNER:-} && -z ${REZICS_REAP_SCOPE:-} ]]; then
  exec "$real" "$@"
fi

takes_value() {
  case $1 in
    --config|--context|--host|--log-level|--tlscacert|--tlscert|--tlskey|-c|-H|-l) return 0 ;;
  esac
  return 1
}

args=("$@")
index=-1
word=0
skip=0
after_container=0
for i in "${!args[@]}"; do
  arg=${args[$i]}
  if (( skip )); then
    skip=0
    continue
  fi
  case $arg in
    --config=*|--context=*|--host=*|--log-level=*|--tlscacert=*|--tlscert=*|--tlskey=*)
      continue ;;
    -c?*|-H?*|-l?*)
      continue ;;
    --)
      continue ;;
    -*)
      if takes_value "$arg"; then skip=1; fi
      continue ;;
  esac
  word=$((word + 1))
  if (( word == 1 )) && [[ $arg == container ]]; then
    after_container=1
    continue
  fi
  if [[ $arg == run || $arg == create ]] && { (( word == 1 )) || (( after_container )); }; then
    index=$i
  fi
  break
done

if (( index < 0 )); then
  exec "$real" "$@"
fi

labels=()
if [[ -n ${REZICS_REAP_OWNER:-} ]]; then
  labels+=(--label "rezics.reap-owner=${REZICS_REAP_OWNER}")
fi
if [[ -n ${REZICS_REAP_SCOPE:-} ]]; then
  labels+=(--label "rezics.reap-scope=${REZICS_REAP_SCOPE}")
fi
head=("${args[@]:0:index+1}")
if (( index + 1 < ${#args[@]} )); then
  exec "$real" "${head[@]}" "${labels[@]}" "${args[@]:index+1}"
fi
exec "$real" "${head[@]}" "${labels[@]}"
