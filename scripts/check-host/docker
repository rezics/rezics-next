#!/bin/sh
# Stands in for `docker` on check hosts and in worker worktrees.
# Containers that `docker run` and `docker create` start are placed in the run's slice, so no workspace has to
# know it is running there. Every other command goes to the real docker unchanged.
#
# The real docker is the first one after this directory on the path. Anything ahead of it (a test's own docker shim, for
# one) put itself there and calls this wrapper, so looking only further along keeps a shim from being called back.
self=$(cd "$(dirname "$0")" && pwd)
rest=
old_ifs=$IFS
IFS=:
for entry in $PATH; do
  if [ -n "$entry" ] && [ "$(cd "$entry" 2>/dev/null && pwd)" = "$self" ]; then
    rest=
    continue
  fi
  rest=${rest:+$rest:}$entry
done
IFS=$old_ifs
PATH=$rest
export PATH

case "$1" in
  run | create)
    verb=$1
    shift
    if [ -n "${REZICS_CHECK_RUN:-}" ]; then set -- --label "rezics.check.run=$REZICS_CHECK_RUN" "$@"; fi
    if [ -n "${GOAL_TASK_ID:-}" ] && [ -n "${GOAL_ATTEMPT:-}" ]; then set -- --label "rezics.worker.attempt=$GOAL_TASK_ID/$GOAL_ATTEMPT" "$@"; fi
    exec docker "$verb" --cgroup-parent="${REZICS_CHECK_SLICE:-rezics-check.slice}" "$@"
    ;;
  container)
    case "${2:-}" in
      run | create)
        verb=$2
        shift 2
        if [ -n "${REZICS_CHECK_RUN:-}" ]; then set -- --label "rezics.check.run=$REZICS_CHECK_RUN" "$@"; fi
        if [ -n "${GOAL_TASK_ID:-}" ] && [ -n "${GOAL_ATTEMPT:-}" ]; then set -- --label "rezics.worker.attempt=$GOAL_TASK_ID/$GOAL_ATTEMPT" "$@"; fi
        exec docker container "$verb" --cgroup-parent="${REZICS_CHECK_SLICE:-rezics-check.slice}" "$@"
        ;;
    esac
    ;;
esac
exec docker "$@"
