# Copy to ~/.config/systemd/user/goal-coordinator.service after review.
# Customize WorkingDirectory and supply PATH (Bun + Task + tmux + Codex) in the env file.
# Start tmux OUTSIDE this unit first; set GOAL_COORDINATOR_TMUX_SOCKET for a custom socket.
# task goal -- coordinator start <goal> --engine codex --effort high
# Handover of an existing interactive manager:
# task goal -- coordinator enroll <goal> --session <UUID> --engine codex --effort high --cwd <root> --previous-owner-pid <pid> --tmux-socket <socket>
# Claude: the same command with --engine claude --model <id>.
# The first wake waits until that exact previous owner exits; status reports the wait.
# Check task goal -- coordinator status before enabling; messages never grant permission.
# systemctl --user daemon-reload && systemctl --user enable --now goal-coordinator.service
# Linger=no on the pilot host: the maintainer must enable lingering for logout survival,
# or select a system service. This unit does not change login/linger policy.
[Unit]
Description=REZICS durable Goal manager wake coordinator
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/projects/rezics/rezics-next
EnvironmentFile=%h/.config/rezics/goal-coordinator.env
ExecStart=/usr/bin/env task goal -- coordinator
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=15
# Passes use systemd-run --user --scope --collect; their workers, capacity continuations
# and landing wrappers inherit that scope outside this group. Manager turns use independent tmux.
# A scope-launch fallback stays in this group and is killed with a hung supervisor on stop.

[Install]
WantedBy=default.target
