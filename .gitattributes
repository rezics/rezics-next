# Parallel Goal branches append route plugins to the composition root; keep both sides.
services/main/src/app.ts merge=union
# Legacy OpenAPI security lists take concurrent appends; new routes declare openApiOperations instead.
scripts/api/generate.ts merge=union
# Composition roots: Goal branches add dependency wiring and fields; keep both sides.
services/main/src/index.ts merge=union
services/main/src/composition.ts merge=union
services/main/src/routes/dependencies.ts merge=union
# Web feature registries: slices add one line each (message catalogs, navigation entries).
apps/web/i18n/catalogs.ts merge=union
apps/web/features/shell/navigation.ts merge=union
# QA registries: Goal branches register new owner integration tests by appending a line.
scripts/qa/integration-gate-files.ts merge=union
scripts/qa/isolated-integration-files.ts merge=union
# Unified diff context lines prefix upstream tab indentation with one space.
.yarn/patches/*.patch -whitespace
