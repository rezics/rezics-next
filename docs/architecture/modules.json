      "capabilities": ["access"],
      "postgresPaths": ["services/kernel/src/access/**"]
    },
    {
      "id": "kernel-commerce",
      "kind": "adapter",
      "owner": "commerce",
      "paths": ["services/kernel/src/commerce/**", "services/kernel/db/commerce/**"],
