# Graph-substrate example for Apache Jena/Fuseki 6.2.0.
# Run from the private state directory described in ../installation.md.
# Relative storage paths resolve against the process working directory.
PREFIX fuseki: <http://jena.apache.org/fuseki#>
PREFIX tdb2:   <http://jena.apache.org/2016/tdb#>
PREFIX text:   <http://jena.apache.org/text#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rv:     <https://rezics.com/vocab/>

<#server> a fuseki:Server ;
    fuseki:services ( <#service> ) .

<#service> a fuseki:Service ;
    fuseki:name "rezics" ;
    fuseki:serviceQuery "query" ;
    fuseki:serviceUpdate "update" ;
    fuseki:dataset <#text_dataset> .

# Exactly one text dataset also lets jena.textindexer reuse this assembler.
<#text_dataset> a text:TextDataset ;
    text:dataset <#tdb_dataset> ;
    text:index <#text_index> .

<#tdb_dataset> a tdb2:DatasetTDB2 ;
    tdb2:location "databases/rezics/tdb2" .

<#text_index> a text:TextIndexLucene ;
    text:directory "databases/rezics/lucene" ;
    text:entityMap <#entity_map> ;
    text:analyzer [ a text:StandardAnalyzer ] ;
    text:storeValues true ;
    text:ignoreIndexErrors false .

<#entity_map> a text:EntityMap ;
    text:entityField "uri" ;
    text:defaultField "label" ;
    text:uidField "uid" ;
    text:graphField "graph" ;
    text:langField "lang" ;
    text:map ( [ text:field "label" ; text:predicate rdfs:label ]
               [ text:field "body" ; text:predicate rv:searchBody ] ) .
