@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .
@prefix ex: <https://example.org/rezics-test/> .

ex:work a schema:CreativeWork ;
    rv:mainVersion ex:main ;
    rv:continuityProfile ex:continuity-v1 .

ex:main a rv:MainVersion ;
    rv:work ex:work ;
    rv:hostingPolicy rv:MetadataOnly .
