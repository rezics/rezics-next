# A Work selects one reviewed Structure profile and an exact immutable source root.
# Withdrawn decisions explicitly carry no public source; text PublicationDecision remains separate.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/work-structure-publication-v2/work-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue schema:CreativeWork ] ;
    sh:property [ sh:path rv:workStructurePublicationHead ; sh:maxCount 1 ; sh:class rv:WorkStructurePublicationDecision ] .

<https://rezics.com/definition/work-structure-publication-v2/decision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:WorkStructurePublicationDecision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^urn:rezics:operation:[0-9a-f]{64}$" ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:WorkStructurePublicationDecision ] ;
    sh:property [ sh:path rv:publicationOutcome ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Published rv:Withdrawn ) ] ;
    sh:property [ sh:path rv:publicSource ; sh:maxCount 1 ; sh:class rv:WorkStructurePublicSource ] ;
    sh:property [ sh:path rv:modelRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/work-structure-publication-v2> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/work-structure-publication-v2> ] ;
    sh:property [ sh:path rv:datasetId ; sh:maxCount 1 ; sh:hasValue <urn:rezics:dataset:product> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:rightsBasis ; sh:maxCount 1 ; sh:in ( rv:OriginalContribution rv:PublicDomain ) ] ;
    sh:property [ sh:path rv:sourceObservation ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:rightsAssessment ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^urn:rezics:rights:assessment:[0-9a-f-]{36}$" ] ;
    sh:or (
        [ sh:property [ sh:path rv:publicationOutcome ; sh:hasValue rv:Published ] ;
          sh:property [ sh:path rv:rightsBasis ; sh:minCount 1 ; sh:hasValue rv:OriginalContribution ] ;
          sh:property [ sh:path rv:sourceObservation ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:rightsAssessment ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:publicSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:WorkStructurePublicSource ] ]
        [ sh:property [ sh:path rv:publicationOutcome ; sh:hasValue rv:Published ] ;
          sh:property [ sh:path rv:rightsBasis ; sh:minCount 1 ; sh:hasValue rv:PublicDomain ] ;
          sh:property [ sh:path rv:sourceObservation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path rv:rightsAssessment ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:publicSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:WorkStructurePublicSource ] ]
        [ sh:property [ sh:path rv:publicationOutcome ; sh:hasValue rv:Published ] ;
          sh:property [ sh:path rv:rightsBasis ; sh:minCount 1 ; sh:hasValue rv:PublicDomain ] ;
          sh:property [ sh:path rv:sourceObservation ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:rightsAssessment ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path rv:publicSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:WorkStructurePublicSource ] ]
        [ sh:property [ sh:path rv:publicationOutcome ; sh:hasValue rv:Withdrawn ] ;
          sh:property [ sh:path rv:publicSource ; sh:maxCount 0 ] ]
    ) .

<https://rezics.com/definition/work-structure-publication-v2/source-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:WorkStructurePublicSource ] ;
    sh:property [ sh:path rv:work ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:structureProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:structure ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Structure ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:MainVersion ] ;
    sh:property [ sh:path rv:structureRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureRevision ] ;
    sh:property [ sh:path rv:selectedGeneration ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StructureGeneration ] ;
    sh:property [ sh:path rv:sourceObservation ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:rightsAssessment ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^urn:rezics:rights:assessment:[0-9a-f-]{36}$" ] ;
    sh:property [ sh:path rv:modelRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/work-structure-publication-v2> ] ;
    sh:property [ sh:path schema:citation ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 8000 ] ;
    sh:property [ sh:path rv:sourceRoot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^urn:rezics:sha256:[0-9a-f]{64}$" ] ;
    sh:or (
        [ sh:property [ sh:path rv:rightsAssessment ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:rightsAssessment ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path rv:sourceObservation ; sh:maxCount 0 ] ;
          sh:property [ sh:path schema:citation ; sh:minCount 1 ; sh:datatype xsd:string ] ]
    ) .
