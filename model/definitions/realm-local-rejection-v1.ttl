# Explicit negative publication decision for one Realm/Main Version slot.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/realm-local-rejection-v1/rejection-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:RealmPublicationRejection ] ;
    sh:property [ sh:path rv:context ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:slot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:work ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:mainVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:decisionBasis ; sh:hasValue rv:RealmManagerReview ] ;
    sh:property [ sh:path rv:reasonCode ; sh:hasValue rv:NotApproved ] ;
    sh:property [ sh:path rv:selectionPolicy ; sh:hasValue <https://rezics.com/definition/realm-manager-fixed-main-fallback-v1> ] ;
    sh:property [ sh:path rv:reviewPolicy ; sh:hasValue <https://rezics.com/definition/realm-manager-reviewed-v1> ] ;
    sh:property [ sh:path rv:outcome ; sh:hasValue rv:Rejected ] .
