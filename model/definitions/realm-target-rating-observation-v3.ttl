# Exact-target standing observations for scoped Realm questions, projections included.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/realm-target-rating-observation-v3/realm-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:Realm ] ;
    sh:property [ sh:path rv:realmState ; sh:maxCount 1 ; sh:hasValue rv:Active ] ;
    sh:property [ sh:path rv:ratingContext ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

<https://rezics.com/definition/realm-target-rating-observation-v3/context-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:TargetRatingContext ] ;
    sh:property [ sh:path rv:contextState ; sh:maxCount 1 ; sh:hasValue rv:Active ] ;
    sh:property [ sh:path rv:realm ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:question ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 3 ; sh:maxLength 120 ] ;
    sh:property [ sh:path rv:targetGrain ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Release rv:Realization rv:Occurrence rv:Resource rv:Projection ) ] ;
    sh:property [ sh:path rv:ratingScaleMin ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:hasValue 1 ] ;
    sh:property [ sh:path rv:ratingScaleMax ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:hasValue 10 ] ;
    sh:property [ sh:path rv:ratingCadence ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/rating-standing-v1> ] ;
    sh:property [ sh:path rv:ratingPopulationPolicy ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/rating-account-principal-population-v1> ] ;
    sh:property [ sh:path rv:ratingAggregationPolicy ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/rating-latest-per-rater-mean-v1> ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ScopedTargetRatingContext ] ;
    sh:property [ sh:path rv:displayThreshold ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 1000 ] .

<https://rezics.com/definition/realm-target-rating-observation-v3/observation-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:TargetRatingObservation ] ;
    sh:property [ sh:path rv:ratingContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:TargetRatingContext ] ;
    sh:property [ sh:path rv:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:ratingSlot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:observationHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:TargetRatingObservationRevision ] ;
    sh:property [ sh:path rv:targetMainVersion ; sh:maxCount 0 ] ;
    sh:property [ sh:path rv:targetRelease ; sh:maxCount 0 ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ScopedTargetRatingObservation ] .

<https://rezics.com/definition/realm-target-rating-observation-v3/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:TargetRatingObservationRevision ] ;
    sh:property [ sh:path rv:observation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:TargetRatingObservation ] ;
    sh:property [ sh:path rv:ratingAvailability ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Available rv:Withdrawn ) ] ;
    sh:property [ sh:path rv:evaluatedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:submittedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:originalSubmissionAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:revisedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:TargetRatingObservationRevision ] ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ScopedTargetRatingObservationRevision ] ;
    sh:or (
        [ sh:property [ sh:path rv:ratingAvailability ; sh:hasValue rv:Available ] ;
          sh:property [ sh:path rv:ratingValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 10 ] ]
        [ sh:property [ sh:path rv:ratingAvailability ; sh:hasValue rv:Withdrawn ] ;
          sh:property [ sh:path rv:ratingValue ; sh:maxCount 0 ] ]
    ) .

# Authored SHACL constraints for versioned target rating evidence.
