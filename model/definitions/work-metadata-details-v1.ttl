# Independent descriptive metadata, bibliographic edition and editor relevance components.
# The command validates the bounded discriminated JSON state; SHACL validates its revision envelope.
# The original title is explicitly recorded; language alone never marks a title as original.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/work-metadata-details-v1/work-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue schema:CreativeWork ] ;
    sh:property [ sh:path rv:descriptiveMetadataHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:WorkMetadataRevision ] .

<https://rezics.com/definition/work-metadata-details-v1/component-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:WorkMetadataComponent ] ;
    sh:property [ sh:path rv:work ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:metadataKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "header" "edition" "relevance" ) ] ;
    sh:property [ sh:path rv:metadataHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:WorkMetadataRevision ] ;
    sh:property [ sh:path rv:editionState ; sh:maxCount 1 ; sh:in ( rv:Active rv:Withdrawn ) ] ;
    sh:property [ sh:path rv:editionLanguage ; sh:maxCount 1 ; sh:datatype xsd:string ] .

<https://rezics.com/definition/work-metadata-details-v1/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:WorkMetadataRevision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:WorkMetadataComponent ] ;
    sh:property [ sh:path rv:metadataState ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 65536 ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:WorkMetadataRevision ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/work-metadata-details-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/work-metadata-details-v1> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .
