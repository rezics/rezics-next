# One immutable active model generation per dataset and its guarded control head.
# A generation pins the generated profile manifest, command module build, entailment and reject posture.
# Semantic commands guard the head; old revisions keep the exact generation they were validated under.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/semantic-model-generation-v1/generation-shape>
    a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:ModelGeneration rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:maxCount 1 ; sh:hasValue <urn:rezics:model:product> ] ;
    sh:property [ sh:path rv:generationNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:ModelGeneration ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:commandModuleVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 32 ] ;
    sh:property [ sh:path rv:entailmentProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:NoEntailment ) ] ;
    sh:property [ sh:path rv:identityInference ; sh:maxCount 1 ; sh:hasValue rv:Excluded ] ;
    sh:property [ sh:path rv:validationPosture ; sh:maxCount 1 ; sh:hasValue rv:RejectOnViolation ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/semantic-model-generation-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/semantic-model-generation-v1> ] ;
    sh:property [ sh:path rv:datasetId ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .

<https://rezics.com/definition/semantic-model-generation-v1/head-shape>
    a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:ModelComponent ] ;
    sh:property [ sh:path rv:generationHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:ModelGeneration ] .
