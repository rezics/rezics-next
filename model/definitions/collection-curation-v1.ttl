# A Collection has its own identity and visibility; members are occurrences of its Structure.
# A Dynamic Collection is a versioned selection rule and stores no membership.
# A capture is a separate ordinary Collection pinned to one rule revision with an explicit coverage boundary.
# Visibility of a Collection never discloses a private member, its title or a member count.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/collection-curation-v1/structure-link-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:Collection ] ;
    sh:property [ sh:path rv:structure ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Structure ] .

<https://rezics.com/definition/collection-curation-v1/collection-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:Collection ] ;
    sh:property [ sh:path rv:structure ; sh:maxCount 1 ; sh:class rv:Structure ] ;
    sh:property [ sh:path rv:curator ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:disclosure ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Public rv:Private ) ] ;
    sh:property [ sh:path rv:collectionState ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Active rv:Retired ) ] ;
    sh:property [ sh:path rv:collectionHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:CollectionRevision ] ;
    sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:datatype rdf:langString ; sh:uniqueLang true ; sh:maxLength 300 ] ;
    sh:property [ sh:path rv:collectionKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:StaticCollection rv:CapturedCollection ) ] ;
    sh:property [ sh:path rv:capturedFrom ; sh:maxCount 1 ; sh:class rv:DynamicCollectionRevision ] ;
    sh:property [ sh:path rv:captureCoverage ; sh:maxCount 1 ; sh:in ( rv:Complete rv:Partial ) ] ;
    sh:or (
        [ sh:property [ sh:path rv:collectionKind ; sh:hasValue rv:StaticCollection ] ;
          sh:property [ sh:path rv:capturedFrom ; sh:maxCount 0 ] ;
          sh:property [ sh:path rv:captureCoverage ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:collectionKind ; sh:hasValue rv:CapturedCollection ] ;
          sh:property [ sh:path rv:capturedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:DynamicCollectionRevision ] ;
          sh:property [ sh:path rv:captureCoverage ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Complete rv:Partial ) ] ]
    ) .

<https://rezics.com/definition/collection-curation-v1/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:CollectionRevision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Collection ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:CollectionRevision ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:collectionOperation ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:CollectionCreate rv:CollectionCapture rv:CollectionRename rv:CollectionDisclosureChange rv:CollectionRetire rv:CollectionRecover ) ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/collection-curation-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/collection-curation-v1> ] ;
    sh:property [ sh:path rv:datasetId ; sh:maxCount 1 ; sh:hasValue <urn:rezics:dataset:product> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .

<https://rezics.com/definition/collection-curation-v1/definition-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:DynamicCollection ] ;
    sh:property [ sh:path rv:curator ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:disclosure ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Public rv:Private ) ] ;
    sh:property [ sh:path rv:collectionState ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Active rv:Retired ) ] ;
    sh:property [ sh:path rv:definitionHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:DynamicCollectionRevision ] ;
    sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:datatype rdf:langString ; sh:uniqueLang true ; sh:maxLength 300 ] .

<https://rezics.com/definition/collection-curation-v1/definition-revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:DynamicCollectionRevision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:DynamicCollection ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:DynamicCollectionRevision ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:queryProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:resultBudget ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 10000 ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/collection-curation-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/collection-curation-v1> ] ;
    sh:property [ sh:path rv:datasetId ; sh:maxCount 1 ; sh:hasValue <urn:rezics:dataset:product> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .
