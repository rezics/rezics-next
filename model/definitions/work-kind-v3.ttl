# Descriptive Work types are admitted by Access, without changing this shape.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/work-kind-v3/work-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 4 ; sh:nodeKind sh:IRI ; sh:hasValue schema:CreativeWork ] ;
    sh:property [ sh:path rv:mainVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class rv:MainVersion ] .
