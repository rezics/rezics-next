# Public Realm presentation is an independent, receipted revision.
# A manager nomination never publishes a moderator without the Agent public choice.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/realm-public-profile-v1/moderator-slot-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:RealmModeratorPublicChoice ] ;
    sh:property [ sh:path rv:realm ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Realm ] ;
    sh:property [ sh:path rv:agent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Agent ] ;
    sh:property [ sh:path rv:choiceHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RealmModeratorChoiceRevision ] .

<https://rezics.com/definition/realm-public-profile-v1/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:RealmPublicProfileRevision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Realm ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:RealmPublicProfileRevision ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:profilePayload ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 2 ; sh:maxLength 16000 ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/realm-public-profile-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/realm-public-profile-v1> ] ;
    sh:property [ sh:path rv:datasetId ; sh:maxCount 1 ; sh:hasValue <urn:rezics:dataset:product> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .

<https://rezics.com/definition/realm-public-profile-v1/moderator-choice-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:RealmModeratorChoiceRevision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RealmModeratorPublicChoice ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:RealmModeratorChoiceRevision ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:publicChoice ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Accepted rv:Declined ) ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/realm-public-profile-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/realm-public-profile-v1> ] ;
    sh:property [ sh:path rv:datasetId ; sh:maxCount 1 ; sh:hasValue <urn:rezics:dataset:product> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .
