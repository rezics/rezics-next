# First curated classification decision for a public MainVersion.
# Application and Decision have distinct identities; the latter is the head
# selected by the former. This profile does not model community judgment.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/classification-direct-decision-v1/work-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue schema:CreativeWork ] ;
    sh:property [ sh:path rv:mainVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

<https://rezics.com/definition/classification-direct-decision-v1/main-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:MainVersion ] ;
    sh:property [ sh:path rv:work ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

<https://rezics.com/definition/classification-direct-decision-v1/sense-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ClassificationSense ] ;
    sh:property [ sh:path rv:senseState ; sh:hasValue rv:Active ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:interpretationScope ;
                  sh:hasValue <urn:rezics:classification-context:global> ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:head ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

<https://rezics.com/definition/classification-direct-decision-v1/context-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ClassificationContext ] ;
    sh:property [ sh:path rv:contextState ; sh:hasValue rv:Active ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:inheritancePolicy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

<https://rezics.com/definition/classification-direct-decision-v1/application-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ClassificationApplication ] ;
    sh:property [ sh:path rv:targetMainVersion ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class rv:MainVersion ] ;
    sh:property [ sh:path rv:sense ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class rv:ClassificationSense ] ;
    sh:property [ sh:path rv:classificationContext ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class rv:ClassificationContext ] ;
    sh:property [ sh:path rv:applicationChannel ; sh:hasValue rv:Curated ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:applicationState ; sh:hasValue rv:Active ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:proposer ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:decisionHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

<https://rezics.com/definition/classification-direct-decision-v1/decision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ClassificationDecision ] ;
    sh:property [ sh:path rv:application ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class rv:ClassificationApplication ] ;
    sh:property [ sh:path rv:outcome ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( rv:Accepted rv:Rejected ) ] ;
    sh:property [ sh:path rv:decisionBasis ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( rv:GlobalCuratorReview rv:RealmManagerReview ) ] ;
    sh:property [ sh:path rv:decidedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:decisionPolicy ;
                  sh:hasValue <https://rezics.com/definition/classification-direct-decision-v1> ;
                  sh:maxCount 1 ] ;
    sh:property [ sh:path rv:contextRevision ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
