# An independently versioned question presentation for one RatingContext and BCP 47 language.
# The authored question, Context head, manifest and observations never advance with presentation wording.
# One editorial head and an optional last reviewed head per Context/language; drafts retain the reviewed text.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/rating-question-presentation-v2/presentation-shape>
    a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:RatingQuestionPresentationV2 ] ;
    sh:property [ sh:path rv:questionPresentationHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RatingQuestionPresentationV2Revision ] ;
    sh:property [ sh:path rv:questionPresentationReviewedHead ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:presentationContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:presentationLanguage ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 255 ] .

<https://rezics.com/definition/rating-question-presentation-v2/revision-shape>
    a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:RatingQuestionPresentationV2Revision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RatingQuestionPresentationV2 ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:presentationContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:presentationLanguage ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 255 ] ;
    sh:property [ sh:path rv:question ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 3 ; sh:maxLength 120 ] ;
    sh:property [ sh:path rv:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 2048 ] ;
    sh:property [ sh:path rv:licence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 2048 ] ;
    sh:property [ sh:path rv:reviewStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Draft rv:Reviewed ) ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelGeneration ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:ModelGeneration ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/rating-question-presentation-v2> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/rating-question-presentation-v2> ] ;
    sh:property [ sh:path rv:datasetId ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .
