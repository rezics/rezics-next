# Immutable correction proposal revision for one native Work English title slot. It changes no adoption.
# The candidate is retained in its manifest; private proposer identity belongs to Access.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/correction-proposal-v1/log-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:CorrectionLog ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:protectedSlot ; sh:maxCount 1 ; sh:hasValue "title:en" ] ;
    sh:property [ sh:path rv:adoptionContext ; sh:maxCount 1 ; sh:hasValue rv:GlobalNative ] ;
    sh:property [ sh:path rv:proposalHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:CorrectionProposal ] ;
    sh:property [ sh:path rv:proposalCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .

<https://rezics.com/definition/correction-proposal-v1/proposal-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:CorrectionProposal rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:proposal ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:proposalRevisionNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:CorrectionProposal ] ;
    sh:property [ sh:path rv:logPredecessor ; sh:maxCount 1 ; sh:class rv:CorrectionProposal ] ;
    sh:property [ sh:path rv:logOrdinal ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:protectedSlot ; sh:maxCount 1 ; sh:hasValue "title:en" ] ;
    sh:property [ sh:path rv:adoptionContext ; sh:maxCount 1 ; sh:hasValue rv:GlobalNative ] ;
    sh:property [ sh:path rv:baseRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RevisionAnchor ] ;
    sh:property [ sh:path rv:baseProtection ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:baseControl ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:baseControlEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path rv:ruleRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( <urn:rezics:protection-rule:independent-human-review-v1> ) ] ;
    sh:property [ sh:path rv:proposalOrigin ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:HumanProposal rv:SourceProposal ) ] ;
    sh:property [ sh:path rv:candidateRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RevisionAnchor ] ;
    sh:property [ sh:path rv:candidateManifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:candidateDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path rv:proposalAdmission ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ] ;
    sh:property [ sh:path rv:evidence ; sh:maxCount 32 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:agent ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:proposalIntent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 16000 ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/correction-proposal-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/correction-proposal-v1> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:or (
        [ sh:property [ sh:path rv:proposalOrigin ; sh:hasValue rv:HumanProposal ] ;
          sh:property [ sh:path rv:sourceProposal ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path rv:proposalOrigin ; sh:hasValue rv:SourceProposal ] ;
          sh:property [ sh:path rv:sourceProposal ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ]
    ) .
