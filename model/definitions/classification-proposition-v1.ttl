# First immutable, shared classification proposition: one Concept path and one Sense.
# Later path profiles may add ordered typed relations without reinterpreting this path.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/classification-proposition-v1/scheme-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue skos:ConceptScheme ] ;
    sh:property [ sh:path rv:schemeState ; sh:hasValue rv:Active ; sh:maxCount 1 ] .

<https://rezics.com/definition/classification-proposition-v1/concept-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue skos:Concept ] ;
    sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype rdf:langString ; sh:languageIn ( "en" ) ; sh:uniqueLang true ] ;
    sh:property [ sh:path rv:conceptState ; sh:hasValue rv:Active ; sh:maxCount 1 ] .

<https://rezics.com/definition/classification-proposition-v1/path-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ConceptPath ] ;
    sh:property [ sh:path rv:pathKind ; sh:hasValue rv:SingleConcept ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:pathLength ; sh:hasValue 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:terminalConcept ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:pathState ; sh:hasValue rv:Active ; sh:maxCount 1 ] .

<https://rezics.com/definition/classification-proposition-v1/expression-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ClassificationExpression ] ;
    sh:property [ sh:path rv:path ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:propositionKind ; sh:hasValue rv:ConceptAssertion ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:assertedConcept ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:expressionState ; sh:hasValue rv:Active ; sh:maxCount 1 ] .

<https://rezics.com/definition/classification-proposition-v1/sense-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ClassificationSense ] ;
    sh:property [ sh:path rv:path ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:expression ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:interpretationScope ;
                  sh:hasValue <urn:rezics:classification-context:global> ; sh:maxCount 1 ] ;
    sh:property [ sh:path rv:senseState ; sh:hasValue rv:Active ; sh:maxCount 1 ] .
