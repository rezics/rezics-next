# Immutable value nodes (revisions graph) for exact quantities, temporal descriptions, directional text
# and external references. Directional text is the JSON-LD 1.1 rdf:CompoundLiteral form.
# Numbers keep exact RDF lexicals (xsd:integer, xsd:decimal, owl:rational); JSON carries them only as strings.
# Original temporal lexicals survive engine normalization; derived UTC bounds are query aids only.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/value-exact-v1/quantity-shape>
    a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rdf:type ; sh:hasValue schema:QuantitativeValue ] ;
    sh:property [ sh:path schema:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRIOrLiteral ] ;
    sh:property [ sh:path schema:unitCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:quantityKind ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:lexicalForm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 2100 ] ;
    sh:property [ sh:path rv:decimalPlaces ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 1024 ] ;
    sh:property [ sh:path rv:uncertainty ; sh:maxCount 1 ; sh:nodeKind sh:IRIOrLiteral ] .

<https://rezics.com/definition/value-exact-v1/temporal-shape>
    a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rdf:type ; sh:hasValue time:GeneralDateTimeDescription ] ;
    sh:property [ sh:path rv:lexicalForm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 64 ] ;
    sh:property [ sh:path time:unitType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( time:unitYear time:unitMonth time:unitDay time:unitHour time:unitMinute time:unitSecond ) ] ;
    sh:property [ sh:path time:hasTRS ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( <http://www.opengis.net/def/uom/ISO-8601/0/Gregorian> ) ] ;
    sh:property [ sh:path rv:utcOffset ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^(Z|[+-](0[0-9]|1[0-3]):[0-5][0-9]|[+-]14:00)$" ] ;
    sh:property [ sh:path rv:timeZoneName ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 64 ] ;
    sh:property [ sh:path rv:earliest ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path rv:latest ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

<https://rezics.com/definition/value-exact-v1/directional-text-shape>
    a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rdf:type ; sh:hasValue rdf:CompoundLiteral ] ;
    sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 8000 ] ;
    sh:property [ sh:path rdf:language ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" ] ;
    sh:property [ sh:path rdf:direction ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "ltr" "rtl" ) ] .

<https://rezics.com/definition/value-exact-v1/external-reference-shape>
    a sh:NodeShape ;
    sh:closed true ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:ExternalReference ] ;
    sh:property [ sh:path rv:externalProvider ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z0-9]+(-[a-z0-9]+)*$" ] ;
    sh:property [ sh:path rv:externalNamespace ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z0-9]+(-[a-z0-9]+)*$" ] ;
    sh:property [ sh:path rv:externalKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 512 ] ;
    sh:property [ sh:path owl:sameAs ; sh:maxCount 0 ] .
