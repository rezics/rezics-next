# One decision head per exact Statement or qualified-fact slot and acceptance scope.
# Decision revisions are immutable; Withdrawn is explicit absence, never unreadable state.
# Migrated heads reference their exact retained classification-direct-decision-v1 revision.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/statement-decision-v1/slot-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:DecisionSlot ] ;
    sh:property [ sh:path rv:acceptanceContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:ClassificationContext ] ;
    sh:property [ sh:path rv:decisionHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:StatementDecision ] ;
    sh:or (
        [ sh:property [ sh:path rv:targetKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue rv:StatementTarget ] ;
          sh:property [ sh:path rv:decisionTarget ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rdf:Statement ] ]
        [ sh:property [ sh:path rv:targetKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue rv:QualifiedFactTarget ] ;
          sh:property [ sh:path rv:decisionTarget ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ]
    ) .

<https://rezics.com/definition/statement-decision-v1/decision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:StatementDecision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:DecisionSlot ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:StatementDecision ] ;
    sh:property [ sh:path rv:outcome ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Accepted rv:Rejected rv:Withdrawn ) ] ;
    sh:property [ sh:path rv:decisionBasis ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:GlobalCuratorReview rv:RealmManagerReview ) ] ;
    sh:property [ sh:path rv:decidedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:decisionPolicy ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/statement-decision-v1> ] ;
    sh:property [ sh:path rv:contextRevision ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:targetRevision ; sh:maxCount 1 ; sh:class rv:StatementRevision ] ;
    sh:property [ sh:path rv:support ; sh:maxCount 32 ; sh:class rdf:Statement ] ;
    sh:property [ sh:path rv:evidence ; sh:maxCount 16 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:convertedFrom ; sh:maxCount 1 ; sh:class rv:ClassificationDecision ] ;
    sh:property [ sh:path rv:operation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/statement-decision-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/statement-decision-v1> ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .
