# A particular text of one Work; language and script never establish identity.
# Exact source revisions and unresolved continuity are distinct; unofficial stays unofficial.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/realization-v1/realization-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:maxCount 1 ; sh:hasValue rv:Realization ] ;
    sh:property [ sh:path rv:work ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:head ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:RealizationRevision ] ;
    sh:property [ sh:path rv:contentLanguage ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 35 ] ;
    sh:property [ sh:path rv:realizationKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "original" "translation" ) ] ;
    sh:property [ sh:path rv:realizationStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "official" "unofficial" ) ] ;
    sh:property [ sh:path rv:verification ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "verified" "unverified" ) ] ;
    sh:property [ sh:path rv:translator ; sh:maxCount 16 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:publisher ; sh:maxCount 16 ; sh:nodeKind sh:IRI ] .

<https://rezics.com/definition/realization-v1/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:RealizationRevision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:Realization ] ;
    sh:property [ sh:path rv:realizationState ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 8192 ] ;
    sh:property [ sh:path rv:sourceWork ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:sourceStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "realization" "main-version" "unresolved" ) ] ;
    sh:property [ sh:path rv:sourceRevision ; sh:maxCount 1 ; sh:class rv:RevisionAnchor ] ;
    sh:property [ sh:path rv:evidence ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:RealizationRevision ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/realization-v1> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/realization-v1> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:or (
        [ sh:property [ sh:path rv:sourceStatus ; sh:hasValue "unresolved" ] ;
          sh:property [ sh:path rv:sourceRevision ; sh:maxCount 0 ; sh:nodeKind sh:IRI ] ]
        [ sh:property [ sh:path rv:sourceStatus ; sh:in ( "realization" "main-version" ) ] ;
          sh:property [ sh:path rv:sourceRevision ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    ) .
