# Edition revisions record a list of content languages, a translation and its original language,
# and the language of printed title or track-list text apart from content language.
# Empty content languages mean not recorded. The command rejects mul and a bare und list.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/work-metadata-details-v2/component-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:hasValue rv:EditionRecord ] ;
    sh:property [ sh:path rv:work ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:CreativeWork ] ;
    sh:property [ sh:path rv:metadataKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "edition" ] ;
    sh:property [ sh:path rv:metadataHead ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:WorkMetadataDetailsV2Revision ] ;
    sh:property [ sh:path rv:editionState ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( rv:Active rv:Withdrawn ) ] ;
    sh:property [ sh:path rv:editionLanguage ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:contentLanguages ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 400 ] ;
    sh:property [ sh:path rv:titleLanguage ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:tracklistLanguage ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:originalLanguages ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 200 ] ;
    sh:property [ sh:path rv:isTranslation ; sh:maxCount 1 ; sh:in ( "true" ) ] .

<https://rezics.com/definition/work-metadata-details-v2/revision-shape>
    a sh:NodeShape ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ; sh:in ( rv:WorkMetadataDetailsV2Revision rv:RevisionAnchor ) ] ;
    sh:property [ sh:path rv:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rv:EditionRecord ] ;
    sh:property [ sh:path rv:metadataState ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 65536 ] ;
    sh:property [ sh:path rv:predecessor ; sh:maxCount 1 ; sh:class rv:WorkMetadataDetailsV2Revision ] ;
    sh:property [ sh:path rv:manifest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rv:modelRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/work-metadata-details-v2> ] ;
    sh:property [ sh:path rv:shapeRevision ; sh:maxCount 1 ; sh:hasValue <https://rezics.com/definition/work-metadata-details-v2> ] ;
    sh:property [ sh:path rv:dataEpoch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rv:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .
