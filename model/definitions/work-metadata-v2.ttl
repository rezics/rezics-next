# Work and Main Version shapes from work-metadata-v1, plus release links.
# A release is a separate closed or virtual record; it is not a Work property that later translations extend.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix rv: <https://rezics.com/vocab/> .

<https://rezics.com/definition/work-metadata-v2/work-shape>
    a sh:NodeShape ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue schema:CreativeWork ;
    ] ;
    sh:property [
        sh:path rv:mainVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class rv:MainVersion ;
    ] ;
    sh:property [
        sh:path rv:continuityProfile ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path rv:scalarValue ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRIOrLiteral ;
    ] ;
    sh:property [
        sh:path rv:release ;
        sh:maxCount 64 ;
        sh:nodeKind sh:IRI ;
        sh:class rv:Release ;
    ] .

<https://rezics.com/definition/work-metadata-v2/main-version-shape>
    a sh:NodeShape ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue rv:MainVersion ;
    ] ;
    sh:property [
        sh:path rv:work ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class schema:CreativeWork ;
    ] ;
    sh:property [
        sh:path rv:hostingPolicy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue rv:MetadataOnly ;
    ] .
